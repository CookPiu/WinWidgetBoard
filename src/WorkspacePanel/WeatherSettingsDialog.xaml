<controls:ContentDialog
    x:Class="WinWidgetBoard.WorkspacePanel.WeatherSettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    x:Uid="WeatherSettingsDialog"
    DefaultButton="Close">
    <StackPanel Spacing="12">
        <TextBlock
            x:Uid="WeatherSettingsDescription"
            TextWrapping="Wrap" />
        <TextBox
            x:Name="WeatherSettingsLabelBox"
            x:Uid="WeatherSettingsLabelBox"
            Text="{x:Bind ViewModel.LocationLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            automation:AutomationProperties.AutomationId="WeatherSettingsLabelBox"
            xmlns:automation="using:Microsoft.UI.Xaml.Automation" />
        <TextBox
            x:Name="WeatherSettingsLatitudeBox"
            x:Uid="WeatherSettingsLatitudeBox"
            Text="{x:Bind ViewModel.LatitudeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            automation:AutomationProperties.AutomationId="WeatherSettingsLatitudeBox"
            xmlns:automation="using:Microsoft.UI.Xaml.Automation" />
        <TextBox
            x:Name="WeatherSettingsLongitudeBox"
            x:Uid="WeatherSettingsLongitudeBox"
            Text="{x:Bind ViewModel.LongitudeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            automation:AutomationProperties.AutomationId="WeatherSettingsLongitudeBox"
            xmlns:automation="using:Microsoft.UI.Xaml.Automation" />
        <Button
            x:Name="WeatherSettingsSaveButton"
            x:Uid="WeatherSettingsSaveButton"
            HorizontalAlignment="Left"
            IsEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}"
            Click="WeatherSettingsSaveButton_Click" />
        <TextBlock
            x:Name="WeatherSettingsValidationText"
            Text="{x:Bind ViewModel.ValidationText, Mode=OneWay}"
            TextWrapping="Wrap"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
        <TextBlock
            x:Name="WeatherSettingsStatusText"
            Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
            TextWrapping="Wrap"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </StackPanel>
</controls:ContentDialog>
