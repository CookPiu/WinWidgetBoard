<Window
    x:Class="WinWidgetBoard.WorkspacePanel.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:layout="using:WinWidgetBoard.WorkspacePanel.Layout"
    xmlns:notes="using:WinWidgetBoard.WorkspacePanel.Notes"
    xmlns:runtime="using:WinWidgetBoard.WorkspacePanel.Runtime">

    <Grid>
        <Grid.Resources>
        <layout:EditModeVisibilityConverter
            x:Key="EditModeVisibilityConverter" />
        <layout:InverseVisibilityConverter
            x:Key="InverseVisibilityConverter" />
        <DataTemplate
            x:Key="NoteMarkdownBlankTemplate"
            x:DataType="notes:NoteMarkdownPreviewBlock">
            <Border Height="8" />
        </DataTemplate>
        <DataTemplate
            x:Key="NoteMarkdownParagraphTemplate"
            x:DataType="notes:NoteMarkdownPreviewBlock">
            <TextBlock
                Text="{x:Bind Text}"
                TextWrapping="Wrap" />
        </DataTemplate>
        <DataTemplate
            x:Key="NoteMarkdownHeading1Template"
            x:DataType="notes:NoteMarkdownPreviewBlock">
            <TextBlock
                FontSize="22"
                FontWeight="SemiBold"
                Text="{x:Bind Text}"
                TextWrapping="Wrap" />
        </DataTemplate>
        <DataTemplate
            x:Key="NoteMarkdownHeading2Template"
            x:DataType="notes:NoteMarkdownPreviewBlock">
            <TextBlock
                FontSize="18"
                FontWeight="SemiBold"
                Text="{x:Bind Text}"
                TextWrapping="Wrap" />
        </DataTemplate>
        <DataTemplate
            x:Key="NoteMarkdownHeading3Template"
            x:DataType="notes:NoteMarkdownPreviewBlock">
            <TextBlock
                FontWeight="SemiBold"
                Text="{x:Bind Text}"
                TextWrapping="Wrap" />
        </DataTemplate>
        <DataTemplate
            x:Key="NoteMarkdownUnorderedListItemTemplate"
            x:DataType="notes:NoteMarkdownPreviewBlock">
            <StackPanel
                Orientation="Horizontal"
                Spacing="8">
                <TextBlock
                    Text="{x:Bind Marker}" />
                <TextBlock
                    Text="{x:Bind Text}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate
            x:Key="NoteMarkdownOrderedListItemTemplate"
            x:DataType="notes:NoteMarkdownPreviewBlock">
            <StackPanel
                Orientation="Horizontal"
                Spacing="8">
                <TextBlock
                    Text="{x:Bind Marker}" />
                <TextBlock
                    Text="{x:Bind Text}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate
            x:Key="NoteMarkdownQuoteTemplate"
            x:DataType="notes:NoteMarkdownPreviewBlock">
            <StackPanel
                Orientation="Horizontal"
                Spacing="8">
                <TextBlock
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind Marker}" />
                <TextBlock
                    Text="{x:Bind Text}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate
            x:Key="NoteMarkdownCodeTemplate"
            x:DataType="notes:NoteMarkdownPreviewBlock">
            <TextBlock
                FontFamily="Consolas"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind Text}"
                TextWrapping="Wrap" />
        </DataTemplate>
        <notes:NoteMarkdownPreviewTemplateSelector
            x:Key="NoteMarkdownPreviewTemplateSelector"
            BlankTemplate="{StaticResource NoteMarkdownBlankTemplate}"
            ParagraphTemplate="{StaticResource NoteMarkdownParagraphTemplate}"
            Heading1Template="{StaticResource NoteMarkdownHeading1Template}"
            Heading2Template="{StaticResource NoteMarkdownHeading2Template}"
            Heading3Template="{StaticResource NoteMarkdownHeading3Template}"
            UnorderedListItemTemplate="{StaticResource NoteMarkdownUnorderedListItemTemplate}"
            OrderedListItemTemplate="{StaticResource NoteMarkdownOrderedListItemTemplate}"
            QuoteTemplate="{StaticResource NoteMarkdownQuoteTemplate}"
            CodeTemplate="{StaticResource NoteMarkdownCodeTemplate}" />
        <DataTemplate
            x:Key="CardRuntimeStatusTemplate"
            x:DataType="runtime:CardRuntimeStatusPresentation">
            <Border Style="{StaticResource WwbCardRuntimeStatusSurfaceStyle}">
                <StackPanel Spacing="4">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Style="{StaticResource WwbCardRuntimeStatusCriticalIconStyle}"
                            Text="!"
                            Visibility="{Binding IsCritical, Converter={StaticResource EditModeVisibilityConverter}}" />
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource WwbCardRuntimeStatusTitleStyle}"
                            Text="{x:Bind Title}"
                            TextWrapping="Wrap" />
                    </Grid>
                    <TextBlock
                        Style="{StaticResource WwbCardRuntimeStatusSummaryStyle}"
                        Text="{x:Bind Summary}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Style="{StaticResource WwbCardRuntimeStatusFreshnessStyle}"
                        Text="{x:Bind FreshnessText}"
                        TextWrapping="Wrap"
                        Visibility="{Binding HasFreshnessText, Converter={StaticResource EditModeVisibilityConverter}}" />
                    <Border
                        x:Name="CardRuntimeLoadingSkeleton"
                        Padding="8"
                        Style="{StaticResource WwbCardRuntimeStatusSurfaceStyle}"
                        Visibility="{Binding IsLoading, Converter={StaticResource EditModeVisibilityConverter}}">
                        <StackPanel Spacing="8">
                            <Border Style="{StaticResource WwbCardRuntimeStatusSkeletonBlockStyle}" />
                            <Border
                                Width="180"
                                HorizontalAlignment="Left"
                                Style="{StaticResource WwbCardRuntimeStatusSkeletonBlockStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate
            x:Key="NotesCardTemplate"
            x:DataType="layout:CardSurfaceItem">
            <Border
                MinHeight="160"
                Style="{StaticResource WwbCardSurfaceStyle}"
                RenderTransformOrigin="0.5,0.5"
                Tag="{x:Bind InstanceId}"
                PointerCaptureLost="DemoNotesCardSurface_PointerCaptureLost"
                PointerCanceled="DemoNotesCardSurface_PointerCanceled"
                PointerMoved="DemoNotesCardSurface_PointerMoved"
                PointerPressed="DemoNotesCardSurface_PointerPressed"
                PointerReleased="DemoNotesCardSurface_PointerReleased">
                <Border.RenderTransform>
                    <CompositeTransform />
                </Border.RenderTransform>
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid
                        x:Name="DemoNotesCardSurface"
                        Grid.Row="0"
                        Background="Transparent">
                        <Grid
                            ColumnSpacing="6"
                            RowSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                x:Uid="NotesCardTitle"
                                Grid.ColumnSpan="2"
                                Style="{StaticResource WwbCardTitleStyle}" />
                            <StackPanel
                                Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="2">
                                <Button
                                    x:Name="NewNoteButton"
                                    x:Uid="NewNoteButton"
                                    Style="{StaticResource WwbCardIconButtonStyle}"
                                    IsEnabled="{x:Bind NoteEditor.CanLoadNote, Mode=OneWay}"
                                    Tag="{Binding ElementName=NoteOverflowPanel}"
                                    Click="NewNoteButton_Click">
                                    <ToolTipService.ToolTip>
                                        <TextBlock x:Uid="NewNoteButtonToolTip" />
                                    </ToolTipService.ToolTip>
                                </Button>
                                <Grid
                                    x:Name="NotePreviewCommandHost"
                                    x:Load="{x:Bind NoteEditor.CanPreviewMarkdown, Mode=OneWay}">
                                    <Button
                                        x:Name="PreviewNoteButton"
                                        x:Uid="PreviewNoteButton"
                                        Style="{StaticResource WwbCardIconButtonStyle}"
                                        IsEnabled="{x:Bind NoteEditor.CanPreviewMarkdown, Mode=OneWay}"
                                        Tag="{Binding ElementName=NoteOverflowPanel}"
                                        Click="PreviewNoteButton_Click">
                                        <ToolTipService.ToolTip>
                                            <TextBlock x:Uid="PreviewNoteButtonToolTip" />
                                        </ToolTipService.ToolTip>
                                    </Button>
                                    <Button
                                        x:Name="EditMarkdownButton"
                                        x:Uid="EditMarkdownButton"
                                        Style="{StaticResource WwbCardIconButtonStyle}"
                                        IsEnabled="{x:Bind NoteEditor.CanEdit, Mode=OneWay}"
                                        Tag="{Binding ElementName=NoteOverflowPanel}"
                                        Visibility="Collapsed"
                                        Click="EditMarkdownButton_Click">
                                        <ToolTipService.ToolTip>
                                            <TextBlock x:Uid="EditMarkdownButtonToolTip" />
                                        </ToolTipService.ToolTip>
                                    </Button>
                                </Grid>
                                <Button
                                    x:Name="NoteMoreButton"
                                    x:Uid="NoteMoreButton"
                                    Style="{StaticResource WwbCardIconButtonStyle}"
                                    Tag="{Binding ElementName=NoteOverflowPanel}"
                                    Click="NoteMoreButton_Click">
                                    <ToolTipService.ToolTip>
                                        <TextBlock x:Uid="NoteMoreButtonToolTip" />
                                    </ToolTipService.ToolTip>
                                </Button>
                            </StackPanel>
                            <ContentControl
                                x:Name="NotesCardRuntimeStatus"
                                Grid.Row="1"
                                Grid.ColumnSpan="3"
                                automation:AutomationProperties.Name="{x:Bind RuntimePresentation.AutomationSummary, Mode=OneWay}"
                                automation:AutomationProperties.HelpText="{x:Bind RuntimePresentation.Summary, Mode=OneWay}"
                                Content="{x:Bind RuntimePresentation, Mode=OneWay}"
                                ContentTemplate="{StaticResource CardRuntimeStatusTemplate}"
                                IsTabStop="False"
                                Visibility="{x:Bind RuntimePresentation.IsStateVisible, Mode=OneWay}" />
                        </Grid>
                    </Grid>
                    <ScrollViewer
                        x:Name="NotesCardScrollViewer"
                        x:Uid="NotesCardScrollViewer"
                        Grid.Row="1"
                        Margin="0"
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        VerticalScrollMode="Enabled"
                        Visibility="{x:Bind RuntimePresentation.IsContentVisible, Mode=OneWay}">
                        <StackPanel Spacing="8">
                            <StackPanel
                                x:Name="NoteEditorInputPanel"
                                Spacing="6">
                                <TextBox
                                    x:Name="NoteTitleBox"
                                    x:Uid="NoteTitleBox"
                                    Style="{StaticResource WwbNoteTitleTextBoxStyle}"
                                    IsEnabled="{x:Bind NoteEditor.CanEdit, Mode=OneWay}"
                                    Text="{x:Bind NoteEditor.Title, Mode=OneWay}"
                                    TextChanged="NoteTitleBox_TextChanged" />
                                <TextBox
                                    x:Name="NoteBodyBox"
                                    x:Uid="NoteBodyBox"
                                    Height="148"
                                    Style="{StaticResource WwbNoteBodyTextBoxStyle}"
                                    AcceptsReturn="True"
                                    IsEnabled="{x:Bind NoteEditor.CanEdit, Mode=OneWay}"
                                    ScrollViewer.HorizontalScrollMode="Disabled"
                                    ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                    ScrollViewer.VerticalScrollMode="Enabled"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    Text="{x:Bind NoteEditor.Body, Mode=OneWay}"
                                    TextChanged="NoteBodyBox_TextChanged"
                                    TextWrapping="Wrap"
                                    VerticalContentAlignment="Top" />
                            </StackPanel>
                            <Border
                                x:Name="NoteMarkdownPreviewPanel"
                                x:Uid="NoteMarkdownPreviewPanel"
                                Style="{StaticResource WwbSecondarySurfaceStyle}"
                                Visibility="Collapsed">
                                <ListView
                                    x:Name="NoteMarkdownPreviewText"
                                    x:Uid="NoteMarkdownPreviewText"
                                    MaxHeight="148"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    IsItemClickEnabled="False"
                                    IsTabStop="False"
                                    ItemsSource="{x:Bind NoteEditor.MarkdownPreviewBlocks, Mode=OneWay}"
                                    ItemTemplateSelector="{StaticResource NoteMarkdownPreviewTemplateSelector}"
                                    Padding="0"
                                    SelectionMode="None" />
                            </Border>
                            <Border
                                x:Name="NoteOverflowPanel"
                                Tag="{Binding ElementName=NoteMoreButton}"
                                Style="{StaticResource WwbNoteOverflowSurfaceStyle}"
                                Visibility="Collapsed">
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox
                                        x:Name="MarkdownModeCheckBox"
                                        x:Uid="MarkdownModeCheckBox"
                                        Grid.Column="0"
                                        Style="{StaticResource WwbModeCheckBoxStyle}"
                                        IsChecked="{x:Bind NoteEditor.IsMarkdown, Mode=OneWay}"
                                        IsEnabled="{x:Bind NoteEditor.CanChangeMarkdownMode, Mode=OneWay}"
                                        Tag="{Binding ElementName=NoteOverflowPanel}"
                                        Click="MarkdownModeCheckBox_Click" />
                                    <Button
                                        x:Name="CopyNoteButton"
                                        x:Uid="CopyNoteButton"
                                        Grid.Column="1"
                                        Style="{StaticResource WwbNoteUtilityButtonStyle}"
                                        IsEnabled="{x:Bind NoteEditor.CanEdit, Mode=OneWay}"
                                        Tag="{Binding ElementName=NoteOverflowPanel}"
                                        Click="CopyNoteButton_Click" />
                                    <Button
                                        x:Name="DeleteCurrentNoteButton"
                                        x:Uid="DeleteCurrentNoteButton"
                                        Grid.Column="2"
                                        Style="{StaticResource WwbNoteUtilityButtonStyle}"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                        IsEnabled="{x:Bind NoteEditor.CanDelete, Mode=OneWay}"
                                        Tag="{Binding ElementName=NoteOverflowPanel}"
                                        Click="DeleteCurrentNoteButton_Click" />
                                </Grid>
                            </Border>
                            <Grid
                                x:Name="NoteEditorFooter"
                                ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="NoteEditorStatusText"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource WwbPanelContextStyle}"
                                    Text="{x:Bind NoteStatusText, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                                <StackPanel
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="2">
                                    <Button
                                        x:Name="RetryNoteSaveButton"
                                        x:Uid="RetryNoteSaveButton"
                                        Style="{StaticResource WwbNoteUtilityButtonStyle}"
                                        IsEnabled="{x:Bind NoteEditor.CanRetrySave, Mode=OneWay}"
                                        x:Load="{x:Bind NoteEditor.CanRetrySave, Mode=OneWay}"
                                        Click="RetryNoteSaveButton_Click" />
                                    <Button
                                        x:Name="UndoNoteButton"
                                        x:Uid="UndoNoteButton"
                                        Style="{StaticResource WwbNoteUtilityButtonStyle}"
                                        IsEnabled="{x:Bind NoteEditor.CanUndo, Mode=OneWay}"
                                        x:Load="{x:Bind NoteEditor.CanUndo, Mode=OneWay}"
                                        Click="UndoNoteButton_Click" />
                                    <Button
                                        x:Name="RedoNoteButton"
                                        x:Uid="RedoNoteButton"
                                        Style="{StaticResource WwbNoteUtilityButtonStyle}"
                                        IsEnabled="{x:Bind NoteEditor.CanRedo, Mode=OneWay}"
                                        x:Load="{x:Bind NoteEditor.CanRedo, Mode=OneWay}"
                                        Click="RedoNoteButton_Click" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                    <Border
                        Grid.Row="2"
                        HorizontalAlignment="Left"
                        Style="{StaticResource WwbEditToolbarSurfaceStyle}"
                        Visibility="{x:Bind IsEditing, Mode=OneWay}">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8">
                            <Border
                                Tag="{x:Bind InstanceId}"
                                Style="{StaticResource WwbDragHandleStyle}">
                                <TextBlock
                                    x:Name="NotesCardDragHandle"
                                    x:Uid="DragCardHandle"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <Button
                                x:Uid="DecreaseCardButton"
                                Style="{StaticResource WwbEditActionButtonStyle}"
                                Tag="{x:Bind InstanceId}"
                                Click="DecreaseCardSizeButton_Click" />
                            <Button
                                x:Uid="IncreaseCardButton"
                                Style="{StaticResource WwbEditActionButtonStyle}"
                                Tag="{x:Bind InstanceId}"
                                Click="IncreaseCardSizeButton_Click" />
                            <Button
                                x:Uid="RemoveCardButton"
                                Style="{StaticResource WwbDestructiveActionButtonStyle}"
                                Tag="{x:Bind InstanceId}"
                                Click="RemoveCardButton_Click" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="WeatherBackdropClearDayTemplate">
            <Grid>
                <Rectangle Fill="{ThemeResource WwbWeatherSkyClearBrush}" />
                <Ellipse
                    Width="96"
                    Height="96"
                    Margin="0,0,-26,-30"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Fill="{ThemeResource WwbWeatherMotifStrongBrush}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="WeatherBackdropClearNightTemplate">
            <Grid>
                <Rectangle Fill="{ThemeResource WwbWeatherSkyNightBrush}" />
                <Path
                    Width="86"
                    Height="86"
                    Margin="0,0,-20,-24"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Stretch="Uniform"
                    Data="M 52,6 A 44,44 0 1 0 52,94 A 34,34 0 1 1 52,6 Z"
                    Fill="{ThemeResource WwbWeatherMotifStrongBrush}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="WeatherBackdropPartlyCloudyDayTemplate">
            <Grid>
                <Rectangle Fill="{ThemeResource WwbWeatherSkyClearBrush}" />
                <Ellipse
                    Width="68"
                    Height="68"
                    Margin="0,0,44,46"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Fill="{ThemeResource WwbWeatherMotifStrongBrush}" />
                <Path
                    Width="120"
                    Height="76"
                    Margin="0,0,-18,-6"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Stretch="Uniform"
                    Data="M 14,62 A 14,14 0 0 1 22,36 A 22,22 0 0 1 66,30 A 15,15 0 0 1 88,50 A 12,12 0 0 1 86,62 Z"
                    Fill="{ThemeResource WwbWeatherMotifBrush}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="WeatherBackdropPartlyCloudyNightTemplate">
            <Grid>
                <Rectangle Fill="{ThemeResource WwbWeatherSkyNightBrush}" />
                <Path
                    Width="62"
                    Height="62"
                    Margin="0,0,46,48"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Stretch="Uniform"
                    Data="M 52,6 A 44,44 0 1 0 52,94 A 34,34 0 1 1 52,6 Z"
                    Fill="{ThemeResource WwbWeatherMotifStrongBrush}" />
                <Path
                    Width="120"
                    Height="76"
                    Margin="0,0,-18,-6"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Stretch="Uniform"
                    Data="M 14,62 A 14,14 0 0 1 22,36 A 22,22 0 0 1 66,30 A 15,15 0 0 1 88,50 A 12,12 0 0 1 86,62 Z"
                    Fill="{ThemeResource WwbWeatherMotifBrush}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="WeatherBackdropCloudyTemplate">
            <Grid>
                <Rectangle Fill="{ThemeResource WwbWeatherSkyCloudyBrush}" />
                <Path
                    Width="138"
                    Height="88"
                    Margin="0,0,-24,-10"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Stretch="Uniform"
                    Data="M 14,62 A 14,14 0 0 1 22,36 A 22,22 0 0 1 66,30 A 15,15 0 0 1 88,50 A 12,12 0 0 1 86,62 Z"
                    Fill="{ThemeResource WwbWeatherMotifBrush}" />
                <Path
                    Width="92"
                    Height="58"
                    Margin="0,0,72,46"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Stretch="Uniform"
                    Data="M 14,62 A 14,14 0 0 1 22,36 A 22,22 0 0 1 66,30 A 15,15 0 0 1 88,50 A 12,12 0 0 1 86,62 Z"
                    Fill="{ThemeResource WwbWeatherMotifBrush}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="WeatherBackdropFogTemplate">
            <Grid>
                <Rectangle Fill="{ThemeResource WwbWeatherSkyCloudyBrush}" />
                <Path
                    Width="122"
                    Height="78"
                    Margin="0,0,-18,34"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Stretch="Uniform"
                    Data="M 14,62 A 14,14 0 0 1 22,36 A 22,22 0 0 1 66,30 A 15,15 0 0 1 88,50 A 12,12 0 0 1 86,62 Z"
                    Fill="{ThemeResource WwbWeatherMotifBrush}" />
                <Rectangle
                    Width="94"
                    Height="7"
                    Margin="0,0,14,22"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    RadiusX="3.5"
                    RadiusY="3.5"
                    Fill="{ThemeResource WwbWeatherMotifBrush}" />
                <Rectangle
                    Width="66"
                    Height="7"
                    Margin="0,0,42,6"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    RadiusX="3.5"
                    RadiusY="3.5"
                    Fill="{ThemeResource WwbWeatherMotifBrush}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="WeatherBackdropRainTemplate">
            <Grid>
                <Rectangle Fill="{ThemeResource WwbWeatherSkyWetBrush}" />
                <Path
                    Width="120"
                    Height="76"
                    Margin="0,0,-16,32"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Stretch="Uniform"
                    Data="M 14,62 A 14,14 0 0 1 22,36 A 22,22 0 0 1 66,30 A 15,15 0 0 1 88,50 A 12,12 0 0 1 86,62 Z"
                    Fill="{ThemeResource WwbWeatherMotifBrush}" />
                <Path
                    Width="15"
                    Height="15"
                    Margin="0,0,22,10"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Stretch="Uniform"
                    Data="M 50,4 C 50,4 82,44 82,64 A 32,32 0 1 1 18,64 C 18,44 50,4 50,4 Z"
                    Fill="{ThemeResource WwbWeatherMotifBrush}" />
                <Path
                    Width="15"
                    Height="15"
                    Margin="0,0,52,22"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Stretch="Uniform"
                    Data="M 50,4 C 50,4 82,44 82,64 A 32,32 0 1 1 18,64 C 18,44 50,4 50,4 Z"
                    Fill="{ThemeResource WwbWeatherMotifBrush}" />
                <Path
                    Width="15"
                    Height="15"
                    Margin="0,0,82,4"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Stretch="Uniform"
                    Data="M 50,4 C 50,4 82,44 82,64 A 32,32 0 1 1 18,64 C 18,44 50,4 50,4 Z"
                    Fill="{ThemeResource WwbWeatherMotifBrush}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="WeatherBackdropSnowTemplate">
            <Grid>
                <Rectangle Fill="{ThemeResource WwbWeatherSkySnowBrush}" />
                <Path
                    Width="120"
                    Height="76"
                    Margin="0,0,-16,32"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Stretch="Uniform"
                    Data="M 14,62 A 14,14 0 0 1 22,36 A 22,22 0 0 1 66,30 A 15,15 0 0 1 88,50 A 12,12 0 0 1 86,62 Z"
                    Fill="{ThemeResource WwbWeatherMotifBrush}" />
                <Ellipse
                    Width="13"
                    Height="13"
                    Margin="0,0,24,12"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Fill="{ThemeResource WwbWeatherMotifBrush}" />
                <Ellipse
                    Width="10"
                    Height="10"
                    Margin="0,0,54,24"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Fill="{ThemeResource WwbWeatherMotifBrush}" />
                <Ellipse
                    Width="11"
                    Height="11"
                    Margin="0,0,84,6"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Fill="{ThemeResource WwbWeatherMotifBrush}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="WeatherBackdropThunderstormTemplate">
            <Grid>
                <Rectangle Fill="{ThemeResource WwbWeatherSkyStormBrush}" />
                <Path
                    Width="124"
                    Height="79"
                    Margin="0,0,-18,30"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Stretch="Uniform"
                    Data="M 14,62 A 14,14 0 0 1 22,36 A 22,22 0 0 1 66,30 A 15,15 0 0 1 88,50 A 12,12 0 0 1 86,62 Z"
                    Fill="{ThemeResource WwbWeatherMotifBrush}" />
                <Path
                    Width="44"
                    Height="44"
                    Margin="0,0,54,-6"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Stretch="Uniform"
                    Data="M 58,4 L 22,54 L 46,54 L 38,96 L 78,42 L 52,42 Z"
                    Fill="{ThemeResource WwbWeatherMotifStrongBrush}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="WeatherBackdropEmptyTemplate">
            <Grid />
        </DataTemplate>

        <layout:WeatherBackdropTemplateSelector
            x:Key="WeatherBackdropSelector"
            ClearDayTemplate="{StaticResource WeatherBackdropClearDayTemplate}"
            ClearNightTemplate="{StaticResource WeatherBackdropClearNightTemplate}"
            PartlyCloudyDayTemplate="{StaticResource WeatherBackdropPartlyCloudyDayTemplate}"
            PartlyCloudyNightTemplate="{StaticResource WeatherBackdropPartlyCloudyNightTemplate}"
            CloudyTemplate="{StaticResource WeatherBackdropCloudyTemplate}"
            FogTemplate="{StaticResource WeatherBackdropFogTemplate}"
            RainTemplate="{StaticResource WeatherBackdropRainTemplate}"
            SnowTemplate="{StaticResource WeatherBackdropSnowTemplate}"
            ThunderstormTemplate="{StaticResource WeatherBackdropThunderstormTemplate}"
            EmptyTemplate="{StaticResource WeatherBackdropEmptyTemplate}" />

        <DataTemplate
            x:Key="WeatherCardTemplate"
            x:DataType="layout:CardSurfaceItem">
            <Border
                MinHeight="160"
                Style="{StaticResource WwbCardSurfaceStyle}"
                Padding="{StaticResource WwbCompactCardPadding}"
                RenderTransformOrigin="0.5,0.5"
                Tag="{x:Bind InstanceId}"
                PointerCaptureLost="DemoNotesCardSurface_PointerCaptureLost"
                PointerCanceled="DemoNotesCardSurface_PointerCanceled"
                PointerMoved="DemoNotesCardSurface_PointerMoved"
                PointerPressed="DemoNotesCardSurface_PointerPressed"
                PointerReleased="DemoNotesCardSurface_PointerReleased">
                <Border.RenderTransform>
                    <CompositeTransform />
                </Border.RenderTransform>
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!--
                        The condition illustration sits behind every row and is clipped to
                        the card's own corner radius, so a motif can bleed off the corner
                        instead of floating inside a visible box. It is decoration only: it
                        takes no pointer input, and it carries no automation name because
                        the same facts are already stated in the card's text.
                    -->
                    <Border
                        Grid.Row="0"
                        Grid.RowSpan="4"
                        Margin="-12"
                        CornerRadius="{StaticResource WwbCardCornerRadius}"
                        IsHitTestVisible="False">
                        <ContentControl
                            automation:AutomationProperties.AccessibilityView="Raw"
                            Content="{x:Bind WeatherConditionIconId, Mode=OneWay}"
                            ContentTemplateSelector="{StaticResource WeatherBackdropSelector}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            IsTabStop="False"
                            Visibility="{x:Bind RuntimePresentation.IsContentVisible, Mode=OneWay}" />
                    </Border>
                    <Grid
                        Grid.Row="0"
                        ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Uid="WeatherCardTitle"
                            Grid.ColumnSpan="2"
                            Style="{StaticResource WwbCardTitleStyle}" />
                        <TextBlock
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            automation:AutomationProperties.AutomationId="WeatherLocationText"
                            Style="{StaticResource WwbCardCaptionStyle}"
                            Text="{x:Bind WeatherLocationLabel, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <Grid Grid.Row="1">
                        <ContentControl
                            x:Name="WeatherCardRuntimeStatus"
                            automation:AutomationProperties.Name="{x:Bind RuntimePresentation.AutomationSummary, Mode=OneWay}"
                            automation:AutomationProperties.HelpText="{x:Bind WeatherAutomationSummary, Mode=OneWay}"
                            Content="{x:Bind RuntimePresentation, Mode=OneWay}"
                            ContentTemplate="{StaticResource CardRuntimeStatusTemplate}"
                            IsTabStop="False"
                            Visibility="{x:Bind RuntimePresentation.IsStateVisible, Mode=OneWay}" />
                        <Grid
                            ColumnSpacing="12"
                            Visibility="{x:Bind RuntimePresentation.IsContentVisible, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock
                                    automation:AutomationProperties.AutomationId="WeatherTemperatureText"
                                    automation:AutomationProperties.Name="{x:Bind WeatherTemperatureText, Mode=OneWay}"
                                    Style="{StaticResource WwbWeatherTemperatureStyle}"
                                    Text="{x:Bind WeatherTemperatureText, Mode=OneWay}" />
                                <TextBlock
                                    automation:AutomationProperties.Name="{x:Bind WeatherConditionText, Mode=OneWay}"
                                    Style="{StaticResource WwbCardBodyStyle}"
                                    Text="{x:Bind WeatherConditionText, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="1"
                                Spacing="2"
                                VerticalAlignment="Center">
                                <TextBlock
                                    Style="{StaticResource WwbCardCaptionStyle}"
                                    Text="{x:Bind WeatherApparentTemperatureText, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Style="{StaticResource WwbCardCaptionStyle}"
                                        Text="{x:Bind WeatherHumidityText, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Style="{StaticResource WwbCardCaptionStyle}"
                                        Text="{x:Bind WeatherWindText, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <TextBlock
                                    Style="{StaticResource WwbCardCaptionStyle}"
                                    Text="{x:Bind WeatherObservedAtText, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <HyperlinkButton
                        Grid.Row="2"
                        HorizontalAlignment="Left"
                        MinHeight="20"
                        Padding="0"
                        FontSize="11"
                        Content="{x:Bind WeatherAttributionText, Mode=OneWay}"
                        NavigateUri="https://open-meteo.com/"
                        Visibility="{Binding HasWeatherData, Converter={StaticResource EditModeVisibilityConverter}}" />
                    <Border
                        Grid.Row="3"
                        HorizontalAlignment="Left"
                        Padding="{StaticResource WwbCompactToolbarPadding}"
                        Style="{StaticResource WwbEditToolbarSurfaceStyle}"
                        Visibility="{x:Bind IsEditing, Mode=OneWay}">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8">
                            <Border
                                Tag="{x:Bind InstanceId}"
                                Style="{StaticResource WwbDragHandleStyle}">
                                <TextBlock
                                    x:Name="WeatherCardDragHandle"
                                    x:Uid="DragCardHandle"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <Button
                                x:Uid="DecreaseCardButton"
                                Style="{StaticResource WwbEditActionButtonStyle}"
                                Tag="{x:Bind InstanceId}"
                                Click="DecreaseCardSizeButton_Click" />
                            <Button
                                x:Uid="IncreaseCardButton"
                                Style="{StaticResource WwbEditActionButtonStyle}"
                                Tag="{x:Bind InstanceId}"
                                Click="IncreaseCardSizeButton_Click" />
                            <Button
                                x:Uid="RemoveCardButton"
                                Style="{StaticResource WwbDestructiveActionButtonStyle}"
                                Tag="{x:Bind InstanceId}"
                                Click="RemoveCardButton_Click" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

