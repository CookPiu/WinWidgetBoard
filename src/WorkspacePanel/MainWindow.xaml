            PartlyCloudyNightTemplate="{StaticResource WeatherBackdropPartlyCloudyNightTemplate}"
            CloudyTemplate="{StaticResource WeatherBackdropCloudyTemplate}"
            FogTemplate="{StaticResource WeatherBackdropFogTemplate}"
            RainTemplate="{StaticResource WeatherBackdropRainTemplate}"
            SnowTemplate="{StaticResource WeatherBackdropSnowTemplate}"
            ThunderstormTemplate="{StaticResource WeatherBackdropThunderstormTemplate}"
            EmptyTemplate="{StaticResource WeatherBackdropEmptyTemplate}" />

        <DataTemplate
            x:Key="WeatherCardTemplate"
            x:DataType="layout:CardSurfaceItem">
            <Border
                MinHeight="160"
                Style="{StaticResource WwbCardSurfaceStyle}"
                RenderTransformOrigin="0.5,0.5"
                Tag="{x:Bind InstanceId}"
                PointerCaptureLost="DemoNotesCardSurface_PointerCaptureLost"
                PointerCanceled="DemoNotesCardSurface_PointerCanceled"
                PointerMoved="DemoNotesCardSurface_PointerMoved"
                PointerPressed="DemoNotesCardSurface_PointerPressed"
                PointerReleased="DemoNotesCardSurface_PointerReleased">
                <Border.RenderTransform>
                    <CompositeTransform />
                </Border.RenderTransform>
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!--
                        The condition illustration sits behind every row and is clipped to
                        the card's own corner radius, so a motif can bleed off the corner
                        instead of floating inside a visible box. It is decoration only: it
                        takes no pointer input, and it carries no automation name because
                        the same facts are already stated in the card's text.
                    -->
                    <Border
                        Grid.Row="0"
                        Grid.RowSpan="4"
                        Margin="-12"
                        CornerRadius="{StaticResource WwbCardCornerRadius}"
                        IsHitTestVisible="False">
                        <ContentControl
                            automation:AutomationProperties.AccessibilityView="Raw"
                            Content="{x:Bind WeatherConditionIconId, Mode=OneWay}"
                            ContentTemplateSelector="{StaticResource WeatherBackdropSelector}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            IsTabStop="False"
                            Visibility="{x:Bind RuntimePresentation.IsContentVisible, Mode=OneWay}" />
                    </Border>
                    <Grid
                        Grid.Row="0"
                        ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Uid="WeatherCardTitle"
                            Grid.ColumnSpan="2"
                            Style="{StaticResource WwbCardTitleStyle}" />
                        <TextBlock
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            automation:AutomationProperties.AutomationId="WeatherLocationText"
                            Style="{StaticResource WwbCardCaptionStyle}"
                            Text="{x:Bind WeatherLocationLabel, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{x:Bind HasWeatherLocation, Mode=OneWay}" />
                    </Grid>
                    <Grid Grid.Row="1">
                        <ContentControl
                            x:Name="WeatherCardRuntimeStatus"
                            automation:AutomationProperties.Name="{x:Bind RuntimePresentation.AutomationSummary, Mode=OneWay}"
                            automation:AutomationProperties.HelpText="{x:Bind WeatherAutomationSummary, Mode=OneWay}"
                            Content="{x:Bind RuntimePresentation, Mode=OneWay}"
                            ContentTemplate="{StaticResource CardRuntimeStatusTemplate}"
                            IsTabStop="False"
                            Visibility="{x:Bind RuntimePresentation.IsStateVisible, Mode=OneWay}" />
                        <!--
                            Two bands, and which axis separates them depends on the card's
                            shape rather than on its size order. A four-column card is only
                            one row tall at W, so the forecast goes beside the reading; a
                            two-column card that is two rows tall stacks them. The cell is
                            bound rather than duplicated, so there is one hourly list in the
                            tree and one automation ID for it.
                        -->
                        <Grid
                            ColumnSpacing="{StaticResource WwbSpace4}"
                            RowSpacing="{StaticResource WwbSpace2}"
                            Visibility="{x:Bind RuntimePresentation.IsContentVisible, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel
                                Grid.Row="0"
                                Grid.Column="0"
                                Grid.ColumnSpan="{x:Bind WeatherCurrentColumnSpan, Mode=OneWay}"
                                Spacing="{StaticResource WwbSpace1}">
                                <!--
                                    The number, the sky, and the word for it, on one line. The
                                    glyph used to sit under the temperature at 16 DIP, where a
                                    clear sky and an overcast one were the same grey disc and
                                    the row read as a bullet point. At 24 DIP beside the
                                    figure it is the second thing the eye lands on, which is
                                    what a weather card is for.
                                -->
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="{StaticResource WwbSpace2}">
                                    <TextBlock
                                        automation:AutomationProperties.AutomationId="WeatherTemperatureText"
                                        automation:AutomationProperties.Name="{x:Bind WeatherTemperatureText, Mode=OneWay}"
                                        Style="{StaticResource WwbWeatherTemperatureStyle}"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind WeatherTemperatureText, Mode=OneWay}" />
                                    <ContentControl
                                        Width="24"
                                        Height="24"
                                        VerticalAlignment="Center"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        automation:AutomationProperties.AccessibilityView="Raw"
                                        Content="{x:Bind WeatherConditionIconId, Mode=OneWay}"
                                        ContentTemplateSelector="{StaticResource WeatherGlyphSelector}"
                                        IsTabStop="False" />
                                    <TextBlock
                                        automation:AutomationProperties.AutomationId="WeatherConditionText"
                                        automation:AutomationProperties.Name="{x:Bind WeatherConditionText, Mode=OneWay}"
                                        Style="{StaticResource WwbCardBodyStyle}"
                                        Text="{x:Bind WeatherConditionText, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Center" />
                                </StackPanel>

                                <!--
                                    Today's range, under the condition rather than among the
                                    secondary readings: it is the one number pair that changes
                                    what the reader does next, and it stays on the smallest
                                    card, where felt temperature, humidity and wind do not.
                                    The two values read high/low at every size; a slash keeps
                                    them from running together without spending width on
                                    labels.
                                -->
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="{StaticResource WwbSpace1}"
                                    Visibility="{x:Bind HasWeatherHighLow, Mode=OneWay}">
                                    <TextBlock
                                        automation:AutomationProperties.AutomationId="WeatherHighTemperatureText"
                                        Margin="0,0,4,0"
                                        Style="{StaticResource WwbCardBodyStyle}"
                                        Text="{x:Bind WeatherHighTemperatureText, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Margin="0,0,4,0"
                                        Style="{StaticResource WwbCardCaptionStyle}"
                                        Text="/"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        automation:AutomationProperties.AutomationId="WeatherLowTemperatureText"
                                        Style="{StaticResource WwbCardBodyStyle}"
                                        Text="{x:Bind WeatherLowTemperatureText, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Center" />
                                </StackPanel>

                                <!--
                                    Each secondary reading is still named - three bare numbers
                                    say nothing about which is the felt temperature and which
                                    the humidity, and the first of them reads as a second
                                    temperature. What changed is the weight: they run inline in
                                    caption type instead of a two-row grid of their own. They
                                    are reference figures, and stacking a label over each value
                                    gave them the same standing as today's range, which is the
                                    one pair that changes what the reader does next. Inline
                                    also buys back the row the trend now spends.
                                -->
                                <StackPanel
                                    Orientation="Horizontal"
                                    Margin="0,2,0,0"
                                    Spacing="{StaticResource WwbSpace2}"
                                    Visibility="{x:Bind HasWeatherSecondary, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock
                                            x:Uid="WeatherApparentLabel"
                                            Style="{StaticResource WwbCardCaptionStyle}" />
                                        <TextBlock
                                            automation:AutomationProperties.AutomationId="WeatherApparentTemperatureText"
                                            Style="{StaticResource WwbCardCaptionStyle}"
                                            Text="{x:Bind WeatherApparentTemperatureText, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock
                                            x:Uid="WeatherHumidityLabel"
                                            Style="{StaticResource WwbCardCaptionStyle}" />
                                        <TextBlock
                                            automation:AutomationProperties.AutomationId="WeatherHumidityText"
                                            Style="{StaticResource WwbCardCaptionStyle}"
                                            Text="{x:Bind WeatherHumidityText, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock
                                            x:Uid="WeatherWindLabel"
                                            Style="{StaticResource WwbCardCaptionStyle}" />
                                        <TextBlock
                                            automation:AutomationProperties.AutomationId="WeatherWindText"
                                            Style="{StaticResource WwbCardCaptionStyle}"
                                            Text="{x:Bind WeatherWindText, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel
                                Grid.Row="{x:Bind WeatherForecastRow, Mode=OneWay}"
                                Grid.Column="{x:Bind WeatherForecastColumn, Mode=OneWay}"
                                Grid.ColumnSpan="{x:Bind WeatherForecastColumnSpan, Mode=OneWay}"
                                Spacing="{StaticResource WwbSpace1}"
                                VerticalAlignment="Top">
                                <!--
                                    The trend as a curve rather than a row of times. Six
                                    columns of "time, glyph, temperature" spent three rows of
                                    height to list six numbers and could not say the one thing
                                    the reader wants from them - that it starts cooling at
                                    dusk. The curve says it in less height, carries twice the
                                    hours, and answers any single hour on hover.

                                    No divider under it: the fill fades to nothing at its own
                                    baseline, and a hairline as well would put a hard edge back
                                    under a shape that was just softened.
                                -->
                                <layout:WeatherHourlyCurve
                                    Height="{x:Bind WeatherCurveHeight, Mode=OneWay}"
                                    Style="{StaticResource WwbWeatherHourlyCurveStyle}"
                                    GlyphTemplateSelector="{StaticResource WeatherGlyphSelector}"
                                    Points="{x:Bind WeatherCurvePoints, Mode=OneWay}"
                                    IsHitTestVisible="{x:Bind AreCardActionsVisible, Mode=OneWay}"
                                    Visibility="{x:Bind HasWeatherHours, Mode=OneWay}"
                                    automation:AutomationProperties.Name="{x:Bind WeatherCurveAutomationName, Mode=OneWay}"
                                    automation:AutomationProperties.AutomationId="WeatherHourlyCurve" />

                                <!--
                                    How far the trend reaches. The hover readout names any one
                                    hour exactly; these three marks answer the question it
                                    cannot, which is whether the line covers the evening or
                                    the next two days.
                                -->
                                <Grid
                                    Margin="0,-2,0,2"
                                    Visibility="{x:Bind HasWeatherCurveAxis, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Style="{StaticResource WwbCardCaptionStyle}"
                                        Text="{x:Bind WeatherCurveAxisStartText, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource WwbCardCaptionStyle}"
                                        Text="{x:Bind WeatherCurveAxisMidText, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Style="{StaticResource WwbCardCaptionStyle}"
                                        Text="{x:Bind WeatherCurveAxisEndText, Mode=OneWay}" />
                                </Grid>

                                <ItemsControl
                                    automation:AutomationProperties.AutomationId="WeatherDailyList"
                                    ItemsSource="{x:Bind WeatherDays, Mode=OneWay}"
                                    ItemTemplate="{StaticResource WeatherDayTemplate}"
                                    Visibility="{x:Bind HasWeatherDays, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <!--
                        Context, on one line: when the reading was taken and who supplied it.
                        Both used to take a row each, and the attribution was a full-weight
                        accent link - the loudest thing on a card whose subject is a
                        temperature.
                    -->
                    <StackPanel
                        Grid.Row="2"
                        Orientation="Horizontal"
                        Spacing="{StaticResource WwbSpace2}"
                        Visibility="{x:Bind HasWeatherFooter, Mode=OneWay}">
                        <TextBlock
                            x:Uid="WeatherObservedAtLabel"
                            Style="{StaticResource WwbCardCaptionStyle}"
                            VerticalAlignment="Center" />
                        <TextBlock
                            automation:AutomationProperties.AutomationId="WeatherObservedAtText"
                            Style="{StaticResource WwbCardCaptionStyle}"
                            Text="{x:Bind WeatherObservedAtText, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center" />
                        <!--
                            The attribution is stated in the panel's language; the provider's
                            English phrase would make this the one mixed-language line on the
                            card. The brand name and the link are what the licence needs.

                            Bound, not stated: the card has more than one possible source and
                            both vendors require attribution, so a fixed brand name here would
                            credit whichever one happened to be first.
                        -->
                        <HyperlinkButton
                            automation:AutomationProperties.AutomationId="WeatherAttributionLink"
                            Content="{x:Bind WeatherAttributionText, Mode=OneWay}"
                            HorizontalAlignment="Left"
                            MinHeight="16"
                            Padding="0"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            NavigateUri="{x:Bind WeatherAttributionUrl, Mode=OneWay}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                                        <!--
                        Edit mode draws a resize frame over the card instead of a bar under it.
                        It spans every row and reaches past the card padding, so the handles sit
                        on the surface edge; its middle takes no pointer input, which is what
                        leaves the existing move drag and the interactive-content guard alone.
                    -->
                    <layout:CardResizeFrame
                        x:Uid="CardResizeFrame"
                        Grid.Row="0"
                        Grid.RowSpan="9"
                        Margin="-12"
                        automation:AutomationProperties.AutomationId="WeatherCardResizeFrame"
                        Style="{StaticResource WwbCardResizeFrameStyle}"
                        Tag="{x:Bind InstanceId}"
                        Visibility="{x:Bind IsEditing, Mode=OneWay}"
                        PointerPressed="CardResizeFrame_PointerPressed"
                        PointerMoved="CardResizeFrame_PointerMoved"
                        PointerReleased="CardResizeFrame_PointerReleased"
                        PointerCaptureLost="CardResizeFrame_PointerCaptureLost"
                        PointerCanceled="CardResizeFrame_PointerCanceled"
                        PointerEntered="CardResizeFrame_PointerMoved"
                        PointerExited="CardResizeFrame_PointerExited" />
                    <Button
                        x:Uid="RemoveCardButton"
                        Grid.Row="0"
                        Grid.RowSpan="9"
                        automation:AutomationProperties.AutomationId="WeatherCardRemoveButton"
                        Style="{StaticResource WwbCardRemoveBadgeStyle}"
                        Tag="{x:Bind InstanceId}"
                        Visibility="{x:Bind IsEditing, Mode=OneWay}"
                        Click="RemoveCardButton_Click" />
                </Grid>
            </Border>
        </DataTemplate>

