            x:Key="SystemMonitorCardTemplate"
            x:DataType="layout:CardSurfaceItem">
            <Border
                MinHeight="160"
                Style="{StaticResource WwbCardSurfaceStyle}"
                RenderTransformOrigin="0.5,0.5"
                Tag="{x:Bind InstanceId}"
                PointerCaptureLost="DemoNotesCardSurface_PointerCaptureLost"
                PointerCanceled="DemoNotesCardSurface_PointerCanceled"
                PointerMoved="DemoNotesCardSurface_PointerMoved"
                PointerPressed="DemoNotesCardSurface_PointerPressed"
                PointerReleased="DemoNotesCardSurface_PointerReleased">
                <Border.RenderTransform>
                    <CompositeTransform />
                </Border.RenderTransform>
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Uid="SystemMonitorCardTitle"
                            Style="{StaticResource WwbCardTitleStyle}" />
                        <Button
                            x:Uid="SysMonSettingsButton"
                            Grid.Column="1"
                            Style="{StaticResource WwbCardIconButtonStyle}"
                            Visibility="{x:Bind AreCardActionsVisible, Mode=OneWay}"
                            Click="SysMonSettingsButton_Click"
                            automation:AutomationProperties.AutomationId="SysMonSettingsButton">
                            <FontIcon FontSize="14" Glyph="&#xE713;" />
                        </Button>
                    </Grid>
                    <Grid Grid.Row="1">
                        <ContentControl
                            automation:AutomationProperties.Name="{x:Bind RuntimePresentation.AutomationSummary, Mode=OneWay}"
                            Content="{x:Bind RuntimePresentation, Mode=OneWay}"
                            ContentTemplate="{StaticResource CardRuntimeStatusTemplate}"
                            IsTabStop="False"
                            Visibility="{x:Bind RuntimePresentation.IsStateVisible, Mode=OneWay}" />
                        <!--
                            The headline and the readings under it, in one set of markup that
                            serves both arrangements. Stacked, the headline spans both columns
                            and the readings take the row beneath; beside each other - the four
                            column sizes - the headline takes the Auto column and the readings
                            the star column of row 0, which is the only way a card one row tall
                            can carry both. The cells come from CardSurfaceItem, so the tree
                            holds one reading list and one automation id either way.

                            Row gaps are the headline block's own bottom margin rather than
                            RowSpacing, which is charged for the empty row of the beside-each-
                            other arrangement as well.
                        -->
                        <Grid
                            ColumnSpacing="12"
                            VerticalAlignment="Top"
                            Visibility="{x:Bind RuntimePresentation.IsContentVisible, Mode=OneWay}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!--
                                The leading reading's last two minutes, behind its value. It
                                reaches past the card padding on the left for the same reason
                                the token card's spend curve does: it is a backdrop, and one
                                that stops at the text margin reads as a box. Beside the
                                readings its right edge runs into the column gap rather than
                                under them. In edit mode it stops taking the pointer, so a
                                press on the headline still starts a move.
                            -->
                            <layout:SystemMonitorCurve
                                x:Uid="SystemMonitorHeadlineCurve"
                                Grid.ColumnSpan="{x:Bind SystemMonitorHeadlineColumnSpan, Mode=OneWay}"
                                Margin="-12,0"
                                Style="{StaticResource WwbSystemMonitorHeadlineCurveStyle}"
                                Points="{x:Bind SystemMonitorHeadline.CurvePoints, Mode=OneWay}"
                                IsHitTestVisible="{x:Bind AreCardActionsVisible, Mode=OneWay}"
                                Visibility="{x:Bind SystemMonitorHeadline.IsCurveVisible, Mode=OneWay}"
                                automation:AutomationProperties.AutomationId="SystemMonitorHeadlineCurve" />
                            <!--
                                The reading the user ranked first, given the weight the weather
                                card gives its temperature. A uniform table of rows gives the
                                reading this card is opened for no more emphasis than the one
                                ranked last. It takes no pointer input, so the curve behind it
                                keeps the crosshair across the whole block.
                            -->
                            <StackPanel
                                Grid.ColumnSpan="{x:Bind SystemMonitorHeadlineColumnSpan, Mode=OneWay}"
                                MaxWidth="{x:Bind SystemMonitorHeadlineMaxWidth, Mode=OneWay}"
                                Margin="0,0,0,6"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                IsHitTestVisible="False"
                                Visibility="{x:Bind HasSystemMonitorHeadline, Mode=OneWay}"
                                automation:AutomationProperties.Name="{x:Bind SystemMonitorHeadline.AutomationName, Mode=OneWay}">
                                <TextBlock
                                    Style="{StaticResource WwbCardCaptionStyle}"
                                    Text="{x:Bind SystemMonitorHeadline.Name, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Style="{StaticResource WwbWeatherTemperatureStyle}"
                                    Text="{x:Bind SystemMonitorHeadline.PrimaryText, Mode=OneWay}"
                                    automation:AutomationProperties.AutomationId="SystemMonitorHeadlineValue" />
                                <TextBlock
                                    Style="{StaticResource WwbCardCaptionStyle}"
                                    Text="{x:Bind SystemMonitorHeadline.SecondaryText, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    Visibility="{x:Bind SystemMonitorHeadline.IsSecondaryVisible, Mode=OneWay}" />
                                <TextBlock
                                    Style="{StaticResource WwbCardCaptionStyle}"
                                    Text="{x:Bind SystemMonitorHeadline.MetricStatusText, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    Visibility="{x:Bind SystemMonitorHeadline.IsMetricStatusTextVisible, Mode=OneWay}" />
                            </StackPanel>
                            <ItemsControl
                                Grid.Row="{x:Bind SystemMonitorMetricsRow, Mode=OneWay}"
                                Grid.Column="{x:Bind SystemMonitorMetricsColumn, Mode=OneWay}"
                                Grid.ColumnSpan="{x:Bind SystemMonitorMetricsColumnSpan, Mode=OneWay}"
                                VerticalAlignment="Top"
                                ItemsSource="{x:Bind SystemMonitorMetrics}"
                                ItemTemplate="{StaticResource SystemMonitorMetricTemplate}"
                                IsTabStop="False"
                                automation:AutomationProperties.AutomationId="SystemMonitorMetricList" />
                        </Grid>
                    </Grid>
                                        <!--
                        Edit mode draws a resize frame over the card instead of a bar under it.
                        It spans every row and reaches past the card padding, so the handles sit
                        on the surface edge; its middle takes no pointer input, which is what
                        leaves the existing move drag and the interactive-content guard alone.
                    -->
                    <layout:CardResizeFrame
                        x:Uid="CardResizeFrame"
                        Grid.Row="0"
                        Grid.RowSpan="9"
                        Margin="-12"
                        automation:AutomationProperties.AutomationId="SystemMonitorCardResizeFrame"
                        Style="{StaticResource WwbCardResizeFrameStyle}"
                        Tag="{x:Bind InstanceId}"
                        Visibility="{x:Bind IsEditing, Mode=OneWay}"
                        PointerPressed="CardResizeFrame_PointerPressed"
                        PointerMoved="CardResizeFrame_PointerMoved"
                        PointerReleased="CardResizeFrame_PointerReleased"
                        PointerCaptureLost="CardResizeFrame_PointerCaptureLost"
                        PointerCanceled="CardResizeFrame_PointerCanceled"
                        PointerEntered="CardResizeFrame_PointerMoved"
                        PointerExited="CardResizeFrame_PointerExited" />
                    <Button
                        x:Uid="RemoveCardButton"
                        Grid.Row="0"
                        Grid.RowSpan="9"
                        automation:AutomationProperties.AutomationId="SystemMonitorCardRemoveButton"
                        Style="{StaticResource WwbCardRemoveBadgeStyle}"
                        Tag="{x:Bind InstanceId}"
                        Visibility="{x:Bind IsEditing, Mode=OneWay}"
                        Click="RemoveCardButton_Click" />
                </Grid>
            </Border>
        </DataTemplate>

        <!--
            One usage reading. Only the cache hit rate has a real ceiling, so it is the only
            row that shows a meter; a token count and a rate would need an invented maximum.
        -->
        <DataTemplate
            x:Key="TokenUsageMetricTemplate"
            x:DataType="runtime:TokenUsageMetricViewModel">
            <Grid
                Padding="0,2"
                RowSpacing="2"
                automation:AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!--
                    Proportional columns, not Auto. Each row is its own Grid inside the items
                    control, so an Auto column sizes to that row alone and every row puts its
                    numbers on a different edge - the ragged right the card had. Equal
                    proportions give every row the same two boundaries, and the figures are
                    right-aligned into them so digits line up by place value.
                -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Style="{StaticResource WwbCardCaptionStyle}"
                        Text="{x:Bind Name, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Grid.Column="1"
                        Grid.ColumnSpan="{x:Bind PrimaryColumnSpan, Mode=OneWay}"
                        Style="{StaticResource WwbCardBodyStyle}"
                        Text="{x:Bind PrimaryText, Mode=OneWay}"
                        TextAlignment="Right"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind HasReading, Mode=OneWay}" />
                    <TextBlock
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Style="{StaticResource WwbCardCaptionStyle}"
                        Text="{x:Bind MetricStatusText, Mode=OneWay}"
                        TextAlignment="Right"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind IsMetricStatusTextVisible, Mode=OneWay}" />
                    <TextBlock
                        Grid.Column="2"
                        Style="{StaticResource WwbCardCaptionStyle}"
                        Text="{x:Bind SecondaryText, Mode=OneWay}"
                        TextAlignment="Right"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind IsSecondaryVisible, Mode=OneWay}" />
                </Grid>
                <ProgressBar
                    Grid.Row="1"
                    Style="{StaticResource WwbMetricMeterStyle}"
                    Minimum="0"
                    Maximum="100"
                    Value="{x:Bind MeterPercent, Mode=OneWay}"
                    IsTabStop="False"
                    automation:AutomationProperties.AccessibilityView="Raw"
                    Visibility="{x:Bind IsMeterVisible, Mode=OneWay}" />
            </Grid>
        </DataTemplate>

        <!--
            One slice of the split, on the card that has a band for a row per slice. Built to
            the same proportions as a reading row, because it is read as one more line of the
            same table: what it is on the left, what it cost and what share it is on the right,
            and the share as a meter under them. Unlike a reading it always has a ceiling - a
            share of the day - so the meter is never in doubt here.
        -->
        <DataTemplate
            x:Key="TokenUsageBreakdownTemplate"
            x:DataType="runtime:TokenUsageBreakdownViewModel">
            <Grid
                Padding="0,2"
                RowSpacing="2"
                automation:AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Style="{StaticResource WwbCardCaptionStyle}"
                        Text="{x:Bind Label, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Grid.Column="1"
                        Style="{StaticResource WwbCardBodyStyle}"
                        Text="{x:Bind FigureText, Mode=OneWay}"
                        TextAlignment="Right"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Grid.Column="2"
                        Style="{StaticResource WwbCardCaptionStyle}"
                        Text="{x:Bind SecondaryText, Mode=OneWay}"
                        TextAlignment="Right"
                        TextTrimming="CharacterEllipsis" />
                </Grid>
                <ProgressBar
                    Grid.Row="1"
                    Style="{StaticResource WwbMetricMeterStyle}"
                    Minimum="0"
                    Maximum="100"
                    Value="{x:Bind MeterPercent, Mode=OneWay}"
                    IsTabStop="False"
                    automation:AutomationProperties.AccessibilityView="Raw" />
            </Grid>
        </DataTemplate>

        <!--
            One page tab. A ToggleButton rather than a Pivot or a NavigationView: the card is a
            few grid cells tall, and both of those spend a whole row on chrome before showing
            any content.
        -->
        <DataTemplate
            x:Key="TokenUsagePageTabTemplate"
            x:DataType="runtime:TokenUsagePageTabViewModel">
            <ToggleButton
                Style="{StaticResource WwbPageTabToggleStyle}"
                Content="{x:Bind Name, Mode=OneWay}"
                IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                Tag="{x:Bind PageId}"
                Click="TokenUsagePageTab_Click"
                automation:AutomationProperties.Name="{x:Bind Name, Mode=OneWay}" />
        </DataTemplate>

        <DataTemplate
            x:Key="TokenUsageCardTemplate"
            x:DataType="layout:CardSurfaceItem">
            <Border
                MinHeight="160"
                Style="{StaticResource WwbCardSurfaceStyle}"
                RenderTransformOrigin="0.5,0.5"
                Tag="{x:Bind InstanceId}"
                PointerCaptureLost="DemoNotesCardSurface_PointerCaptureLost"
                PointerCanceled="DemoNotesCardSurface_PointerCanceled"
                PointerMoved="DemoNotesCardSurface_PointerMoved"
                PointerPressed="DemoNotesCardSurface_PointerPressed"
                PointerReleased="DemoNotesCardSurface_PointerReleased">
                <Border.RenderTransform>
                    <CompositeTransform />
                </Border.RenderTransform>
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!--
                        The page tabs live here rather than above the amount. They choose which
                        page the whole card shows, which is card chrome of the same kind as the
                        gear beside them - and in the content flow they cost 30 DIP, which on a
                        two-cell card was the one reading it had room for. The title is the
                        star column, so a board with more vendors than fit trims the card's
                        name rather than the tabs that say which of them is on screen.
                    -->
                    <Grid Grid.Row="0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Uid="TokenUsageCardTitle"
                            VerticalAlignment="Center"
                            Style="{StaticResource WwbCardTitleStyle}"
                            TextTrimming="CharacterEllipsis" />
                        <ItemsControl
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            ItemsSource="{x:Bind TokenUsagePages}"
                            ItemTemplate="{StaticResource TokenUsagePageTabTemplate}"
                            IsTabStop="False"
                            automation:AutomationProperties.AutomationId="TokenUsagePageTabs"
                            Visibility="{x:Bind IsTokenUsagePageSwitcherVisible, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <Button
                            x:Uid="TokenUsageSettingsButton"
                            Grid.Column="2"
                            Style="{StaticResource WwbCardIconButtonStyle}"
                            Visibility="{x:Bind AreCardActionsVisible, Mode=OneWay}"
                            Click="TokenUsageSettingsButton_Click"
                            automation:AutomationProperties.AutomationId="TokenUsageSettingsButton">
                            <FontIcon FontSize="14" Glyph="&#xE713;" />
                        </Button>
                    </Grid>
                    <Grid Grid.Row="1">
                        <ContentControl
                            automation:AutomationProperties.Name="{x:Bind RuntimePresentation.AutomationSummary, Mode=OneWay}"
                            Content="{x:Bind RuntimePresentation, Mode=OneWay}"
                            ContentTemplate="{StaticResource CardRuntimeStatusTemplate}"
                            IsTabStop="False"
                            Visibility="{x:Bind RuntimePresentation.IsStateVisible, Mode=OneWay}" />
                        <!--
                            One grid, two arrangements - the same two cells the weather card
                            uses, not two sets of markup. Stacked, every block spans all three
                            columns and takes a row of its own; beside each other, the amount,
                            the tiles and the readings each take a column of row 0 and the
                            expanded split takes the band under them. The cells come from
                            CardSurfaceItem, so the tree holds one reading list and one
                            automation id either way.

                            The column spacing costs the stacked arrangement nothing: a child
                            spanning all three columns spans the gaps between them too, and the
                            two Auto columns are empty there. The row gaps are the blocks' own
                            bottom margins rather than RowSpacing, because RowSpacing is
                            charged for the empty rows as well - 18 DIP the four-column card,
                            which has 2 DIP to spare, does not have.
                        -->
                        <Grid
                            ColumnSpacing="12"
                            VerticalAlignment="Top"
                            Visibility="{x:Bind RuntimePresentation.IsContentVisible, Mode=OneWay}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!--
                                The day's spend hour by hour, behind the blocks of row 0. It
                                reaches past the card padding on both sides for the same reason
                                the weather motif bleeds off its corner: it is a backdrop, and a
                                backdrop that stops at the text margin reads as a box. It spans
                                every column so that the right edge is still "now" when the card
                                is four cells wide. The crosshair follows the pointer across it;
                                in edit mode the curve stops taking the pointer so a press on the
                                headline still starts a move.
                            -->
                            <layout:TokenUsageSpendCurve
                                x:Uid="TokenUsageSpendCurve"
                                Grid.ColumnSpan="3"
                                Margin="-12,0"
                                Style="{StaticResource WwbTokenUsageSpendCurveStyle}"
                                Points="{x:Bind TokenUsageSpendCurve, Mode=OneWay}"
                                IsHitTestVisible="{x:Bind AreCardActionsVisible, Mode=OneWay}"
                                Visibility="{x:Bind IsTokenUsageSpendCurveVisible, Mode=OneWay}"
                                automation:AutomationProperties.AutomationId="TokenUsageSpendCurve" />
                            <!--
                                The day's spend, given the weight the weather card gives its
                                temperature. It is the figure this card is opened for, and a
                                uniform table of rows would give it no more emphasis than the
                                response count. Grouped by type scale and spacing rather than by
                                a rule or a box, per the visual spec.

                                Every block here takes no pointer input, so the curve behind
                                them keeps the crosshair across the whole band.
                            -->
                            <StackPanel
                                Grid.ColumnSpan="{x:Bind TokenUsageHeadlineColumnSpan, Mode=OneWay}"
                                MaxWidth="{x:Bind TokenUsageHeadlineMaxWidth, Mode=OneWay}"
                                Margin="0,0,0,6"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                IsHitTestVisible="False">
                                <StackPanel
                                    Visibility="{x:Bind IsTokenUsageCostVisible, Mode=OneWay}">
                                    <TextBlock
                                        x:Uid="TokenUsageCostLabel"
                                        Style="{StaticResource WwbCardCaptionStyle}" />
                                    <TextBlock
                                        Style="{StaticResource WwbWeatherTemperatureStyle}"
                                        Text="{x:Bind TokenUsageCostText, Mode=OneWay}"
                                        automation:AutomationProperties.AutomationId="TokenUsageCostText" />
                                </StackPanel>
                                <!--
                                    Usage with no figure: say why (how many models have no
                                    rate) rather than dropping the headline silently.
                                -->
                                <TextBlock
                                    Style="{StaticResource WwbCardCaptionStyle}"
                                    Text="{x:Bind TokenUsageCostNoteText, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind IsTokenUsageCostNoteVisible, Mode=OneWay}"
                                    automation:AutomationProperties.AutomationId="TokenUsageCostNoteText" />
                            </StackPanel>
                            <!--
                                Two tiles: every token, and responses. They are the two numbers
                                a reader adds up or divides by in their head, so each carries
                                that arithmetic on its second line rather than leaving it to the
                                reader. Under the amount they need a second grid row; beside it
                                they cost the amount nothing, which is what earns them a place
                                on the four-column card that is only one row tall.
                            -->
                            <Grid
                                Grid.Row="{x:Bind TokenUsageKpiRow, Mode=OneWay}"
                                Grid.Column="{x:Bind TokenUsageKpiColumn, Mode=OneWay}"
                                Grid.ColumnSpan="{x:Bind TokenUsageKpiColumnSpan, Mode=OneWay}"
                                MaxWidth="{x:Bind TokenUsageKpiMaxWidth, Mode=OneWay}"
                                Margin="0,0,0,6"
                                VerticalAlignment="Top"
                                ColumnSpacing="8"
                                IsHitTestVisible="False"
                                Visibility="{x:Bind IsTokenUsageKpiVisible, Mode=OneWay}"
                                automation:AutomationProperties.AutomationId="TokenUsageKpiTiles">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock
                                        x:Uid="TokenUsageKpiTotalTokens"
                                        Style="{StaticResource WwbCardCaptionStyle}" />
                                    <TextBlock
                                        Style="{StaticResource WwbCardFigureStyle}"
                                        Text="{x:Bind TokenUsageTotalTokensText, Mode=OneWay}"
                                        automation:AutomationProperties.AutomationId="TokenUsageTotalTokensText" />
                                    <TextBlock
                                        Style="{StaticResource WwbCardCaptionStyle}"
                                        Text="{x:Bind TokenUsageTotalTokensNoteText, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock
                                        x:Uid="TokenUsageKpiRequests"
                                        Style="{StaticResource WwbCardCaptionStyle}" />
                                    <TextBlock
                                        Style="{StaticResource WwbCardFigureStyle}"
                                        Text="{x:Bind TokenUsageRequestsText, Mode=OneWay}"
                                        automation:AutomationProperties.AutomationId="TokenUsageRequestsText" />
                                    <TextBlock
                                        Style="{StaticResource WwbCardCaptionStyle}"
                                        Text="{x:Bind TokenUsageRequestsNoteText, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                            <ItemsControl
                                Grid.Row="{x:Bind TokenUsageMetricsRow, Mode=OneWay}"
                                Grid.Column="{x:Bind TokenUsageMetricsColumn, Mode=OneWay}"
                                Grid.ColumnSpan="{x:Bind TokenUsageMetricsColumnSpan, Mode=OneWay}"
                                Margin="0,0,0,6"
                                VerticalAlignment="Top"
                                IsHitTestVisible="False"
                                ItemsSource="{x:Bind TokenUsageMetrics}"
                                ItemTemplate="{StaticResource TokenUsageMetricTemplate}"
                                IsTabStop="False"
                                automation:AutomationProperties.AutomationId="TokenUsageMetricList" />
                            <!--
                                How the spend divides: the two largest slices at either end of
                                one meter, vendors on the overview and models on a vendor page.
                                One meter rather than a row per slice, because a row per slice
                                is the breakdown table that was drawn off the bottom of the
                                card the last time it was here - which is true of every size
                                except the one below, where the slices have a band of their own.
                            -->
                            <StackPanel
                                Grid.Row="3"
                                Grid.ColumnSpan="3"
                                Spacing="3"
                                VerticalAlignment="Top"
                                IsHitTestVisible="False"
                                Visibility="{x:Bind IsTokenUsageSplitVisible, Mode=OneWay}"
                                automation:AutomationProperties.AutomationId="TokenUsageSplit">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Style="{StaticResource WwbCardCaptionStyle}"
                                        Text="{x:Bind TokenUsageSplitLeadText, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        automation:AutomationProperties.AutomationId="TokenUsageSplitLeadText" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Style="{StaticResource WwbCardCaptionStyle}"
                                        Text="{x:Bind TokenUsageSplitTrailText, Mode=OneWay}"
                                        TextAlignment="Right"
                                        Visibility="{x:Bind IsTokenUsageSplitTrailVisible, Mode=OneWay}"
                                        automation:AutomationProperties.AutomationId="TokenUsageSplitTrailText" />
                                </Grid>
                                <ProgressBar
                                    Style="{StaticResource WwbMetricMeterStyle}"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="{x:Bind TokenUsageSplitPercent, Mode=OneWay}"
                                    IsTabStop="False"
                                    automation:AutomationProperties.AccessibilityView="Raw" />
                            </StackPanel>
                            <!--
                                The same split, a row per slice, under the band. Only the
                                four-by-two card has the height for it once its lanes are
                                filled - which is the size ADR-0036 did not have when it chose
                                the single meter.
                            -->
                            <ItemsControl
                                Grid.Row="1"
                                Grid.ColumnSpan="3"
                                VerticalAlignment="Top"
                                IsHitTestVisible="False"
                                ItemsSource="{x:Bind TokenUsageBreakdown}"
                                ItemTemplate="{StaticResource TokenUsageBreakdownTemplate}"
                                IsTabStop="False"
                                automation:AutomationProperties.AutomationId="TokenUsageBreakdownList"
                                Visibility="{x:Bind IsTokenUsageBreakdownVisible, Mode=OneWay}" />
                        </Grid>
                    </Grid>
                                        <!--
                        Edit mode draws a resize frame over the card instead of a bar under it.
                        It spans every row and reaches past the card padding, so the handles sit
                        on the surface edge; its middle takes no pointer input, which is what
                        leaves the existing move drag and the interactive-content guard alone.
                    -->
                    <layout:CardResizeFrame
                        x:Uid="CardResizeFrame"
                        Grid.Row="0"
                        Grid.RowSpan="9"
                        Margin="-12"
                        automation:AutomationProperties.AutomationId="TokenUsageCardResizeFrame"
                        Style="{StaticResource WwbCardResizeFrameStyle}"
                        Tag="{x:Bind InstanceId}"
                        Visibility="{x:Bind IsEditing, Mode=OneWay}"
                        PointerPressed="CardResizeFrame_PointerPressed"
                        PointerMoved="CardResizeFrame_PointerMoved"
                        PointerReleased="CardResizeFrame_PointerReleased"
                        PointerCaptureLost="CardResizeFrame_PointerCaptureLost"
                        PointerCanceled="CardResizeFrame_PointerCanceled"
                        PointerEntered="CardResizeFrame_PointerMoved"
                        PointerExited="CardResizeFrame_PointerExited" />
                    <Button
                        x:Uid="RemoveCardButton"
                        Grid.Row="0"
                        Grid.RowSpan="9"
                        automation:AutomationProperties.AutomationId="TokenUsageCardRemoveButton"
                        Style="{StaticResource WwbCardRemoveBadgeStyle}"
                        Tag="{x:Bind InstanceId}"
                        Visibility="{x:Bind IsEditing, Mode=OneWay}"
                        Click="RemoveCardButton_Click" />
                </Grid>
            </Border>
        </DataTemplate>

        <layout:CardSurfaceTemplateSelector
            x:Key="CardTemplateSelector"
            NotesTemplate="{StaticResource NotesCardTemplate}"
            WeatherTemplate="{StaticResource WeatherCardTemplate}"
            TimerTemplate="{StaticResource TimerCardTemplate}"
            TodoTemplate="{StaticResource TodoCardTemplate}"
            CalendarTemplate="{StaticResource CalendarCardTemplate}"
            SystemMonitorTemplate="{StaticResource SystemMonitorCardTemplate}"
            TokenUsageTemplate="{StaticResource TokenUsageCardTemplate}"
            DefaultTemplate="{StaticResource UnknownCardTemplate}" />
        </Grid.Resources>
        <Border
            Background="{ThemeResource WwbPanelAccentWashBrush}"
            IsHitTestVisible="False" />
        <Grid
            x:Name="RootGrid"
            Style="{StaticResource WwbPanelRootStyle}"
            IsTabStop="True"
            KeyDown="RootGrid_KeyDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                x:Name="HeaderBar"
                Grid.Row="0"
                Style="{StaticResource WwbHeaderSurfaceStyle}">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid
                        x:Name="HeaderCommandBar"
                        Grid.Row="0"
                        ColumnSpacing="8">
                        <!--
                            Two columns now. The middle one existed only to hold the note
                            search box, which moved to the card that owns notes.
                        -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Grid.Column="0"
                            MaxWidth="220"
                            Spacing="0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8">
                                <TextBlock
                                    x:Name="GreetingText"
                                    x:Uid="GreetingText"
                                    Style="{StaticResource WwbPanelTitleStyle}"
                                    TextWrapping="NoWrap"
                                    automation:AutomationProperties.HeadingLevel="Level1" />
                                <TextBlock
                                    x:Name="DateText"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource WwbPanelMetaStyle}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock
                                x:Name="ContextText"
                                Style="{StaticResource WwbPanelContextStyle}"
                                Visibility="Collapsed" />
                            <Border
                                MaxWidth="220"
                                HorizontalAlignment="Left"
                                Style="{StaticResource WwbStatusSurfaceStyle}">
                                <TextBlock
                                    x:Name="StatusText"
                                    MaxLines="1"
                                    Style="{StaticResource WwbPanelContextStyle}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </Border>
                        </StackPanel>

                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="2"
                            VerticalAlignment="Center">
                            <Button
                                x:Name="EditLayoutButton"
                                x:Uid="EditLayoutButton"
                                Style="{StaticResource WwbToolbarButtonStyle}"
                                Click="EditLayoutButton_Click" />
                            <Button
                                x:Name="AddCardButton"
                                x:Uid="AddCardButton"
                                Style="{StaticResource WwbToolbarButtonStyle}"
                                Visibility="Collapsed"
                                Click="AddCardButton_Click" />
                            <Button
                                x:Name="UndoLayoutButton"
                                x:Uid="UndoLayoutButton"
                                Style="{StaticResource WwbToolbarButtonStyle}"
                                Visibility="Collapsed"
                                Click="UndoLayoutButton_Click" />
                            <Button
                                x:Name="RedoLayoutButton"
                                x:Uid="RedoLayoutButton"
                                Style="{StaticResource WwbToolbarButtonStyle}"
                                Visibility="Collapsed"
                                Click="RedoLayoutButton_Click" />
                            <Button
                                x:Name="SettingsButton"
                                x:Uid="SettingsButton"
                                Style="{StaticResource WwbToolbarButtonStyle}"
                                Click="SettingsButton_Click" />
                            <Button
                                x:Name="ClosePanelButton"
                                x:Uid="ClosePanelButton"
                                Style="{StaticResource WwbToolbarButtonStyle}"
                                Click="ClosePanelButton_Click" />
                        </StackPanel>
                    </Grid>

                </Grid>
            </Border>

            <ScrollViewer
                x:Name="ContentScrollViewer"
                Grid.Row="1"
                Padding="{StaticResource WwbContentPadding}"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Top"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
                <Grid
                    x:Name="CardGridHost"
                    x:Uid="CardGridHost"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    SizeChanged="CardGridHost_SizeChanged">
                    <controls:ItemsRepeater
                        x:Name="CardItemsRepeater"
                        ElementPrepared="CardItemsRepeater_ElementPrepared"
                        ElementClearing="CardItemsRepeater_ElementClearing"
                        ItemTemplate="{StaticResource CardTemplateSelector}" />
                    <!--
                        The resize rubber band. It sits in the cards' own coordinate space so
                        it scrolls with them, and above the repeater so it is not covered by
                        the card it describes.

                        It is a 1x1 rectangle moved and stretched by a render transform rather
                        than an element that is measured: a drag sets this on every pointer
                        move, and re-running layout for a rectangle at that rate would be paid
                        for by the grid underneath it. Fill only, no stroke - a stroke would be
                        scaled with the shape and come out thick on one axis and thin on the
                        other.
                    -->
                    <!--
                        The resize preview. A Canvas, not a Grid: the band's size changes on
                        every pointer move, and a Canvas neither measures its children against
                        itself nor re-measures its siblings, so writing it costs nothing to the
                        card grid sharing this space.

                        It is a real rounded, stroked rectangle rather than the scaled
                        primitives it replaces. Those could not carry a corner radius or an
                        even stroke - both distort the moment the two axes scale by different
                        amounts - and a preview of a rounded card drawn as a hard-edged
                        wireframe reads as a debug overlay rather than as the card it stands in
                        for.
                    -->
                    <Canvas
                        x:Name="CardResizeGhostLayer"
                        IsHitTestVisible="False"
                        Visibility="Collapsed">
                        <Border
                            x:Name="CardResizeGhost"
                            CornerRadius="{StaticResource WwbCardCornerRadius}"
                            BorderThickness="1.5"
                            BorderBrush="{ThemeResource AccentFillColorSecondaryBrush}"
                            Translation="0,0,18">
                            <Border.Shadow>
                                <ThemeShadow />
                            </Border.Shadow>
                            <Rectangle
                                Opacity="0.12"
                                Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                        </Border>
                        <!--
                            The handle, travelling with the pointer. It is the same ring the
                            frame paints, so the thing that was picked up looks like the thing
                            being carried.
                        -->
                        <Border
                            x:Name="CardResizeGhostCorner"
                            Width="{StaticResource WwbCardResizeHandleSize}"
                            Height="{StaticResource WwbCardResizeHandleSize}"
                            CornerRadius="{StaticResource WwbCardResizeHandleRadius}"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            BorderThickness="2"
                            BorderBrush="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
                    </Canvas>
                </Grid>
            </ScrollViewer>

        </Grid>
    </Grid>
</Window>
