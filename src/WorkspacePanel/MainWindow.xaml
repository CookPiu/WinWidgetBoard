        <DataTemplate
            x:Key="WeatherCardTemplate"
            x:DataType="layout:CardSurfaceItem">
            <Border
                MinHeight="160"
                Style="{StaticResource WwbCardSurfaceStyle}"
                Padding="{StaticResource WwbCompactCardPadding}"
                RenderTransformOrigin="0.5,0.5"
                Tag="{x:Bind InstanceId}"
                PointerCaptureLost="DemoNotesCardSurface_PointerCaptureLost"
                PointerCanceled="DemoNotesCardSurface_PointerCanceled"
                PointerMoved="DemoNotesCardSurface_PointerMoved"
                PointerPressed="DemoNotesCardSurface_PointerPressed"
                PointerReleased="DemoNotesCardSurface_PointerReleased">
                <Border.RenderTransform>
                    <CompositeTransform />
                </Border.RenderTransform>
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!--
                        The condition illustration sits behind every row and is clipped to
                        the card's own corner radius, so a motif can bleed off the corner
                        instead of floating inside a visible box. It is decoration only: it
                        takes no pointer input, and it carries no automation name because
                        the same facts are already stated in the card's text.
                    -->
                    <Border
                        Grid.Row="0"
                        Grid.RowSpan="4"
                        Margin="-12"
                        CornerRadius="{StaticResource WwbCardCornerRadius}"
                        IsHitTestVisible="False">
                        <ContentControl
                            automation:AutomationProperties.AccessibilityView="Raw"
                            Content="{x:Bind WeatherConditionIconId, Mode=OneWay}"
                            ContentTemplateSelector="{StaticResource WeatherBackdropSelector}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            IsTabStop="False"
                            Visibility="{x:Bind RuntimePresentation.IsContentVisible, Mode=OneWay}" />
                    </Border>
                    <Grid
                        Grid.Row="0"
                        ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Uid="WeatherCardTitle"
                            Grid.ColumnSpan="2"
                            Style="{StaticResource WwbCardTitleStyle}" />
                        <TextBlock
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            automation:AutomationProperties.AutomationId="WeatherLocationText"
                            Style="{StaticResource WwbCardCaptionStyle}"
                            Text="{x:Bind WeatherLocationLabel, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{x:Bind HasWeatherLocation, Mode=OneWay}" />
                    </Grid>
                    <Grid Grid.Row="1">
                        <ContentControl
                            x:Name="WeatherCardRuntimeStatus"
                            automation:AutomationProperties.Name="{x:Bind RuntimePresentation.AutomationSummary, Mode=OneWay}"
                            automation:AutomationProperties.HelpText="{x:Bind WeatherAutomationSummary, Mode=OneWay}"
                            Content="{x:Bind RuntimePresentation, Mode=OneWay}"
                            ContentTemplate="{StaticResource CardRuntimeStatusTemplate}"
                            IsTabStop="False"
                            Visibility="{x:Bind RuntimePresentation.IsStateVisible, Mode=OneWay}" />
                        <!--
                            Three bands, in the order the question is actually asked: what it
                            is like now, what the rest of today does, what the next days do.
                            The previous layout put every secondary reading in one column of
                            equal-weight captions beside the temperature, which gave the
                            observation time the same standing as the temperature itself.
                        -->
                        <StackPanel
                            Spacing="{StaticResource WwbSpace3}"
                            Visibility="{x:Bind RuntimePresentation.IsContentVisible, Mode=OneWay}">
                            <Grid ColumnSpacing="{StaticResource WwbSpace3}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        automation:AutomationProperties.AutomationId="WeatherTemperatureText"
                                        automation:AutomationProperties.Name="{x:Bind WeatherTemperatureText, Mode=OneWay}"
                                        Style="{StaticResource WwbWeatherTemperatureStyle}"
                                        Text="{x:Bind WeatherTemperatureText, Mode=OneWay}" />
                                    <TextBlock
                                        automation:AutomationProperties.Name="{x:Bind WeatherConditionText, Mode=OneWay}"
                                        Style="{StaticResource WwbCardBodyStyle}"
                                        Text="{x:Bind WeatherConditionText, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <!--
                                    Secondary readings sit beside the temperature rather than
                                    under it, so the card's first glance stays one number.
                                -->
                                <StackPanel
                                    Grid.Column="1"
                                    Spacing="2"
                                    VerticalAlignment="Bottom">
                                    <TextBlock
                                        Style="{StaticResource WwbCardCaptionStyle}"
                                        Text="{x:Bind WeatherApparentTemperatureText, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Style="{StaticResource WwbCardCaptionStyle}"
                                        Text="{x:Bind WeatherHumidityText, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Style="{StaticResource WwbCardCaptionStyle}"
                                        Text="{x:Bind WeatherWindText, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>

                            <!--
                                The hourly trend scrolls sideways rather than wrapping: it is
                                one sequence in time, and a wrapped second row would read as a
                                second day.
                            -->
                            <ScrollViewer
                                x:Name="WeatherHourlyScroller"
                                HorizontalScrollBarVisibility="Hidden"
                                HorizontalScrollMode="Enabled"
                                VerticalScrollBarVisibility="Disabled"
                                VerticalScrollMode="Disabled"
                                Visibility="{x:Bind HasWeatherHours, Mode=OneWay}">
                                <ItemsControl
                                    automation:AutomationProperties.AutomationId="WeatherHourlyList"
                                    ItemsSource="{x:Bind WeatherHours, Mode=OneWay}"
                                    ItemTemplate="{StaticResource WeatherHourTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="10" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>

                            <ItemsControl
                                automation:AutomationProperties.AutomationId="WeatherDailyList"
                                ItemsSource="{x:Bind WeatherDays, Mode=OneWay}"
                                ItemTemplate="{StaticResource WeatherDayTemplate}"
                                Visibility="{x:Bind HasWeatherDays, Mode=OneWay}" />

                            <TextBlock
                                Style="{StaticResource WwbCardCaptionStyle}"
                                Text="{x:Bind WeatherObservedAtText, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                    <HyperlinkButton
                        Grid.Row="2"
                        HorizontalAlignment="Left"
                        MinHeight="20"
                        Padding="0"
                        FontSize="11"
                        Content="{x:Bind WeatherAttributionText, Mode=OneWay}"
                        NavigateUri="https://open-meteo.com/"
                        Visibility="{Binding HasWeatherData, Converter={StaticResource EditModeVisibilityConverter}}" />
                    <Border
                        Grid.Row="3"
                        HorizontalAlignment="Left"
                        Padding="{StaticResource WwbCompactToolbarPadding}"
                        Style="{StaticResource WwbEditToolbarSurfaceStyle}"
                        Visibility="{x:Bind IsEditing, Mode=OneWay}">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8">
                            <Border
                                Tag="{x:Bind InstanceId}"
                                Style="{StaticResource WwbDragHandleStyle}">
                                <TextBlock
                                    x:Name="WeatherCardDragHandle"
                                    x:Uid="DragCardHandle"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <Button
                                x:Uid="DecreaseCardButton"
                                Style="{StaticResource WwbEditActionButtonStyle}"
                                Tag="{x:Bind InstanceId}"
                                Click="DecreaseCardSizeButton_Click" />
                            <Button
                                x:Uid="IncreaseCardButton"
                                Style="{StaticResource WwbEditActionButtonStyle}"
                                Tag="{x:Bind InstanceId}"
                                Click="IncreaseCardSizeButton_Click" />
                            <Button
                                x:Uid="RemoveCardButton"
                                automation:AutomationProperties.AutomationId="WeatherCardRemoveButton"
                                Style="{StaticResource WwbDestructiveActionButtonStyle}"
                                Tag="{x:Bind InstanceId}"
                                Click="RemoveCardButton_Click" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate
