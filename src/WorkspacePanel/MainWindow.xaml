<Window
    x:Class="WinWidgetBoard.WorkspacePanel.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:layout="using:WinWidgetBoard.WorkspacePanel.Layout"
    xmlns:notes="using:WinWidgetBoard.WorkspacePanel.Notes"
    xmlns:runtime="using:WinWidgetBoard.WorkspacePanel.Runtime">

    <Grid>
        <Grid.Resources>
        <layout:EditModeVisibilityConverter
            x:Key="EditModeVisibilityConverter" />
        <layout:InverseVisibilityConverter
            x:Key="InverseVisibilityConverter" />
        <DataTemplate
            x:Key="NoteMarkdownBlankTemplate"
            x:DataType="notes:NoteMarkdownPreviewBlock">
            <Border Height="8" />
        </DataTemplate>
        <DataTemplate
            x:Key="NoteMarkdownParagraphTemplate"
            x:DataType="notes:NoteMarkdownPreviewBlock">
            <TextBlock
                Text="{x:Bind Text}"
                TextWrapping="Wrap" />
        </DataTemplate>
        <DataTemplate
            x:Key="NoteMarkdownHeading1Template"
            x:DataType="notes:NoteMarkdownPreviewBlock">
            <TextBlock
                FontSize="22"
                FontWeight="SemiBold"
                Text="{x:Bind Text}"
                TextWrapping="Wrap" />
        </DataTemplate>
        <DataTemplate
            x:Key="NoteMarkdownHeading2Template"
            x:DataType="notes:NoteMarkdownPreviewBlock">
            <TextBlock
                FontSize="18"
                FontWeight="SemiBold"
                Text="{x:Bind Text}"
                TextWrapping="Wrap" />
        </DataTemplate>
        <DataTemplate
            x:Key="NoteMarkdownHeading3Template"
            x:DataType="notes:NoteMarkdownPreviewBlock">
            <TextBlock
                FontWeight="SemiBold"
                Text="{x:Bind Text}"
                TextWrapping="Wrap" />
        </DataTemplate>
        <DataTemplate
            x:Key="NoteMarkdownUnorderedListItemTemplate"
            x:DataType="notes:NoteMarkdownPreviewBlock">
            <StackPanel
                Orientation="Horizontal"
                Spacing="8">
                <TextBlock
                    Text="{x:Bind Marker}" />
                <TextBlock
                    Text="{x:Bind Text}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate
            x:Key="NoteMarkdownOrderedListItemTemplate"
            x:DataType="notes:NoteMarkdownPreviewBlock">
            <StackPanel
                Orientation="Horizontal"
                Spacing="8">
                <TextBlock
                    Text="{x:Bind Marker}" />
                <TextBlock
                    Text="{x:Bind Text}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate
            x:Key="NoteMarkdownQuoteTemplate"
            x:DataType="notes:NoteMarkdownPreviewBlock">
            <StackPanel
                Orientation="Horizontal"
                Spacing="8">
                <TextBlock
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind Marker}" />
                <TextBlock
                    Text="{x:Bind Text}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate
            x:Key="NoteMarkdownCodeTemplate"
            x:DataType="notes:NoteMarkdownPreviewBlock">
            <TextBlock
                FontFamily="Consolas"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind Text}"
                TextWrapping="Wrap" />
        </DataTemplate>
        <notes:NoteMarkdownPreviewTemplateSelector
            x:Key="NoteMarkdownPreviewTemplateSelector"
            BlankTemplate="{StaticResource NoteMarkdownBlankTemplate}"
            ParagraphTemplate="{StaticResource NoteMarkdownParagraphTemplate}"
            Heading1Template="{StaticResource NoteMarkdownHeading1Template}"
            Heading2Template="{StaticResource NoteMarkdownHeading2Template}"
            Heading3Template="{StaticResource NoteMarkdownHeading3Template}"
            UnorderedListItemTemplate="{StaticResource NoteMarkdownUnorderedListItemTemplate}"
            OrderedListItemTemplate="{StaticResource NoteMarkdownOrderedListItemTemplate}"
            QuoteTemplate="{StaticResource NoteMarkdownQuoteTemplate}"
            CodeTemplate="{StaticResource NoteMarkdownCodeTemplate}" />
        <!--
            Compact condition glyphs for the hourly and daily rows, drawn as geometry rather
            than from an icon font: the card already composes its backdrop from primitives,
            and a font would add an availability dependency for eight shapes.

            Each glyph is a single Path with a non-zero fill rule (the leading "F1"), not a
            stack of ellipses. The stack was the visible defect: the glyph brush is itself
            translucent, so every place two discs met came out a shade darker than the rest of
            the cloud, and at 18 DIP a cloud with three seams in it reads as noise. One
            geometry unions its own subpaths before anything is painted, so the mark is flat.
            Subpaths therefore have to wind the same way - every circle is drawn clockwise,
            with sweep flag 1 - or the overlap would punch a hole instead of filling.

            The cloud keeps to the upper two thirds and the precipitation marks to the lower
            third. Sharing the same band turned rain into one dark blob at 18 DIP, which is the
            size at which a glyph either reads instantly or is noise.

            Day and night share a shape. At this size a crescent and a disc are nearly the same
            mark, and the row already carries its own time or weekday; the distinction that
            matters is carried by the backdrop, which is large enough to show it.
        -->
        <!--
            A sun, not a disc. A bare disc was the right call while the glyph only ever drew at
            18 DIP beside a line of text; now it also carries the card's headline at 24 DIP and
            marks every forecast row, and at any size a lone circle has the same silhouette as
            the mass of the cloud glyphs - a row of them reads as bullet points, not weather.
            The rays start clear of the disc, so no subpath overlaps another and the winding
            rule never comes into it.
        -->
        <DataTemplate x:Key="WeatherGlyphClearTemplate">
            <Viewbox Stretch="Uniform">
                <Grid Width="18" Height="18" Opacity="0.85">
                    <Path
                        Stretch="None"
                        Data="F1 M 5,9 A 4,4 0 1 1 13,9 A 4,4 0 1 1 5,9 Z M 8.3,1.2 L 9.7,1.2 L 9.7,3.8 L 8.3,3.8 Z M 8.3,14.2 L 9.7,14.2 L 9.7,16.8 L 8.3,16.8 Z M 1.2,8.3 L 3.8,8.3 L 3.8,9.7 L 1.2,9.7 Z M 14.2,8.3 L 16.8,8.3 L 16.8,9.7 L 14.2,9.7 Z M 12.47,4.55 L 14.10,2.92 L 15.09,3.91 L 13.46,5.54 Z M 5.53,4.55 L 3.90,2.92 L 2.91,3.91 L 4.54,5.54 Z M 12.47,13.45 L 14.10,15.08 L 15.09,14.09 L 13.46,12.46 Z M 5.53,13.45 L 3.90,15.08 L 2.91,14.09 L 4.54,12.46 Z"
                        Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Viewbox>
        </DataTemplate>

        <!--
            A crescent for a clear night. This is the one glyph drawn with the even-odd rule
            rather than the non-zero one every other glyph uses: the shape is a circle with a
            bite taken out of it, and a bite is exactly the hole the other rule exists to
            prevent. The second circle sticks out past the first, so what is left is a crescent
            rather than a ring.
        -->
        <DataTemplate x:Key="WeatherGlyphClearNightTemplate">
            <Viewbox Stretch="Uniform">
                <Grid Width="18" Height="18" Opacity="0.85">
                    <Path
                        Stretch="None"
                        Data="F0 M 3,9 A 6,6 0 1 1 15,9 A 6,6 0 1 1 3,9 Z M 6,7.2 A 5.4,5.4 0 1 1 16.8,7.2 A 5.4,5.4 0 1 1 6,7.2 Z"
                        Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Viewbox>
        </DataTemplate>

        <DataTemplate x:Key="WeatherGlyphPartlyCloudyTemplate">
            <Viewbox Stretch="Uniform">
                <Grid Width="18" Height="18" Opacity="0.85">
                    <Path
                        Stretch="None"
                        Data="F1 M 9.0,5.4 A 3.6,3.6 0 1 1 16.2,5.4 A 3.6,3.6 0 1 1 9.0,5.4 Z M 0.7,10.6 A 2.9,2.9 0 1 1 6.5,10.6 A 2.9,2.9 0 1 1 0.7,10.6 Z M 4.1,9.0 A 3.9,3.9 0 1 1 11.9,9.0 A 3.9,3.9 0 1 1 4.1,9.0 Z M 9.5,10.8 A 2.7,2.7 0 1 1 14.9,10.8 A 2.7,2.7 0 1 1 9.5,10.8 Z M 3.6,10.6 L 12.2,10.6 L 12.2,13.5 L 3.6,13.5 Z"
                        Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Viewbox>
        </DataTemplate>

        <DataTemplate x:Key="WeatherGlyphCloudyTemplate">
            <Viewbox Stretch="Uniform">
                <Grid Width="18" Height="18" Opacity="0.85">
                    <Path
                        Stretch="None"
                        Data="F1 M 1.0,10.2 A 3.2,3.2 0 1 1 7.4,10.2 A 3.2,3.2 0 1 1 1.0,10.2 Z M 4.7,8.4 A 4.3,4.3 0 1 1 13.3,8.4 A 4.3,4.3 0 1 1 4.7,8.4 Z M 10.8,10.4 A 3.0,3.0 0 1 1 16.8,10.4 A 3.0,3.0 0 1 1 10.8,10.4 Z M 4.2,10.2 L 13.8,10.2 L 13.8,13.4 L 4.2,13.4 Z"
                        Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Viewbox>
        </DataTemplate>

        <DataTemplate x:Key="WeatherGlyphFogTemplate">
            <Viewbox Stretch="Uniform">
                <Grid Width="18" Height="18" Opacity="0.85">
                    <Path
                        Stretch="None"
                        Data="F1 M 1.0,8.0 A 3.2,3.2 0 1 1 7.4,8.0 A 3.2,3.2 0 1 1 1.0,8.0 Z M 4.7,6.2 A 4.3,4.3 0 1 1 13.3,6.2 A 4.3,4.3 0 1 1 4.7,6.2 Z M 10.8,8.2 A 3.0,3.0 0 1 1 16.8,8.2 A 3.0,3.0 0 1 1 10.8,8.2 Z M 4.2,8.0 L 13.8,8.0 L 13.8,11.2 L 4.2,11.2 Z M 3.9,12.5 L 14.1,12.5 A 0.9,0.9 0 0 1 14.1,14.3 L 3.9,14.3 A 0.9,0.9 0 0 1 3.9,12.5 Z M 6.3,15.5 L 11.7,15.5 A 0.9,0.9 0 0 1 11.7,17.3 L 6.3,17.3 A 0.9,0.9 0 0 1 6.3,15.5 Z"
                        Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Viewbox>
        </DataTemplate>

        <DataTemplate x:Key="WeatherGlyphRainTemplate">
            <Viewbox Stretch="Uniform">
                <Grid Width="18" Height="18" Opacity="0.85">
                    <Path
                        Stretch="None"
                        Data="F1 M 1.0,8.0 A 3.2,3.2 0 1 1 7.4,8.0 A 3.2,3.2 0 1 1 1.0,8.0 Z M 4.7,6.2 A 4.3,4.3 0 1 1 13.3,6.2 A 4.3,4.3 0 1 1 4.7,6.2 Z M 10.8,8.2 A 3.0,3.0 0 1 1 16.8,8.2 A 3.0,3.0 0 1 1 10.8,8.2 Z M 4.2,8.0 L 13.8,8.0 L 13.8,11.2 L 4.2,11.2 Z M 4.55,13.2 A 0.85,0.85 0 0 1 6.25,13.2 L 6.25,16.0 A 0.85,0.85 0 0 1 4.55,16.0 Z M 8.15,12.8 A 0.85,0.85 0 0 1 9.85,12.8 L 9.85,15.6 A 0.85,0.85 0 0 1 8.15,15.6 Z M 11.75,13.2 A 0.85,0.85 0 0 1 13.45,13.2 L 13.45,16.0 A 0.85,0.85 0 0 1 11.75,16.0 Z"
                        Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Viewbox>
        </DataTemplate>

        <DataTemplate x:Key="WeatherGlyphSnowTemplate">
            <Viewbox Stretch="Uniform">
                <Grid Width="18" Height="18" Opacity="0.85">
                    <Path
                        Stretch="None"
                        Data="F1 M 1.0,8.0 A 3.2,3.2 0 1 1 7.4,8.0 A 3.2,3.2 0 1 1 1.0,8.0 Z M 4.7,6.2 A 4.3,4.3 0 1 1 13.3,6.2 A 4.3,4.3 0 1 1 4.7,6.2 Z M 10.8,8.2 A 3.0,3.0 0 1 1 16.8,8.2 A 3.0,3.0 0 1 1 10.8,8.2 Z M 4.2,8.0 L 13.8,8.0 L 13.8,11.2 L 4.2,11.2 Z M 4.15,14.2 A 1.25,1.25 0 1 1 6.65,14.2 A 1.25,1.25 0 1 1 4.15,14.2 Z M 7.75,15.4 A 1.25,1.25 0 1 1 10.25,15.4 A 1.25,1.25 0 1 1 7.75,15.4 Z M 11.35,14.2 A 1.25,1.25 0 1 1 13.85,14.2 A 1.25,1.25 0 1 1 11.35,14.2 Z"
                        Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Viewbox>
        </DataTemplate>

        <DataTemplate x:Key="WeatherGlyphStormTemplate">
            <Viewbox Stretch="Uniform">
                <Grid Width="18" Height="18" Opacity="0.85">
                    <Path
                        Stretch="None"
                        Data="F1 M 1.0,8.0 A 3.2,3.2 0 1 1 7.4,8.0 A 3.2,3.2 0 1 1 1.0,8.0 Z M 4.7,6.2 A 4.3,4.3 0 1 1 13.3,6.2 A 4.3,4.3 0 1 1 4.7,6.2 Z M 10.8,8.2 A 3.0,3.0 0 1 1 16.8,8.2 A 3.0,3.0 0 1 1 10.8,8.2 Z M 4.2,8.0 L 13.8,8.0 L 13.8,11.2 L 4.2,11.2 Z M 10.4,11.0 L 6.2,15.2 L 8.7,15.2 L 7.8,17.6 L 11.9,13.2 L 9.4,13.2 Z"
                        Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Viewbox>
        </DataTemplate>

        <DataTemplate x:Key="WeatherGlyphEmptyTemplate">
            <Viewbox Stretch="Uniform">
                <Grid Width="18" Height="18" />
            </Viewbox>
        </DataTemplate>

        <layout:WeatherBackdropTemplateSelector
            x:Key="WeatherGlyphSelector"
            ClearDayTemplate="{StaticResource WeatherGlyphClearTemplate}"
            ClearNightTemplate="{StaticResource WeatherGlyphClearNightTemplate}"
            PartlyCloudyDayTemplate="{StaticResource WeatherGlyphPartlyCloudyTemplate}"
            PartlyCloudyNightTemplate="{StaticResource WeatherGlyphPartlyCloudyTemplate}"
            CloudyTemplate="{StaticResource WeatherGlyphCloudyTemplate}"
            FogTemplate="{StaticResource WeatherGlyphFogTemplate}"
            RainTemplate="{StaticResource WeatherGlyphRainTemplate}"
            SnowTemplate="{StaticResource WeatherGlyphSnowTemplate}"
            ThunderstormTemplate="{StaticResource WeatherGlyphStormTemplate}"
            EmptyTemplate="{StaticResource WeatherGlyphEmptyTemplate}" />

        <!--
            One hour of the trend: time, its condition glyph, its temperature. The glyph comes
            from the same reduced condition set the card and the taskbar entry already share,
            so an hour and the current reading cannot disagree about what "rain" looks like.
        -->
        <DataTemplate
            x:Key="WeatherHourTemplate"
            x:DataType="runtime:WeatherHourProjection">
            <StackPanel
                MinWidth="44"
                Spacing="2"
                HorizontalAlignment="Center">
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource WwbCardCaptionStyle}"
                    Text="{x:Bind TimeText}" />
                <ContentControl
                    Width="18"
                    Height="18"
                    HorizontalAlignment="Center"
                    automation:AutomationProperties.AccessibilityView="Raw"
                    Content="{x:Bind ConditionIconId}"
                    ContentTemplateSelector="{StaticResource WeatherGlyphSelector}"
                    IsTabStop="False" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource WwbCardBodyStyle}"
                    Text="{x:Bind TemperatureText}" />
            </StackPanel>
        </DataTemplate>

        <!--
            One day of the forecast: name, condition, then the day's span drawn on the scale
            every visible row shares, with its two temperatures at the ends. Five rows of two
            numbers tell you each day in isolation; five bars on one scale tell you the week -
            which day is the warm one, and where the spread narrows.

            The bar is a control, not a star column. Inside these card templates a star column
            is measured against infinity and arranged past the clip, which is what used to cut
            the high temperature off this very row.
        -->
        <DataTemplate
            x:Key="WeatherDayTemplate"
            x:DataType="runtime:WeatherDayRow">
            <Grid
                ColumnSpacing="{StaticResource WwbSpace2}"
                Padding="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Style="{StaticResource WwbCardBodyStyle}"
                    Text="{x:Bind DayText}"
                    TextTrimming="CharacterEllipsis" />
                <ContentControl
                    Grid.Column="1"
                    Width="16"
                    Height="16"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    automation:AutomationProperties.AccessibilityView="Raw"
                    Content="{x:Bind ConditionIconId}"
                    ContentTemplateSelector="{StaticResource WeatherGlyphSelector}"
                    IsTabStop="False" />
                <TextBlock
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    Style="{StaticResource WwbCardCaptionStyle}"
                    Text="{x:Bind LowTemperatureText}"
                    TextTrimming="CharacterEllipsis" />
                <layout:WeatherRangeBar
                    Grid.Column="3"
                    Margin="0,0,0,0"
                    Style="{StaticResource WwbWeatherRangeBarStyle}"
                    Offset="{x:Bind Offset}"
                    Length="{x:Bind Length}" />
                <TextBlock
                    Grid.Column="4"
                    Style="{StaticResource WwbCardBodyStyle}"
                    Text="{x:Bind HighTemperatureText}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>

        <DataTemplate
            x:Key="CardRuntimeStatusTemplate"
            x:DataType="runtime:CardRuntimeStatusPresentation">
            <Border Style="{StaticResource WwbCardRuntimeStatusSurfaceStyle}">
                <StackPanel Spacing="4">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Style="{StaticResource WwbCardRuntimeStatusCriticalIconStyle}"
                            Text="!"
                            Visibility="{Binding IsCritical, Converter={StaticResource EditModeVisibilityConverter}}" />
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource WwbCardRuntimeStatusTitleStyle}"
                            Text="{x:Bind Title}"
                            TextWrapping="Wrap" />
                    </Grid>
                    <TextBlock
                        Style="{StaticResource WwbCardRuntimeStatusSummaryStyle}"
                        Text="{x:Bind Summary}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Style="{StaticResource WwbCardRuntimeStatusFreshnessStyle}"
                        Text="{x:Bind FreshnessText}"
                        TextWrapping="Wrap"
                        Visibility="{Binding HasFreshnessText, Converter={StaticResource EditModeVisibilityConverter}}" />
                    <Border
                        x:Name="CardRuntimeLoadingSkeleton"
                        Padding="8"
                        Style="{StaticResource WwbCardRuntimeStatusSurfaceStyle}"
                        Visibility="{Binding IsLoading, Converter={StaticResource EditModeVisibilityConverter}}">
                        <StackPanel Spacing="8">
                            <Border Style="{StaticResource WwbCardRuntimeStatusSkeletonBlockStyle}" />
                            <Border
                                Width="180"
                                HorizontalAlignment="Left"
                                Style="{StaticResource WwbCardRuntimeStatusSkeletonBlockStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate
            x:Key="NotesCardTemplate"
            x:DataType="layout:CardSurfaceItem">
            <Border
                MinHeight="160"
                Style="{StaticResource WwbCardSurfaceStyle}"
                RenderTransformOrigin="0.5,0.5"
                Tag="{x:Bind InstanceId}"
                PointerCaptureLost="DemoNotesCardSurface_PointerCaptureLost"
                PointerCanceled="DemoNotesCardSurface_PointerCanceled"
                PointerMoved="DemoNotesCardSurface_PointerMoved"
                PointerPressed="DemoNotesCardSurface_PointerPressed"
                PointerReleased="DemoNotesCardSurface_PointerReleased">
                <Border.RenderTransform>
                    <CompositeTransform />
                </Border.RenderTransform>
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid
                        x:Name="DemoNotesCardSurface"
                        Grid.Row="0"
                        Background="Transparent">
                        <Grid
                            ColumnSpacing="6"
                            RowSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                x:Uid="NotesCardTitle"
                                Grid.ColumnSpan="2"
                                Style="{StaticResource WwbCardTitleStyle}" />
                            <StackPanel
                                Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="{StaticResource WwbSpace1}"
                                Visibility="{x:Bind AreNoteToolsVisible, Mode=OneWay}">
                                <Button
                                    x:Name="ListNotesButton"
                                    x:Uid="ListNotesButton"
                                    Style="{StaticResource WwbCardIconButtonStyle}"
                                    IsEnabled="{x:Bind NoteSearch.CanSearch, Mode=OneWay}"
                                    Tag="{Binding ElementName=NoteSearchResultsBorder}"
                                    Click="ListNotesButton_Click" />
                                <Button
                                    x:Name="PopOutNoteButton"
                                    x:Uid="PopOutNoteButton"
                                    Style="{StaticResource WwbCardIconButtonStyle}"
                                    IsEnabled="{x:Bind NoteEditor.CanEdit, Mode=OneWay}"
                                    Click="PopOutNoteButton_Click"
                                    automation:AutomationProperties.AutomationId="PopOutNoteButton" />
                                <Button
                                    x:Name="NewNoteButton"
                                    x:Uid="NewNoteButton"
                                    Style="{StaticResource WwbCardIconButtonStyle}"
                                    IsEnabled="{x:Bind NoteEditor.CanEdit, Mode=OneWay}"
                                    Tag="{Binding ElementName=NoteOverflowPanel}"
                                    Click="NewNoteButton_Click">
                                    <ToolTipService.ToolTip>
                                        <TextBlock x:Uid="NewNoteButtonToolTip" />
                                    </ToolTipService.ToolTip>
                                </Button>
                                <Grid
                                    x:Name="NotePreviewCommandHost"
                                    x:Load="{x:Bind NoteEditor.CanPreviewMarkdown, Mode=OneWay}">
                                    <Button
                                        x:Name="PreviewNoteButton"
                                        x:Uid="PreviewNoteButton"
                                        Style="{StaticResource WwbCardIconButtonStyle}"
                                        IsEnabled="{x:Bind NoteEditor.CanPreviewMarkdown, Mode=OneWay}"
                                        Tag="{Binding ElementName=NoteOverflowPanel}"
                                        Click="PreviewNoteButton_Click">
                                        <ToolTipService.ToolTip>
                                            <TextBlock x:Uid="PreviewNoteButtonToolTip" />
                                        </ToolTipService.ToolTip>
                                    </Button>
                                    <Button
                                        x:Name="EditMarkdownButton"
                                        x:Uid="EditMarkdownButton"
                                        Style="{StaticResource WwbCardIconButtonStyle}"
                                        IsEnabled="{x:Bind NoteEditor.CanEdit, Mode=OneWay}"
                                        Tag="{Binding ElementName=NoteOverflowPanel}"
                                        Visibility="Collapsed"
                                        Click="EditMarkdownButton_Click">
                                        <ToolTipService.ToolTip>
                                            <TextBlock x:Uid="EditMarkdownButtonToolTip" />
                                        </ToolTipService.ToolTip>
                                    </Button>
                                </Grid>
                                <Button
                                    x:Name="NoteMoreButton"
                                    x:Uid="NoteMoreButton"
                                    Style="{StaticResource WwbCardIconButtonStyle}"
                                    Tag="{Binding ElementName=NoteOverflowPanel}"
                                    Click="NoteMoreButton_Click">
                                    <ToolTipService.ToolTip>
                                        <TextBlock x:Uid="NoteMoreButtonToolTip" />
                                    </ToolTipService.ToolTip>
                                </Button>
                            </StackPanel>
                            <ContentControl
                                x:Name="NotesCardRuntimeStatus"
                                Grid.Row="1"
                                Grid.ColumnSpan="3"
                                automation:AutomationProperties.Name="{x:Bind RuntimePresentation.AutomationSummary, Mode=OneWay}"
                                automation:AutomationProperties.HelpText="{x:Bind RuntimePresentation.Summary, Mode=OneWay}"
                                Content="{x:Bind RuntimePresentation, Mode=OneWay}"
                                ContentTemplate="{StaticResource CardRuntimeStatusTemplate}"
                                IsTabStop="False"
                                Visibility="{x:Bind RuntimePresentation.IsStateVisible, Mode=OneWay}" />
                        </Grid>
                    </Grid>
                    <ScrollViewer
                        x:Name="NotesCardScrollViewer"
                        x:Uid="NotesCardScrollViewer"
                        Grid.Row="1"
                        Margin="0"
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        VerticalScrollMode="Enabled"
                        Visibility="{x:Bind RuntimePresentation.IsContentVisible, Mode=OneWay}">
                        <!--
                            MinHeight tracks the scroller's viewport, which is what lets the
                            star row below have a real height to divide. A star row measured
                            inside a ScrollViewer otherwise gets infinity and collapses to its
                            content, which is how the body box came to need a hard-coded 148:
                            the card grew and the editor did not.
                        -->
                        <Grid
                            RowSpacing="8"
                            MinHeight="{Binding ViewportHeight, ElementName=NotesCardScrollViewer}">
                            <!--
                                The editor and the Markdown preview share the star row and
                                are never shown together. When the preview sat in a row of
                                its own, hiding the editor left the star row with nothing in
                                it, and it kept the leftover height anyway - the preview was
                                pushed to the bottom of the card with a blank above it.
                            -->
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!--
                                Note browsing lives on the card that owns notes. It used to
                                sit in the panel header, above every card including the ones
                                it had nothing to do with, and it pushed the whole board down
                                whenever it opened.
                            -->
                            <Border
                                x:Name="NoteSearchResultsBorder"
                                Style="{StaticResource WwbSecondarySurfaceStyle}"
                                Visibility="Collapsed">
                                <StackPanel Spacing="6">
                                    <TextBox
                                        x:Name="SearchBox"
                                        x:Uid="SearchBox"
                                        Style="{StaticResource WwbSearchBoxStyle}"
                                        IsEnabled="{x:Bind NoteSearch.CanSearch, Mode=OneWay}"
                                        MaxLength="256"
                                        KeyDown="SearchBox_KeyDown"
                                        TextChanged="SearchBox_TextChanged" />
                                    <ListView
                                    x:Name="NoteSearchResultsList"
                                    x:Uid="NoteSearchResultsList"
                                    ItemsSource="{x:Bind NoteSearch.Results, Mode=OneWay}"
                                    IsEnabled="{x:Bind NoteEditor.CanEdit, Mode=OneWay}"
                                    IsItemClickEnabled="False"
                                    MaxHeight="{x:Bind NoteSwitcherListMaxHeight, Mode=OneWay}"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="notes:NoteSearchResult">
                                            <Grid ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Button
                                                    Grid.Column="0"
                                                    Tag="{x:Bind NoteId}"
                                                    Style="{StaticResource WwbSearchResultButtonStyle}"
                                                    Click="NoteSearchResultButton_Click"
                                                    automation:AutomationProperties.Name="{x:Bind Title}">
                                                    <StackPanel
                                                        Spacing="{StaticResource WwbSpace1}">
                                                        <TextBlock
                                                            Text="{x:Bind Title}"
                                                            TextTrimming="CharacterEllipsis"
                                                            Style="{StaticResource WwbSearchResultTitleStyle}" />
                                                        <TextBlock
                                                            Text="{x:Bind Preview}"
                                                            TextWrapping="Wrap"
                                                            Style="{StaticResource WwbSearchResultPreviewStyle}" />
                                                    </StackPanel>
                                                </Button>
                                                <Button
                                                    Grid.Column="1"
                                                    x:Uid="DeleteNoteButton"
                                                    Style="{StaticResource WwbDestructiveActionButtonStyle}"
                                                    Click="DeleteNoteButton_Click" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                </StackPanel>
                            </Border>

                            <Grid
                                x:Name="NoteEditorInputPanel"
                                Grid.Row="1"
                                RowSpacing="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBox
                                    x:Name="NoteTitleBox"
                                    x:Uid="NoteTitleBox"
                                    Style="{StaticResource WwbNoteTitleTextBoxStyle}"
                                    IsEnabled="{x:Bind NoteEditor.CanEdit, Mode=OneWay}"
                                    MaxLength="512"
                                    Text="{x:Bind NoteEditor.Title, Mode=OneWay}"
                                    TextChanged="NoteTitleBox_TextChanged"
                                    PreviewKeyDown="NoteTextBox_PreviewKeyDown" />
                                <!--
                                    No minimum height: the star row already hands the body
                                    every DIP the card has left, and a floor above what a
                                    one-row card can offer only bought a second scrollbar
                                    nested inside the card's own.
                                -->
                                <TextBox
                                    x:Name="NoteBodyBox"
                                    x:Uid="NoteBodyBox"
                                    Grid.Row="1"
                                    Style="{StaticResource WwbNoteBodyTextBoxStyle}"
                                    AcceptsReturn="True"
                                    IsEnabled="{x:Bind NoteEditor.CanEdit, Mode=OneWay}"
                                    MaxLength="262144"
                                    ScrollViewer.HorizontalScrollMode="Disabled"
                                    ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                    ScrollViewer.VerticalScrollMode="Enabled"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    Text="{x:Bind NoteEditor.Body, Mode=OneWay}"
                                    TextChanged="NoteBodyBox_TextChanged"
                                    PreviewKeyDown="NoteTextBox_PreviewKeyDown"
                                    TextWrapping="Wrap"
                                    VerticalAlignment="Stretch"
                                    VerticalContentAlignment="Top" />
                            </Grid>
                            <Border
                                x:Name="NoteMarkdownPreviewPanel"
                                Grid.Row="1"
                                x:Uid="NoteMarkdownPreviewPanel"
                                Style="{StaticResource WwbSecondarySurfaceStyle}"
                                Visibility="Collapsed">
                                <ListView
                                    x:Name="NoteMarkdownPreviewText"
                                    x:Uid="NoteMarkdownPreviewText"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    IsItemClickEnabled="False"
                                    IsTabStop="False"
                                    ItemsSource="{x:Bind NoteEditor.MarkdownPreviewBlocks, Mode=OneWay}"
                                    ItemTemplateSelector="{StaticResource NoteMarkdownPreviewTemplateSelector}"
                                    Padding="0"
                                    SelectionMode="None" />
                            </Border>
                            <Border
                                x:Name="NoteOverflowPanel"
                                Grid.Row="2"
                                Tag="{Binding ElementName=NoteMoreButton}"
                                Style="{StaticResource WwbNoteOverflowSurfaceStyle}"
                                Visibility="Collapsed">
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox
                                        x:Name="MarkdownModeCheckBox"
                                        x:Uid="MarkdownModeCheckBox"
                                        Grid.Column="0"
                                        Style="{StaticResource WwbModeCheckBoxStyle}"
                                        IsChecked="{x:Bind NoteEditor.IsMarkdown, Mode=OneWay}"
                                        IsEnabled="{x:Bind NoteEditor.CanChangeMarkdownMode, Mode=OneWay}"
                                        Tag="{Binding ElementName=NoteOverflowPanel}"
                                        Click="MarkdownModeCheckBox_Click" />
                                    <Button
                                        x:Name="CopyNoteButton"
                                        x:Uid="CopyNoteButton"
                                        Grid.Column="1"
                                        Style="{StaticResource WwbNoteUtilityButtonStyle}"
                                        IsEnabled="{x:Bind NoteEditor.CanEdit, Mode=OneWay}"
                                        Tag="{Binding ElementName=NoteOverflowPanel}"
                                        Click="CopyNoteButton_Click" />
                                    <Button
                                        x:Name="DeleteCurrentNoteButton"
                                        x:Uid="DeleteCurrentNoteButton"
                                        Grid.Column="2"
                                        Style="{StaticResource WwbNoteUtilityButtonStyle}"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                        IsEnabled="{x:Bind NoteEditor.CanEdit, Mode=OneWay}"
                                        Tag="{Binding ElementName=NoteOverflowPanel}"
                                        Click="DeleteCurrentNoteButton_Click" />
                                </Grid>
                            </Border>
                            <Grid
                                x:Name="NoteEditorFooter"
                                Grid.Row="3"
                                VerticalAlignment="Bottom"
                                ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="NoteEditorStatusText"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource WwbPanelContextStyle}"
                                    Text="{x:Bind NoteStatusText, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                                <StackPanel
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="2">
                                    <Button
                                        x:Name="ReloadNoteButton"
                                        x:Uid="ReloadNoteButton"
                                        Style="{StaticResource WwbNoteUtilityButtonStyle}"
                                        IsEnabled="{x:Bind NoteEditor.CanReload, Mode=OneWay}"
                                        x:Load="{x:Bind NoteEditor.CanReload, Mode=OneWay}"
                                        Click="ReloadNoteButton_Click" />
                                    <Button
                                        x:Name="RetryNoteSaveButton"
                                        x:Uid="RetryNoteSaveButton"
                                        Style="{StaticResource WwbNoteUtilityButtonStyle}"
                                        IsEnabled="{x:Bind NoteEditor.CanRetrySave, Mode=OneWay}"
                                        x:Load="{x:Bind NoteEditor.CanRetrySave, Mode=OneWay}"
                                        Click="RetryNoteSaveButton_Click" />
                                    <Button
                                        x:Name="UndoNoteButton"
                                        x:Uid="UndoNoteButton"
                                        Style="{StaticResource WwbNoteUtilityButtonStyle}"
                                        IsEnabled="{x:Bind NoteEditor.CanUndo, Mode=OneWay}"
                                        x:Load="{x:Bind NoteEditor.CanUndo, Mode=OneWay}"
                                        Click="UndoNoteButton_Click" />
                                    <Button
                                        x:Name="RedoNoteButton"
                                        x:Uid="RedoNoteButton"
                                        Style="{StaticResource WwbNoteUtilityButtonStyle}"
                                        IsEnabled="{x:Bind NoteEditor.CanRedo, Mode=OneWay}"
                                        x:Load="{x:Bind NoteEditor.CanRedo, Mode=OneWay}"
                                        Click="RedoNoteButton_Click" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                    <!--
                        Edit mode draws a resize frame over the card instead of a bar under it.
                        It spans every row and reaches past the card padding, so the handles sit
                        on the surface edge; its middle takes no pointer input, which is what
                        leaves the existing move drag and the interactive-content guard alone.
                    -->
                    <layout:CardResizeFrame
                        x:Uid="CardResizeFrame"
                        Grid.Row="0"
                        Grid.RowSpan="9"
                        Margin="-12"
                        automation:AutomationProperties.AutomationId="NotesCardResizeFrame"
                        Style="{StaticResource WwbCardResizeFrameStyle}"
                        Tag="{x:Bind InstanceId}"
                        Visibility="{x:Bind IsEditing, Mode=OneWay}"
                        PointerPressed="CardResizeFrame_PointerPressed"
                        PointerMoved="CardResizeFrame_PointerMoved"
                        PointerReleased="CardResizeFrame_PointerReleased"
                        PointerCaptureLost="CardResizeFrame_PointerCaptureLost"
                        PointerCanceled="CardResizeFrame_PointerCanceled"
                        PointerEntered="CardResizeFrame_PointerMoved"
                        PointerExited="CardResizeFrame_PointerExited" />
                    <Button
                        x:Uid="RemoveCardButton"
                        Grid.Row="0"
                        Grid.RowSpan="9"
                        automation:AutomationProperties.AutomationId="NotesCardRemoveButton"
                        Style="{StaticResource WwbCardRemoveBadgeStyle}"
                        Tag="{x:Bind InstanceId}"
                        Visibility="{x:Bind IsEditing, Mode=OneWay}"
                        Click="RemoveCardButton_Click" />
                </Grid>
            </Border>
        </DataTemplate>

        <!--
            The condition backdrops. Each one is a flat sky wash with a single motif group
            over it, and that structure is the point: the group carries the whole
            illustration's opacity, so its shapes are painted opaque against each other and a
            cloud in front of the sun hides the part it covers. Drawing each shape at its own
            low opacity instead - which is what these did - turned every overlap into a
            brighter patch than either shape forming it, so the sun showed through the cloud
            and the two-cloud backdrop had a seam down its middle. There are now at most two
            translucent layers anywhere on the card: the sky, and the motif over it.

            The motifs sit bottom-right and bleed off the corner, because the card's text runs
            down the left. Sizes are in DIP and deliberately larger than the smallest card:
            being clipped by the card's own rounded corner is the intended look, not overflow.
        -->
        <DataTemplate x:Key="WeatherBackdropClearDayTemplate">
            <Grid>
                <Rectangle Fill="{ThemeResource WwbWeatherSkyClearBrush}" />
                <Grid Opacity="{ThemeResource WwbWeatherMotifOpacity}">
                    <!--
                        Halo and disc are concentric. The halo is what separates a clear sky
                        from a plain wash on a card too small to show much of the disc.
                    -->
                    <Ellipse
                        Width="152"
                        Height="152"
                        Margin="0,0,-52,-56"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Fill="{ThemeResource WwbWeatherMotifBrush}" />
                    <Ellipse
                        Width="96"
                        Height="96"
                        Margin="0,0,-24,-28"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Fill="{ThemeResource WwbWeatherMotifStrongBrush}" />
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="WeatherBackdropClearNightTemplate">
            <Grid>
                <Rectangle Fill="{ThemeResource WwbWeatherSkyNightBrush}" />
                <Grid Opacity="{ThemeResource WwbWeatherMotifOpacity}">
                    <Ellipse
                        Width="10"
                        Height="10"
                        Margin="0,0,84,74"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Fill="{ThemeResource WwbWeatherMotifBrush}" />
                    <Ellipse
                        Width="7"
                        Height="7"
                        Margin="0,0,116,44"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Fill="{ThemeResource WwbWeatherMotifBrush}" />
                    <Ellipse
                        Width="6"
                        Height="6"
                        Margin="0,0,66,104"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Fill="{ThemeResource WwbWeatherMotifBrush}" />
                    <Path
