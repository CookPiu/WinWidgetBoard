<Window
    x:Class="WinWidgetBoard.WorkspacePanel.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:layout="using:WinWidgetBoard.WorkspacePanel.Layout"
    xmlns:notes="using:WinWidgetBoard.WorkspacePanel.Notes"
    xmlns:runtime="using:WinWidgetBoard.WorkspacePanel.Runtime">

    <Grid>
        <Grid.Resources>
        <layout:EditModeVisibilityConverter
            x:Key="EditModeVisibilityConverter" />
        <layout:InverseVisibilityConverter
            x:Key="InverseVisibilityConverter" />
        <DataTemplate
            x:Key="NoteMarkdownBlankTemplate"
            x:DataType="notes:NoteMarkdownPreviewBlock">
            <Border Height="8" />
        </DataTemplate>
        <DataTemplate
            x:Key="NoteMarkdownParagraphTemplate"
            x:DataType="notes:NoteMarkdownPreviewBlock">
            <TextBlock
                Text="{x:Bind Text}"
                TextWrapping="Wrap" />
        </DataTemplate>
        <DataTemplate
            x:Key="NoteMarkdownHeading1Template"
            x:DataType="notes:NoteMarkdownPreviewBlock">
            <TextBlock
                FontSize="22"
                FontWeight="SemiBold"
                Text="{x:Bind Text}"
                TextWrapping="Wrap" />
        </DataTemplate>
        <DataTemplate
            x:Key="NoteMarkdownHeading2Template"
            x:DataType="notes:NoteMarkdownPreviewBlock">
            <TextBlock
                FontSize="18"
                FontWeight="SemiBold"
                Text="{x:Bind Text}"
                TextWrapping="Wrap" />
        </DataTemplate>
        <DataTemplate
            x:Key="NoteMarkdownHeading3Template"
            x:DataType="notes:NoteMarkdownPreviewBlock">
            <TextBlock
                FontWeight="SemiBold"
                Text="{x:Bind Text}"
                TextWrapping="Wrap" />
        </DataTemplate>
        <DataTemplate
            x:Key="NoteMarkdownUnorderedListItemTemplate"
            x:DataType="notes:NoteMarkdownPreviewBlock">
            <StackPanel
                Orientation="Horizontal"
                Spacing="8">
                <TextBlock
                    Text="{x:Bind Marker}" />
                <TextBlock
                    Text="{x:Bind Text}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate
            x:Key="NoteMarkdownOrderedListItemTemplate"
            x:DataType="notes:NoteMarkdownPreviewBlock">
            <StackPanel
                Orientation="Horizontal"
                Spacing="8">
                <TextBlock
                    Text="{x:Bind Marker}" />
                <TextBlock
                    Text="{x:Bind Text}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate
            x:Key="NoteMarkdownQuoteTemplate"
            x:DataType="notes:NoteMarkdownPreviewBlock">
            <StackPanel
                Orientation="Horizontal"
                Spacing="8">
                <TextBlock
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind Marker}" />
                <TextBlock
                    Text="{x:Bind Text}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate
            x:Key="NoteMarkdownCodeTemplate"
            x:DataType="notes:NoteMarkdownPreviewBlock">
            <TextBlock
                FontFamily="Consolas"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind Text}"
                TextWrapping="Wrap" />
        </DataTemplate>
        <notes:NoteMarkdownPreviewTemplateSelector
            x:Key="NoteMarkdownPreviewTemplateSelector"
            BlankTemplate="{StaticResource NoteMarkdownBlankTemplate}"
            ParagraphTemplate="{StaticResource NoteMarkdownParagraphTemplate}"
            Heading1Template="{StaticResource NoteMarkdownHeading1Template}"
            Heading2Template="{StaticResource NoteMarkdownHeading2Template}"
            Heading3Template="{StaticResource NoteMarkdownHeading3Template}"
            UnorderedListItemTemplate="{StaticResource NoteMarkdownUnorderedListItemTemplate}"
            OrderedListItemTemplate="{StaticResource NoteMarkdownOrderedListItemTemplate}"
            QuoteTemplate="{StaticResource NoteMarkdownQuoteTemplate}"
            CodeTemplate="{StaticResource NoteMarkdownCodeTemplate}" />
        <DataTemplate
            x:Key="CardRuntimeStatusTemplate"
            x:DataType="runtime:CardRuntimeStatusPresentation">
            <Border Style="{StaticResource WwbCardRuntimeStatusSurfaceStyle}">
                <StackPanel Spacing="4">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Style="{StaticResource WwbCardRuntimeStatusCriticalIconStyle}"
                            Text="!"
                            Visibility="{Binding IsCritical, Converter={StaticResource EditModeVisibilityConverter}}" />
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource WwbCardRuntimeStatusTitleStyle}"
                            Text="{x:Bind Title}"
                            TextWrapping="Wrap" />
                    </Grid>
                    <TextBlock
                        Style="{StaticResource WwbCardRuntimeStatusSummaryStyle}"
                        Text="{x:Bind Summary}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Style="{StaticResource WwbCardRuntimeStatusFreshnessStyle}"
                        Text="{x:Bind FreshnessText}"
                        TextWrapping="Wrap"
                        Visibility="{Binding HasFreshnessText, Converter={StaticResource EditModeVisibilityConverter}}" />
                    <Border
                        x:Name="CardRuntimeLoadingSkeleton"
                        Padding="8"
                        Style="{StaticResource WwbCardRuntimeStatusSurfaceStyle}"
                        Visibility="{Binding IsLoading, Converter={StaticResource EditModeVisibilityConverter}}">
                        <StackPanel Spacing="8">
                            <Border Style="{StaticResource WwbCardRuntimeStatusSkeletonBlockStyle}" />
                            <Border
                                Width="180"
                                HorizontalAlignment="Left"
                                Style="{StaticResource WwbCardRuntimeStatusSkeletonBlockStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate
            x:Key="NotesCardTemplate"
            x:DataType="layout:CardSurfaceItem">
            <Border
                MinHeight="360"
                Style="{StaticResource WwbCardSurfaceStyle}"
                RenderTransformOrigin="0.5,0.5"
                Tag="{x:Bind InstanceId}"
                PointerCaptureLost="DemoNotesCardSurface_PointerCaptureLost"
                PointerCanceled="DemoNotesCardSurface_PointerCanceled"
                PointerMoved="DemoNotesCardSurface_PointerMoved"
                PointerPressed="DemoNotesCardSurface_PointerPressed"
                PointerReleased="DemoNotesCardSurface_PointerReleased">
                <Border.RenderTransform>
                    <CompositeTransform />
                </Border.RenderTransform>
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid
                        x:Name="DemoNotesCardSurface"
                        Grid.Row="0"
                        MinHeight="112"
                        Background="Transparent">
                        <StackPanel Spacing="12">
                            <TextBlock
                                x:Uid="NotesCardTitle"
                                Style="{StaticResource WwbCardTitleStyle}" />
                            <TextBlock
                                x:Uid="NotesCardBody"
                                Style="{StaticResource WwbCardBodyStyle}"
                                TextWrapping="Wrap" />
                            <ContentControl
                                x:Name="NotesCardRuntimeStatus"
                                automation:AutomationProperties.Name="{x:Bind RuntimePresentation.AutomationSummary, Mode=OneWay}"
                                automation:AutomationProperties.HelpText="{x:Bind RuntimePresentation.Summary, Mode=OneWay}"
                                Content="{x:Bind RuntimePresentation, Mode=OneWay}"
                                ContentTemplate="{StaticResource CardRuntimeStatusTemplate}"
                                IsTabStop="False"
                                Visibility="{Binding RuntimePresentation.IsStateVisible, Converter={StaticResource EditModeVisibilityConverter}}" />
                        </StackPanel>
                    </Grid>
                    <ScrollViewer
                        x:Name="NotesCardScrollViewer"
                        x:Uid="NotesCardScrollViewer"
                        Grid.Row="1"
                        Margin="0,4,0,0"
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        VerticalScrollMode="Enabled"
                        Visibility="{Binding RuntimePresentation.IsContentVisible, Converter={StaticResource EditModeVisibilityConverter}}">
                        <StackPanel Spacing="12">
                            <StackPanel
                                x:Name="NoteEditorInputPanel"
                                Spacing="8"
                                Visibility="{Binding NoteEditor.IsMarkdownPreviewVisible, Converter={StaticResource InverseVisibilityConverter}}">
                                <TextBox
                                    x:Name="NoteTitleBox"
                                    x:Uid="NoteTitleBox"
                                    Style="{StaticResource WwbNoteTitleTextBoxStyle}"
                                    IsEnabled="{x:Bind NoteEditor.CanEdit, Mode=OneWay}"
                                    Text="{x:Bind NoteEditor.Title, Mode=OneWay}"
                                    TextChanged="NoteTitleBox_TextChanged" />
                                <TextBox
                                    x:Name="NoteBodyBox"
                                    x:Uid="NoteBodyBox"
                                    Height="128"
                                    Style="{StaticResource WwbNoteBodyTextBoxStyle}"
                                    AcceptsReturn="True"
                                    IsEnabled="{x:Bind NoteEditor.CanEdit, Mode=OneWay}"
                                    Text="{x:Bind NoteEditor.Body, Mode=OneWay}"
                                    TextChanged="NoteBodyBox_TextChanged"
                                    TextWrapping="Wrap"
                                    VerticalContentAlignment="Top" />
                            </StackPanel>
                            <Border
                                x:Name="NoteMarkdownPreviewPanel"
                                x:Uid="NoteMarkdownPreviewPanel"
                                Style="{StaticResource WwbSecondarySurfaceStyle}"
                                Visibility="{Binding NoteEditor.IsMarkdownPreviewVisible, Converter={StaticResource EditModeVisibilityConverter}}">
                                <ListView
                                    x:Name="NoteMarkdownPreviewText"
                                    x:Uid="NoteMarkdownPreviewText"
                                    MaxHeight="180"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    IsItemClickEnabled="False"
                                    IsTabStop="False"
                                    ItemsSource="{x:Bind NoteEditor.MarkdownPreviewBlocks, Mode=OneWay}"
                                    ItemTemplateSelector="{StaticResource NoteMarkdownPreviewTemplateSelector}"
                                    Padding="0"
                                    SelectionMode="None" />
                            </Border>
                            <TextBlock
                                x:Name="NoteEditorStatusText"
                                Style="{StaticResource WwbCardCaptionStyle}"
                                Text="{x:Bind NoteStatusText, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox
                                    x:Name="MarkdownModeCheckBox"
                                    x:Uid="MarkdownModeCheckBox"
                                    Grid.Column="0"
                                    Style="{StaticResource WwbModeCheckBoxStyle}"
                                    IsChecked="{x:Bind NoteEditor.IsMarkdown, Mode=OneWay}"
                                    IsEnabled="{x:Bind NoteEditor.CanChangeMarkdownMode, Mode=OneWay}"
                                    Click="MarkdownModeCheckBox_Click" />
                                <Button
                                    x:Name="PreviewNoteButton"
                                    x:Uid="PreviewNoteButton"
                                    Grid.Column="1"
                                    Style="{StaticResource WwbCardActionButtonStyle}"
                                    IsEnabled="{x:Bind NoteEditor.CanPreviewMarkdown, Mode=OneWay}"
                                    Visibility="{Binding NoteEditor.IsMarkdownPreviewVisible, Converter={StaticResource InverseVisibilityConverter}}"
                                    Click="PreviewNoteButton_Click" />
                                <Button
                                    x:Name="EditMarkdownButton"
                                    x:Uid="EditMarkdownButton"
                                    Grid.Column="2"
                                    Style="{StaticResource WwbCardActionButtonStyle}"
                                    IsEnabled="{x:Bind NoteEditor.CanEdit, Mode=OneWay}"
                                    Visibility="{Binding NoteEditor.IsMarkdownPreviewVisible, Converter={StaticResource EditModeVisibilityConverter}}"
                                    Click="EditMarkdownButton_Click" />
                            </Grid>
                            <Grid
                                ColumnSpacing="8"
                                RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Button
                                    x:Name="NewNoteButton"
                                    x:Uid="NewNoteButton"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Style="{StaticResource WwbNoteActionButtonStyle}"
                                    IsEnabled="{x:Bind NoteEditor.CanLoadNote, Mode=OneWay}"
                                    Click="NewNoteButton_Click" />
                                <Button
                                    x:Name="DeleteCurrentNoteButton"
                                    x:Uid="DeleteCurrentNoteButton"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Style="{StaticResource WwbNoteActionButtonStyle}"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    IsEnabled="{x:Bind NoteEditor.CanDelete, Mode=OneWay}"
                                    Click="DeleteCurrentNoteButton_Click" />
                                <Button
                                    x:Name="OpenNotesButton"
                                    x:Uid="OpenNotesButton"
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    Style="{StaticResource WwbNoteActionButtonStyle}"
                                    IsEnabled="{x:Bind NoteEditor.CanEdit, Mode=OneWay}"
                                    Click="OpenNotesButton_Click" />
                                <Button
                                    x:Name="CopyNoteButton"
                                    x:Uid="CopyNoteButton"
                                    Grid.Row="0"
                                    Grid.Column="3"
                                    Style="{StaticResource WwbNoteActionButtonStyle}"
                                    IsEnabled="{x:Bind NoteEditor.CanEdit, Mode=OneWay}"
                                    Click="CopyNoteButton_Click" />
                                <Button
                                    x:Name="RetryNoteSaveButton"
                                    x:Uid="RetryNoteSaveButton"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Style="{StaticResource WwbNoteActionButtonStyle}"
                                    IsEnabled="{x:Bind NoteEditor.CanRetrySave, Mode=OneWay}"
                                    Click="RetryNoteSaveButton_Click" />
                                <Button
                                    x:Name="UndoNoteButton"
                                    x:Uid="UndoNoteButton"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Style="{StaticResource WwbNoteActionButtonStyle}"
                                    IsEnabled="{x:Bind NoteEditor.CanUndo, Mode=OneWay}"
                                    Click="UndoNoteButton_Click" />
                                <Button
                                    x:Name="RedoNoteButton"
                                    x:Uid="RedoNoteButton"
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    Style="{StaticResource WwbNoteActionButtonStyle}"
                                    IsEnabled="{x:Bind NoteEditor.CanRedo, Mode=OneWay}"
                                    Click="RedoNoteButton_Click" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                    <Border
                        Grid.Row="2"
                        HorizontalAlignment="Left"
                        Style="{StaticResource WwbEditToolbarSurfaceStyle}"
                        Visibility="{x:Bind IsEditing, Mode=OneWay}">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8">
                            <Border
                                Tag="{x:Bind InstanceId}"
                                Style="{StaticResource WwbDragHandleStyle}">
                                <TextBlock
                                    x:Name="NotesCardDragHandle"
                                    x:Uid="DragCardHandle"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <Button
                                x:Uid="DecreaseCardButton"
                                Style="{StaticResource WwbEditActionButtonStyle}"
                                Tag="{x:Bind InstanceId}"
                                Click="DecreaseCardSizeButton_Click" />
                            <Button
                                x:Uid="IncreaseCardButton"
                                Style="{StaticResource WwbEditActionButtonStyle}"
                                Tag="{x:Bind InstanceId}"
                                Click="IncreaseCardSizeButton_Click" />
                            <Button
                                x:Uid="RemoveCardButton"
                                Style="{StaticResource WwbDestructiveActionButtonStyle}"
                                Tag="{x:Bind InstanceId}"
                                Click="RemoveCardButton_Click" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate
            x:Key="WeatherCardTemplate"
            x:DataType="layout:CardSurfaceItem">
            <Border
                MinHeight="180"
                Style="{StaticResource WwbCardSurfaceStyle}"
                Padding="{StaticResource WwbCompactCardPadding}"
                RenderTransformOrigin="0.5,0.5"
                Tag="{x:Bind InstanceId}"
                PointerCaptureLost="DemoNotesCardSurface_PointerCaptureLost"
                PointerCanceled="DemoNotesCardSurface_PointerCanceled"
                PointerMoved="DemoNotesCardSurface_PointerMoved"
                PointerPressed="DemoNotesCardSurface_PointerPressed"
                PointerReleased="DemoNotesCardSurface_PointerReleased">
                <Border.RenderTransform>
                    <CompositeTransform />
                </Border.RenderTransform>
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel
                        Grid.Row="0"
                        Spacing="4">
                        <TextBlock
                            x:Uid="WeatherCardTitle"
                            Style="{StaticResource WwbCardTitleStyle}" />
                        <TextBlock
                            automation:AutomationProperties.AutomationId="WeatherLocationText"
                            Style="{StaticResource WwbCardBodyStyle}"
                            Text="{x:Bind WeatherLocationLabel, Mode=OneWay}" />
                        <ContentControl
                            x:Name="WeatherCardRuntimeStatus"
                            automation:AutomationProperties.Name="{x:Bind RuntimePresentation.AutomationSummary, Mode=OneWay}"
                            automation:AutomationProperties.HelpText="{x:Bind WeatherAutomationSummary, Mode=OneWay}"
                            Content="{x:Bind RuntimePresentation, Mode=OneWay}"
                            ContentTemplate="{StaticResource CardRuntimeStatusTemplate}"
                            IsTabStop="False"
                            Visibility="{Binding RuntimePresentation.IsStateVisible, Converter={StaticResource EditModeVisibilityConverter}}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Row="1"
                        Spacing="6"
                        Visibility="{Binding RuntimePresentation.IsContentVisible, Converter={StaticResource EditModeVisibilityConverter}}">
                        <TextBlock
                            automation:AutomationProperties.AutomationId="WeatherTemperatureText"
                            automation:AutomationProperties.Name="{x:Bind WeatherTemperatureText, Mode=OneWay}"
                            Style="{StaticResource WwbCardTitleStyle}"
                            Text="{x:Bind WeatherTemperatureText, Mode=OneWay}" />
                        <TextBlock
                            automation:AutomationProperties.Name="{x:Bind WeatherConditionText, Mode=OneWay}"
                            Style="{StaticResource WwbCardBodyStyle}"
                            Text="{x:Bind WeatherConditionText, Mode=OneWay}" />
                        <TextBlock
                            Style="{StaticResource WwbCardBodyStyle}"
                            Text="{x:Bind WeatherApparentTemperatureText, Mode=OneWay}" />
                        <TextBlock
                            Style="{StaticResource WwbCardBodyStyle}"
                            Text="{x:Bind WeatherHumidityText, Mode=OneWay}" />
                        <TextBlock
                            Style="{StaticResource WwbCardBodyStyle}"
                            Text="{x:Bind WeatherWindText, Mode=OneWay}" />
                        <TextBlock
                            Style="{StaticResource WwbCardBodyStyle}"
                            Text="{x:Bind WeatherObservedAtText, Mode=OneWay}" />
                    </StackPanel>
                    <HyperlinkButton
                        Grid.Row="2"
                        HorizontalAlignment="Left"
                        Content="{x:Bind WeatherAttributionText, Mode=OneWay}"
                        NavigateUri="https://open-meteo.com/"
                        Visibility="{Binding HasWeatherData, Converter={StaticResource EditModeVisibilityConverter}}" />
                    <Border
                        Grid.Row="3"
                        HorizontalAlignment="Left"
                        Padding="{StaticResource WwbCompactToolbarPadding}"
                        Style="{StaticResource WwbEditToolbarSurfaceStyle}"
                        Visibility="{x:Bind IsEditing, Mode=OneWay}">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8">
                            <Border
                                Tag="{x:Bind InstanceId}"
                                Style="{StaticResource WwbDragHandleStyle}">
                                <TextBlock
                                    x:Name="WeatherCardDragHandle"
                                    x:Uid="DragCardHandle"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <Button
                                x:Uid="DecreaseCardButton"
                                Style="{StaticResource WwbEditActionButtonStyle}"
                                Tag="{x:Bind InstanceId}"
                                Click="DecreaseCardSizeButton_Click" />
                            <Button
                                x:Uid="IncreaseCardButton"
                                Style="{StaticResource WwbEditActionButtonStyle}"
                                Tag="{x:Bind InstanceId}"
                                Click="IncreaseCardSizeButton_Click" />
                            <Button
                                x:Uid="RemoveCardButton"
                                Style="{StaticResource WwbDestructiveActionButtonStyle}"
                                Tag="{x:Bind InstanceId}"
                                Click="RemoveCardButton_Click" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate
            x:Key="TimerCardTemplate"
            x:DataType="layout:CardSurfaceItem">
            <Border
                MinHeight="180"
                Style="{StaticResource WwbCardSurfaceStyle}"
                Padding="{StaticResource WwbCompactCardPadding}"
                RenderTransformOrigin="0.5,0.5"
                Tag="{x:Bind InstanceId}"
                PointerCaptureLost="DemoNotesCardSurface_PointerCaptureLost"
                PointerCanceled="DemoNotesCardSurface_PointerCanceled"
                PointerMoved="DemoNotesCardSurface_PointerMoved"
                PointerPressed="DemoNotesCardSurface_PointerPressed"
                PointerReleased="DemoNotesCardSurface_PointerReleased">
                <Border.RenderTransform>
                    <CompositeTransform />
                </Border.RenderTransform>
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel
                        Grid.Row="0"
                        Spacing="8">
                        <TextBlock
                            x:Uid="TimerCardTitle"
                            Style="{StaticResource WwbCardTitleStyle}" />
                        <ContentControl
                            x:Name="TimerCardRuntimeStatus"
                            automation:AutomationProperties.Name="{x:Bind RuntimePresentation.AutomationSummary, Mode=OneWay}"
                            automation:AutomationProperties.HelpText="{x:Bind RuntimePresentation.Summary, Mode=OneWay}"
                            Content="{x:Bind RuntimePresentation, Mode=OneWay}"
                            ContentTemplate="{StaticResource CardRuntimeStatusTemplate}"
                            IsTabStop="False"
                            Visibility="{Binding RuntimePresentation.IsStateVisible, Converter={StaticResource EditModeVisibilityConverter}}" />
                    </StackPanel>
                    <TextBlock
                        x:Uid="TimerCardBody"
                        Grid.Row="1"
                        VerticalAlignment="Top"
                        Style="{StaticResource WwbCardBodyStyle}"
                        TextWrapping="Wrap"
                        Visibility="{Binding RuntimePresentation.IsContentVisible, Converter={StaticResource EditModeVisibilityConverter}}" />
                    <Border
                        Grid.Row="3"
                        HorizontalAlignment="Left"
                        Padding="{StaticResource WwbCompactToolbarPadding}"
                        Style="{StaticResource WwbEditToolbarSurfaceStyle}"
                        Visibility="{x:Bind IsEditing, Mode=OneWay}">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8">
                                <Border
                                    Tag="{x:Bind InstanceId}"
                                    Style="{StaticResource WwbDragHandleStyle}">
                                    <TextBlock
                                        x:Name="TimerCardDragHandle"
                                        x:Uid="DragCardHandle"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Border>
                                <Button
                                    x:Uid="DecreaseCardButton"
                                    Style="{StaticResource WwbEditActionButtonStyle}"
                                    Tag="{x:Bind InstanceId}"
                                    Click="DecreaseCardSizeButton_Click" />
                                <Button
                                    x:Uid="IncreaseCardButton"
                                    Style="{StaticResource WwbEditActionButtonStyle}"
                                    Tag="{x:Bind InstanceId}"
                                    Click="IncreaseCardSizeButton_Click" />
                                <Button
                                    x:Uid="RemoveCardButton"
                                    Style="{StaticResource WwbDestructiveActionButtonStyle}"
                                    Tag="{x:Bind InstanceId}"
                                    Click="RemoveCardButton_Click" />
                            </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate
            x:Key="TodoCardTemplate"
            x:DataType="layout:CardSurfaceItem">
            <Border
                MinHeight="180"
                Style="{StaticResource WwbCardSurfaceStyle}"
                Padding="{StaticResource WwbCompactCardPadding}"
                RenderTransformOrigin="0.5,0.5"
                Tag="{x:Bind InstanceId}"
                PointerCaptureLost="DemoNotesCardSurface_PointerCaptureLost"
                PointerCanceled="DemoNotesCardSurface_PointerCanceled"
                PointerMoved="DemoNotesCardSurface_PointerMoved"
                PointerPressed="DemoNotesCardSurface_PointerPressed"
                PointerReleased="DemoNotesCardSurface_PointerReleased">
                <Border.RenderTransform>
                    <CompositeTransform />
                </Border.RenderTransform>
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel
                        Grid.Row="0"
                        Spacing="8">
                        <TextBlock
                            x:Uid="TodoCardTitle"
                            Style="{StaticResource WwbCardTitleStyle}" />
                        <ContentControl
                            x:Name="TodoCardRuntimeStatus"
                            automation:AutomationProperties.Name="{x:Bind RuntimePresentation.AutomationSummary, Mode=OneWay}"
                            automation:AutomationProperties.HelpText="{x:Bind RuntimePresentation.Summary, Mode=OneWay}"
                            Content="{x:Bind RuntimePresentation, Mode=OneWay}"
                            ContentTemplate="{StaticResource CardRuntimeStatusTemplate}"
                            IsTabStop="False"
                            Visibility="{Binding RuntimePresentation.IsStateVisible, Converter={StaticResource EditModeVisibilityConverter}}" />
                    </StackPanel>
                    <TextBlock
                        x:Uid="TodoCardBody"
                        Grid.Row="1"
                        VerticalAlignment="Top"
                        Style="{StaticResource WwbCardBodyStyle}"
                        TextWrapping="Wrap"
                        Visibility="{Binding RuntimePresentation.IsContentVisible, Converter={StaticResource EditModeVisibilityConverter}}" />
                    <Border
                        Grid.Row="3"
                        HorizontalAlignment="Left"
                        Padding="{StaticResource WwbCompactToolbarPadding}"
                        Style="{StaticResource WwbEditToolbarSurfaceStyle}"
                        Visibility="{x:Bind IsEditing, Mode=OneWay}">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8">
                                <Border
                                    Tag="{x:Bind InstanceId}"
                                    Style="{StaticResource WwbDragHandleStyle}">
                                    <TextBlock
                                        x:Name="TodoCardDragHandle"
                                        x:Uid="DragCardHandle"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Border>
                                <Button
                                    x:Uid="DecreaseCardButton"
                                    Style="{StaticResource WwbEditActionButtonStyle}"
                                    Tag="{x:Bind InstanceId}"
                                    Click="DecreaseCardSizeButton_Click" />
                                <Button
                                    x:Uid="IncreaseCardButton"
                                    Style="{StaticResource WwbEditActionButtonStyle}"
                                    Tag="{x:Bind InstanceId}"
                                    Click="IncreaseCardSizeButton_Click" />
                                <Button
                                    x:Uid="RemoveCardButton"
                                    Style="{StaticResource WwbDestructiveActionButtonStyle}"
                                    Tag="{x:Bind InstanceId}"
                                    Click="RemoveCardButton_Click" />
                            </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate
            x:Key="CalendarCardTemplate"
            x:DataType="layout:CardSurfaceItem">
            <Border
                MinHeight="180"
                Style="{StaticResource WwbCardSurfaceStyle}"
                Padding="{StaticResource WwbCompactCardPadding}"
                RenderTransformOrigin="0.5,0.5"
                Tag="{x:Bind InstanceId}"
                PointerCaptureLost="DemoNotesCardSurface_PointerCaptureLost"
                PointerCanceled="DemoNotesCardSurface_PointerCanceled"
                PointerMoved="DemoNotesCardSurface_PointerMoved"
                PointerPressed="DemoNotesCardSurface_PointerPressed"
                PointerReleased="DemoNotesCardSurface_PointerReleased">
                <Border.RenderTransform>
                    <CompositeTransform />
                </Border.RenderTransform>
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel
                        Grid.Row="0"
                        Spacing="8">
                        <TextBlock
                            x:Uid="CalendarCardTitle"
                            Style="{StaticResource WwbCardTitleStyle}" />
                        <ContentControl
                            x:Name="CalendarCardRuntimeStatus"
                            automation:AutomationProperties.Name="{x:Bind RuntimePresentation.AutomationSummary, Mode=OneWay}"
                            automation:AutomationProperties.HelpText="{x:Bind RuntimePresentation.Summary, Mode=OneWay}"
                            Content="{x:Bind RuntimePresentation, Mode=OneWay}"
                            ContentTemplate="{StaticResource CardRuntimeStatusTemplate}"
                            IsTabStop="False"
                            Visibility="{Binding RuntimePresentation.IsStateVisible, Converter={StaticResource EditModeVisibilityConverter}}" />
                    </StackPanel>
                    <TextBlock
                        x:Uid="CalendarCardBody"
                        Grid.Row="1"
                        VerticalAlignment="Top"
                        Style="{StaticResource WwbCardBodyStyle}"
                        TextWrapping="Wrap"
                        Visibility="{Binding RuntimePresentation.IsContentVisible, Converter={StaticResource EditModeVisibilityConverter}}" />
                    <Border
                        Grid.Row="3"
                        HorizontalAlignment="Left"
                        Padding="{StaticResource WwbCompactToolbarPadding}"
                        Style="{StaticResource WwbEditToolbarSurfaceStyle}"
                        Visibility="{x:Bind IsEditing, Mode=OneWay}">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8">
                                <Border
                                    Tag="{x:Bind InstanceId}"
                                    Style="{StaticResource WwbDragHandleStyle}">
                                    <TextBlock
                                        x:Name="CalendarCardDragHandle"
                                        x:Uid="DragCardHandle"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Border>
                                <Button
                                    x:Uid="DecreaseCardButton"
                                    Style="{StaticResource WwbEditActionButtonStyle}"
                                    Tag="{x:Bind InstanceId}"
                                    Click="DecreaseCardSizeButton_Click" />
                                <Button
                                    x:Uid="IncreaseCardButton"
                                    Style="{StaticResource WwbEditActionButtonStyle}"
                                    Tag="{x:Bind InstanceId}"
                                    Click="IncreaseCardSizeButton_Click" />
                                <Button
                                    x:Uid="RemoveCardButton"
                                    Style="{StaticResource WwbDestructiveActionButtonStyle}"
                                    Tag="{x:Bind InstanceId}"
                                    Click="RemoveCardButton_Click" />
                            </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate
            x:Key="UnknownCardTemplate"
            x:DataType="layout:CardSurfaceItem">
            <Border
                MinHeight="180"
                Style="{StaticResource WwbCardSurfaceStyle}"
                Padding="{StaticResource WwbCompactCardPadding}"
                RenderTransformOrigin="0.5,0.5"
                Tag="{x:Bind InstanceId}"
                PointerCaptureLost="DemoNotesCardSurface_PointerCaptureLost"
                PointerCanceled="DemoNotesCardSurface_PointerCanceled"
                PointerMoved="DemoNotesCardSurface_PointerMoved"
                PointerPressed="DemoNotesCardSurface_PointerPressed"
                PointerReleased="DemoNotesCardSurface_PointerReleased">
                <Border.RenderTransform>
                    <CompositeTransform />
                </Border.RenderTransform>
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="8">
                        <TextBlock
                            x:Uid="UnknownCardTitle"
                            Style="{StaticResource WwbCardTitleStyle}" />
                        <ContentControl
                            x:Name="UnknownCardRuntimeStatus"
                            automation:AutomationProperties.Name="{x:Bind RuntimePresentation.AutomationSummary, Mode=OneWay}"
                            automation:AutomationProperties.HelpText="{x:Bind RuntimePresentation.Summary, Mode=OneWay}"
                            Content="{x:Bind RuntimePresentation, Mode=OneWay}"
                            ContentTemplate="{StaticResource CardRuntimeStatusTemplate}"
                            IsTabStop="False"
                            Visibility="{Binding RuntimePresentation.IsStateVisible, Converter={StaticResource EditModeVisibilityConverter}}" />
                        <TextBlock
                            x:Uid="UnknownCardBody"
                            Style="{StaticResource WwbCardBodyStyle}"
                            TextWrapping="Wrap"
                            Visibility="{Binding RuntimePresentation.IsContentVisible, Converter={StaticResource EditModeVisibilityConverter}}" />
                    </StackPanel>
                    <Border
                        Grid.Row="2"
                        HorizontalAlignment="Left"
                        Padding="{StaticResource WwbCompactToolbarPadding}"
                        Style="{StaticResource WwbEditToolbarSurfaceStyle}"
                        Visibility="{x:Bind IsEditing, Mode=OneWay}">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8">
                            <Border
                                Tag="{x:Bind InstanceId}"
                                Style="{StaticResource WwbDragHandleStyle}">
                                <TextBlock
                                    x:Name="UnknownCardDragHandle"
                                    x:Uid="DragCardHandle"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <Button
                                x:Uid="DecreaseCardButton"
                                Style="{StaticResource WwbEditActionButtonStyle}"
                                Tag="{x:Bind InstanceId}"
                                Click="DecreaseCardSizeButton_Click" />
                            <Button
                                x:Uid="IncreaseCardButton"
                                Style="{StaticResource WwbEditActionButtonStyle}"
                                Tag="{x:Bind InstanceId}"
                                Click="IncreaseCardSizeButton_Click" />
                            <Button
                                x:Uid="RemoveCardButton"
                                Style="{StaticResource WwbDestructiveActionButtonStyle}"
                                Tag="{x:Bind InstanceId}"
                                Click="RemoveCardButton_Click" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <layout:CardSurfaceTemplateSelector
            x:Key="CardTemplateSelector"
            NotesTemplate="{StaticResource NotesCardTemplate}"
            WeatherTemplate="{StaticResource WeatherCardTemplate}"
            TimerTemplate="{StaticResource TimerCardTemplate}"
            TodoTemplate="{StaticResource TodoCardTemplate}"
            CalendarTemplate="{StaticResource CalendarCardTemplate}"
            DefaultTemplate="{StaticResource UnknownCardTemplate}" />
        </Grid.Resources>
        <Grid
            x:Name="RootGrid"
            Style="{StaticResource WwbPanelRootStyle}"
            IsTabStop="True"
            KeyDown="RootGrid_KeyDown"
            RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <CompositeTransform x:Name="PanelMotionTransform" />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                x:Name="HeaderBar"
                Grid.Row="0"
                Style="{StaticResource WwbHeaderSurfaceStyle}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel
                        Grid.Row="0"
                        Spacing="2">
                        <TextBlock
                            x:Name="GreetingText"
                            x:Uid="GreetingText"
                            Style="{StaticResource WwbPanelTitleStyle}"
                            TextWrapping="Wrap"
                            automation:AutomationProperties.HeadingLevel="Level1" />
                        <TextBlock
                            x:Name="DateText"
                            Style="{StaticResource WwbPanelMetaStyle}" />
                        <TextBlock
                            x:Name="ContextText"
                            Style="{StaticResource WwbPanelContextStyle}" />
                    </StackPanel>

                    <Grid
                        x:Name="HeaderCommandBar"
                        Grid.Row="1"
                        ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="SearchBox"
                            x:Uid="SearchBox"
                            MinWidth="180"
                            Style="{StaticResource WwbSearchBoxStyle}"
                            IsEnabled="{x:Bind NoteSearch.CanSearch, Mode=OneWay}"
                            TextChanged="SearchBox_TextChanged" />
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                            <Button
                                x:Name="ListNotesButton"
                                x:Uid="ListNotesButton"
                                Style="{StaticResource WwbToolbarButtonStyle}"
                                IsEnabled="{x:Bind NoteSearch.CanSearch, Mode=OneWay}"
                                Click="ListNotesButton_Click" />
                            <Button
                                x:Name="AddCardButton"
                                x:Uid="AddCardButton"
                                Style="{StaticResource WwbToolbarButtonStyle}"
                                Click="ShellCommandButton_Click" />
                            <Button
                                x:Name="EditLayoutButton"
                                x:Uid="EditLayoutButton"
                                Style="{StaticResource WwbPrimaryToolbarButtonStyle}"
                                Click="EditLayoutButton_Click" />
                            <Button
                                x:Name="UndoLayoutButton"
                                x:Uid="UndoLayoutButton"
                                Style="{StaticResource WwbToolbarButtonStyle}"
                                Visibility="Collapsed"
                                Click="UndoLayoutButton_Click" />
                            <Button
                                x:Name="RedoLayoutButton"
                                x:Uid="RedoLayoutButton"
                                Style="{StaticResource WwbToolbarButtonStyle}"
                                Visibility="Collapsed"
                                Click="RedoLayoutButton_Click" />
                            <Button
                                x:Name="SettingsButton"
                                x:Uid="SettingsButton"
                                Style="{StaticResource WwbToolbarButtonStyle}"
                                Click="SettingsButton_Click" />
                            <Button
                                x:Name="ClosePanelButton"
                                x:Uid="ClosePanelButton"
                                Style="{StaticResource WwbToolbarButtonStyle}"
                                Click="ClosePanelButton_Click" />
                        </StackPanel>
                    </Grid>

                    <Border
                        x:Name="NoteSearchResultsBorder"
                        Grid.Row="2"
                        Style="{StaticResource WwbSecondarySurfaceStyle}"
                        Visibility="Collapsed">
                        <ListView
                            x:Name="NoteSearchResultsList"
                            x:Uid="NoteSearchResultsList"
                            ItemsSource="{x:Bind NoteSearch.Results, Mode=OneWay}"
                            IsEnabled="{x:Bind NoteEditor.CanLoadNote, Mode=OneWay}"
                            IsItemClickEnabled="False"
                            MaxHeight="224"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="notes:NoteSearchResult">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            Grid.Column="0"
                                            Tag="{x:Bind NoteId}"
                                            Style="{StaticResource WwbSearchResultButtonStyle}"
                                            Click="NoteSearchResultButton_Click"
                                            automation:AutomationProperties.Name="{x:Bind Title}">
                                            <StackPanel
                                                Padding="4"
                                                Spacing="2">
                                                <TextBlock
                                                    Text="{x:Bind Title}"
                                                    TextTrimming="CharacterEllipsis"
                                                    Style="{StaticResource WwbSearchResultTitleStyle}" />
                                                <TextBlock
                                                    Text="{x:Bind Preview}"
                                                    TextWrapping="Wrap"
                                                    Style="{StaticResource WwbSearchResultPreviewStyle}" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Grid.Column="1"
                                            x:Uid="DeleteNoteButton"
                                            Style="{StaticResource WwbDestructiveActionButtonStyle}"
                                            Click="DeleteNoteButton_Click" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer
                x:Name="ContentScrollViewer"
                Grid.Row="1"
                Padding="{StaticResource WwbContentPadding}"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="16">
                    <Border Style="{StaticResource WwbStatusSurfaceStyle}">
                        <TextBlock
                            x:Name="StatusText"
                            x:Uid="StatusText"
                            Style="{StaticResource WwbCardBodyStyle}"
                            TextWrapping="Wrap" />
                    </Border>

                    <Grid
                        x:Name="CardGridHost"
                        x:Uid="CardGridHost"
                        SizeChanged="CardGridHost_SizeChanged">
                        <controls:ItemsRepeater
                            x:Name="CardItemsRepeater"
                            ElementPrepared="CardItemsRepeater_ElementPrepared"
                            ElementClearing="CardItemsRepeater_ElementClearing"
                            ItemTemplate="{StaticResource CardTemplateSelector}" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
