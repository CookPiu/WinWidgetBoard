                MinHeight="160"
                Style="{StaticResource WwbCardSurfaceStyle}"
                Padding="{StaticResource WwbCompactCardPadding}"
                RenderTransformOrigin="0.5,0.5"
                Tag="{x:Bind InstanceId}"
                PointerCaptureLost="DemoNotesCardSurface_PointerCaptureLost"
                PointerCanceled="DemoNotesCardSurface_PointerCanceled"
                PointerMoved="DemoNotesCardSurface_PointerMoved"
                PointerPressed="DemoNotesCardSurface_PointerPressed"
                PointerReleased="DemoNotesCardSurface_PointerReleased">
                <Border.RenderTransform>
                    <CompositeTransform />
                </Border.RenderTransform>
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Uid="TokenUsageCardTitle"
                            Style="{StaticResource WwbCardTitleStyle}" />
                        <Button
                            x:Uid="TokenUsageSettingsButton"
                            Grid.Column="1"
                            Style="{StaticResource WwbCardIconButtonStyle}"
                            Click="TokenUsageSettingsButton_Click"
                            automation:AutomationProperties.AutomationId="TokenUsageSettingsButton">
                            <FontIcon FontSize="14" Glyph="&#xE713;" />
                        </Button>
                    </Grid>
                    <Grid Grid.Row="1">
                        <ContentControl
                            automation:AutomationProperties.Name="{x:Bind RuntimePresentation.AutomationSummary, Mode=OneWay}"
                            Content="{x:Bind RuntimePresentation, Mode=OneWay}"
                            ContentTemplate="{StaticResource CardRuntimeStatusTemplate}"
                            IsTabStop="False"
                            Visibility="{x:Bind RuntimePresentation.IsStateVisible, Mode=OneWay}" />
                        <!--
                            Two columns, but the second one is only used at four-column card
                            widths. A card is a fixed number of grid rows tall and clips what
                            does not fit, so on a wide card the breakdown and quota move
                            beside the readings rather than under them - height is the axis
                            that is short, and stacking into the extra width would waste it.
                        -->
                        <Grid
                            VerticalAlignment="Top"
                            ColumnSpacing="12"
                            Visibility="{x:Bind RuntimePresentation.IsContentVisible, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <!--
                                    Auto, so at narrow sizes - where the side block sits in
                                    the second row of the first column instead - this column
                                    holds nothing and takes no width.
                                -->
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Spacing="6">
                                <ItemsControl
                                    ItemsSource="{x:Bind TokenUsagePages}"
                                    ItemTemplate="{StaticResource TokenUsagePageTabTemplate}"
                                    IsTabStop="False"
                                    automation:AutomationProperties.AutomationId="TokenUsagePageTabs"
                                    Visibility="{x:Bind IsTokenUsagePageSwitcherVisible, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <ItemsControl
                                    ItemsSource="{x:Bind TokenUsageMetrics}"
                                    ItemTemplate="{StaticResource TokenUsageMetricTemplate}"
                                    IsTabStop="False"
                                    automation:AutomationProperties.AutomationId="TokenUsageMetricList" />
                                <ItemsControl
                                    ItemsSource="{x:Bind TokenUsageTrend}"
                                    ItemTemplate="{StaticResource TokenUsageTrendBarTemplate}"
                                    IsTabStop="False"
                                    x:Uid="TokenUsageTrendStrip"
                                    automation:AutomationProperties.AutomationId="TokenUsageTrendStrip"
                                    Visibility="{x:Bind IsTokenUsageTrendVisible, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel
                                Grid.Column="{x:Bind TokenUsageSideColumn, Mode=OneWay}"
                                Grid.Row="{x:Bind TokenUsageSideRow, Mode=OneWay}"
                                Spacing="6">
                                <ItemsControl
                                    ItemsSource="{x:Bind TokenUsageBreakdown}"
                                    ItemTemplate="{StaticResource TokenUsageBreakdownTemplate}"
                                    IsTabStop="False"
                                    automation:AutomationProperties.AutomationId="TokenUsageBreakdownList"
                                    Visibility="{x:Bind IsTokenUsageBreakdownVisible, Mode=OneWay}" />
                                <!--
                                    Header, balance and observation time share one line. They
                                    were three, which cost eighteen DIP the card does not have:
                                    at L the quota block ran past the bottom edge and the
                                    balance was drawn off the card entirely.
                                -->
                                <StackPanel
                                    Spacing="2"
                                    Visibility="{x:Bind IsTokenUsageQuotaVisible, Mode=OneWay}">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            x:Uid="TokenUsageQuotaHeader"
                                            Style="{StaticResource WwbCardCaptionStyle}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Style="{StaticResource WwbCardCaptionStyle}"
                                            Text="{x:Bind TokenUsageCreditsText, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis"
                                            Visibility="{x:Bind IsTokenUsageCreditsVisible, Mode=OneWay}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Style="{StaticResource WwbCardCaptionStyle}"
                                            Text="{x:Bind TokenUsageQuotaObservedText, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                    <ItemsControl
                                        ItemsSource="{x:Bind TokenUsageQuota}"
                                        ItemTemplate="{StaticResource TokenUsageQuotaTemplate}"
                                        IsTabStop="False"
                                        automation:AutomationProperties.AutomationId="TokenUsageQuotaList" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <Border
                        Grid.Row="2"
                        HorizontalAlignment="Left"
                        Padding="{StaticResource WwbCompactToolbarPadding}"
                        Style="{StaticResource WwbEditToolbarSurfaceStyle}"
                        Visibility="{x:Bind IsEditing, Mode=OneWay}">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8">
                            <Border
                                Tag="{x:Bind InstanceId}"
                                Style="{StaticResource WwbDragHandleStyle}">
                                <TextBlock
                                    x:Name="TokenUsageCardDragHandle"
                                    x:Uid="DragCardHandle"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <Button
                                x:Uid="DecreaseCardButton"
                                automation:AutomationProperties.AutomationId="TokenUsageCardDecreaseButton"
                                Style="{StaticResource WwbEditActionButtonStyle}"
                                Tag="{x:Bind InstanceId}"
                                Click="DecreaseCardSizeButton_Click" />
                            <Button
                                x:Uid="IncreaseCardButton"
                                automation:AutomationProperties.AutomationId="TokenUsageCardIncreaseButton"
                                Style="{StaticResource WwbEditActionButtonStyle}"
                                Tag="{x:Bind InstanceId}"
                                Click="IncreaseCardSizeButton_Click" />
                            <Button
                                x:Uid="RemoveCardButton"
                                automation:AutomationProperties.AutomationId="TokenUsageCardRemoveButton"
                                Style="{StaticResource WwbDestructiveActionButtonStyle}"
                                Tag="{x:Bind InstanceId}"
                                Click="RemoveCardButton_Click" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <layout:CardSurfaceTemplateSelector
            x:Key="CardTemplateSelector"
            NotesTemplate="{StaticResource NotesCardTemplate}"
            WeatherTemplate="{StaticResource WeatherCardTemplate}"
            TimerTemplate="{StaticResource TimerCardTemplate}"
            TodoTemplate="{StaticResource TodoCardTemplate}"
            CalendarTemplate="{StaticResource CalendarCardTemplate}"
            SystemMonitorTemplate="{StaticResource SystemMonitorCardTemplate}"
            TokenUsageTemplate="{StaticResource TokenUsageCardTemplate}"
            DefaultTemplate="{StaticResource UnknownCardTemplate}" />
        </Grid.Resources>
        <Border
            Background="{ThemeResource WwbPanelAccentWashBrush}"
            IsHitTestVisible="False" />
        <Grid
            x:Name="RootGrid"
            Style="{StaticResource WwbPanelRootStyle}"
            IsTabStop="True"
            KeyDown="RootGrid_KeyDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                x:Name="HeaderBar"
                Grid.Row="0"
                Style="{StaticResource WwbHeaderSurfaceStyle}">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid
                        x:Name="HeaderCommandBar"
                        Grid.Row="0"
                        ColumnSpacing="8">
                        <!--
                            Two columns now. The middle one existed only to hold the note
                            search box, which moved to the card that owns notes.
                        -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Grid.Column="0"
                            MaxWidth="220"
                            Spacing="0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8">
                                <TextBlock
                                    x:Name="GreetingText"
                                    x:Uid="GreetingText"
                                    Style="{StaticResource WwbPanelTitleStyle}"
                                    TextWrapping="NoWrap"
                                    automation:AutomationProperties.HeadingLevel="Level1" />
                                <TextBlock
                                    x:Name="DateText"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource WwbPanelMetaStyle}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock
                                x:Name="ContextText"
                                Style="{StaticResource WwbPanelContextStyle}"
                                Visibility="Collapsed" />
                            <Border
                                MaxWidth="220"
                                HorizontalAlignment="Left"
                                Style="{StaticResource WwbStatusSurfaceStyle}">
                                <TextBlock
                                    x:Name="StatusText"
                                    x:Uid="StatusText"
                                    MaxLines="1"
                                    Style="{StaticResource WwbPanelContextStyle}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </Border>
                        </StackPanel>

                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="2"
                            VerticalAlignment="Center">
                            <Button
                                x:Name="EditLayoutButton"
                                x:Uid="EditLayoutButton"
                                Style="{StaticResource WwbToolbarButtonStyle}"
                                Click="EditLayoutButton_Click" />
                            <Button
                                x:Name="AddCardButton"
                                x:Uid="AddCardButton"
                                Style="{StaticResource WwbToolbarButtonStyle}"
                                Visibility="Collapsed"
                                Click="AddCardButton_Click" />
                            <Button
                                x:Name="UndoLayoutButton"
                                x:Uid="UndoLayoutButton"
                                Style="{StaticResource WwbToolbarButtonStyle}"
                                Visibility="Collapsed"
                                Click="UndoLayoutButton_Click" />
                            <Button
                                x:Name="RedoLayoutButton"
                                x:Uid="RedoLayoutButton"
                                Style="{StaticResource WwbToolbarButtonStyle}"
                                Visibility="Collapsed"
                                Click="RedoLayoutButton_Click" />
                            <Button
                                x:Name="SettingsButton"
                                x:Uid="SettingsButton"
                                Style="{StaticResource WwbToolbarButtonStyle}"
                                Click="SettingsButton_Click" />
                            <Button
                                x:Name="ClosePanelButton"
                                x:Uid="ClosePanelButton"
                                Style="{StaticResource WwbToolbarButtonStyle}"
                                Click="ClosePanelButton_Click" />
                        </StackPanel>
                    </Grid>

                </Grid>
            </Border>

            <ScrollViewer
                x:Name="ContentScrollViewer"
                Grid.Row="1"
                Padding="{StaticResource WwbContentPadding}"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Top"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
                <Grid
                    x:Name="CardGridHost"
                    x:Uid="CardGridHost"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    SizeChanged="CardGridHost_SizeChanged">
                    <controls:ItemsRepeater
                        x:Name="CardItemsRepeater"
                        ElementPrepared="CardItemsRepeater_ElementPrepared"
                        ElementClearing="CardItemsRepeater_ElementClearing"
                        ItemTemplate="{StaticResource CardTemplateSelector}" />
                </Grid>
            </ScrollViewer>

        </Grid>
    </Grid>
</Window>
