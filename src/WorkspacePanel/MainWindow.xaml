                        <TextBlock
                            x:Uid="TodoCardTitle"
                            Style="{StaticResource WwbCardTitleStyle}" />
                        <ContentControl
                            x:Name="TodoCardRuntimeStatus"
                            automation:AutomationProperties.Name="{x:Bind RuntimePresentation.AutomationSummary, Mode=OneWay}"
                            automation:AutomationProperties.HelpText="{x:Bind RuntimePresentation.Summary, Mode=OneWay}"
                            Content="{x:Bind RuntimePresentation, Mode=OneWay}"
                            ContentTemplate="{StaticResource CardRuntimeStatusTemplate}"
                            IsTabStop="False"
                            Visibility="{x:Bind RuntimePresentation.IsStateVisible, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock
                        x:Uid="TodoCardBody"
                        Grid.Row="1"
                        VerticalAlignment="Top"
                        Style="{StaticResource WwbCardBodyStyle}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind RuntimePresentation.IsContentVisible, Mode=OneWay}" />
                    <Border
                        Grid.Row="3"
                        HorizontalAlignment="Left"
                        Padding="{StaticResource WwbCompactToolbarPadding}"
                        Style="{StaticResource WwbEditToolbarSurfaceStyle}"
                        Visibility="{x:Bind IsEditing, Mode=OneWay}">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8">
                                <Border
                                    Tag="{x:Bind InstanceId}"
                                    Style="{StaticResource WwbDragHandleStyle}">
                                    <TextBlock
                                        x:Name="TodoCardDragHandle"
                                        x:Uid="DragCardHandle"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Border>
                                <Button
                                    x:Uid="DecreaseCardButton"
                                    Style="{StaticResource WwbEditActionButtonStyle}"
                                    Tag="{x:Bind InstanceId}"
                                    Click="DecreaseCardSizeButton_Click" />
                                <Button
                                    x:Uid="IncreaseCardButton"
                                    Style="{StaticResource WwbEditActionButtonStyle}"
                                    Tag="{x:Bind InstanceId}"
                                    Click="IncreaseCardSizeButton_Click" />
                                <Button
                                    x:Uid="RemoveCardButton"
                                    automation:AutomationProperties.AutomationId="TodoCardRemoveButton"
                                    Style="{StaticResource WwbDestructiveActionButtonStyle}"
                                    Tag="{x:Bind InstanceId}"
                                    Click="RemoveCardButton_Click" />
                            </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate
            x:Key="CalendarCardTemplate"
            x:DataType="layout:CardSurfaceItem">
            <Border
                MinHeight="160"
                Style="{StaticResource WwbCardSurfaceStyle}"
                Padding="{StaticResource WwbCompactCardPadding}"
                RenderTransformOrigin="0.5,0.5"
                Tag="{x:Bind InstanceId}"
                PointerCaptureLost="DemoNotesCardSurface_PointerCaptureLost"
                PointerCanceled="DemoNotesCardSurface_PointerCanceled"
                PointerMoved="DemoNotesCardSurface_PointerMoved"
                PointerPressed="DemoNotesCardSurface_PointerPressed"
                PointerReleased="DemoNotesCardSurface_PointerReleased">
                <Border.RenderTransform>
                    <CompositeTransform />
                </Border.RenderTransform>
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel
                        Grid.Row="0"
                        Spacing="8">
                        <TextBlock
                            x:Uid="CalendarCardTitle"
                            Style="{StaticResource WwbCardTitleStyle}" />
                        <ContentControl
                            x:Name="CalendarCardRuntimeStatus"
                            automation:AutomationProperties.Name="{x:Bind RuntimePresentation.AutomationSummary, Mode=OneWay}"
                            automation:AutomationProperties.HelpText="{x:Bind RuntimePresentation.Summary, Mode=OneWay}"
                            Content="{x:Bind RuntimePresentation, Mode=OneWay}"
                            ContentTemplate="{StaticResource CardRuntimeStatusTemplate}"
                            IsTabStop="False"
                            Visibility="{x:Bind RuntimePresentation.IsStateVisible, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock
                        x:Uid="CalendarCardBody"
                        Grid.Row="1"
                        VerticalAlignment="Top"
                        Style="{StaticResource WwbCardBodyStyle}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind RuntimePresentation.IsContentVisible, Mode=OneWay}" />
                    <Border
                        Grid.Row="3"
                        HorizontalAlignment="Left"
                        Padding="{StaticResource WwbCompactToolbarPadding}"
                        Style="{StaticResource WwbEditToolbarSurfaceStyle}"
                        Visibility="{x:Bind IsEditing, Mode=OneWay}">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8">
                                <Border
                                    Tag="{x:Bind InstanceId}"
                                    Style="{StaticResource WwbDragHandleStyle}">
                                    <TextBlock
                                        x:Name="CalendarCardDragHandle"
                                        x:Uid="DragCardHandle"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Border>
                                <Button
                                    x:Uid="DecreaseCardButton"
                                    Style="{StaticResource WwbEditActionButtonStyle}"
                                    Tag="{x:Bind InstanceId}"
                                    Click="DecreaseCardSizeButton_Click" />
                                <Button
                                    x:Uid="IncreaseCardButton"
                                    Style="{StaticResource WwbEditActionButtonStyle}"
                                    Tag="{x:Bind InstanceId}"
                                    Click="IncreaseCardSizeButton_Click" />
                                <Button
                                    x:Uid="RemoveCardButton"
                                    automation:AutomationProperties.AutomationId="CalendarCardRemoveButton"
                                    Style="{StaticResource WwbDestructiveActionButtonStyle}"
                                    Tag="{x:Bind InstanceId}"
                                    Click="RemoveCardButton_Click" />
                            </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate
            x:Key="UnknownCardTemplate"
            x:DataType="layout:CardSurfaceItem">
            <Border
                MinHeight="160"
                Style="{StaticResource WwbCardSurfaceStyle}"
                Padding="{StaticResource WwbCompactCardPadding}"
                RenderTransformOrigin="0.5,0.5"
                Tag="{x:Bind InstanceId}"
                PointerCaptureLost="DemoNotesCardSurface_PointerCaptureLost"
                PointerCanceled="DemoNotesCardSurface_PointerCanceled"
                PointerMoved="DemoNotesCardSurface_PointerMoved"
                PointerPressed="DemoNotesCardSurface_PointerPressed"
                PointerReleased="DemoNotesCardSurface_PointerReleased">
                <Border.RenderTransform>
                    <CompositeTransform />
                </Border.RenderTransform>
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="8">
                        <TextBlock
                            x:Uid="UnknownCardTitle"
                            Style="{StaticResource WwbCardTitleStyle}" />
                        <ContentControl
                            x:Name="UnknownCardRuntimeStatus"
                            automation:AutomationProperties.Name="{x:Bind RuntimePresentation.AutomationSummary, Mode=OneWay}"
                            automation:AutomationProperties.HelpText="{x:Bind RuntimePresentation.Summary, Mode=OneWay}"
                            Content="{x:Bind RuntimePresentation, Mode=OneWay}"
                            ContentTemplate="{StaticResource CardRuntimeStatusTemplate}"
                            IsTabStop="False"
                            Visibility="{x:Bind RuntimePresentation.IsStateVisible, Mode=OneWay}" />
                        <TextBlock
                            x:Uid="UnknownCardBody"
                            Style="{StaticResource WwbCardBodyStyle}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind RuntimePresentation.IsContentVisible, Mode=OneWay}" />
                    </StackPanel>
                    <Border
                        Grid.Row="2"
                        HorizontalAlignment="Left"
                        Padding="{StaticResource WwbCompactToolbarPadding}"
                        Style="{StaticResource WwbEditToolbarSurfaceStyle}"
                        Visibility="{x:Bind IsEditing, Mode=OneWay}">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8">
                            <Border
                                Tag="{x:Bind InstanceId}"
                                Style="{StaticResource WwbDragHandleStyle}">
                                <TextBlock
                                    x:Name="UnknownCardDragHandle"
                                    x:Uid="DragCardHandle"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <Button
                                x:Uid="DecreaseCardButton"
                                Style="{StaticResource WwbEditActionButtonStyle}"
                                Tag="{x:Bind InstanceId}"
                                Click="DecreaseCardSizeButton_Click" />
                            <Button
                                x:Uid="IncreaseCardButton"
                                Style="{StaticResource WwbEditActionButtonStyle}"
                                Tag="{x:Bind InstanceId}"
                                Click="IncreaseCardSizeButton_Click" />
                            <Button
                                x:Uid="RemoveCardButton"
                                automation:AutomationProperties.AutomationId="UnknownCardRemoveButton"
                                Style="{StaticResource WwbDestructiveActionButtonStyle}"
                                Tag="{x:Bind InstanceId}"
                                Click="RemoveCardButton_Click" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!--
            One metric row. The meter is decoration over a number the row already states, so it
            carries no automation name of its own; the row's name has the name and the value.
            A metric with no ceiling - a network rate - shows no meter at all rather than a bar
            drawn against an invented maximum.
        -->
        <DataTemplate
            x:Key="SystemMonitorMetricTemplate"
            x:DataType="runtime:SystemMonitorMetricViewModel">
            <Grid
                Padding="0,3"
                RowSpacing="3"
                automation:AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Style="{StaticResource WwbCardCaptionStyle}"
                        Text="{x:Bind Name, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Grid.Column="1"
                        Style="{StaticResource WwbCardBodyStyle}"
                        Text="{x:Bind PrimaryText, Mode=OneWay}"
                        Visibility="{x:Bind HasReading, Mode=OneWay}" />
                    <TextBlock
                        Grid.Column="1"
                        Style="{StaticResource WwbCardCaptionStyle}"
                        Text="{x:Bind MetricStatusText, Mode=OneWay}"
                        Visibility="{x:Bind IsMetricStatusTextVisible, Mode=OneWay}" />
                </Grid>
                <ProgressBar
                    Grid.Row="1"
                    Height="4"
                    Minimum="0"
                    Maximum="100"
                    Value="{x:Bind MeterPercent, Mode=OneWay}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    IsTabStop="False"
                    automation:AutomationProperties.AccessibilityView="Raw"
                    Visibility="{x:Bind IsMeterVisible, Mode=OneWay}" />
                <TextBlock
                    Grid.Row="2"
                    Style="{StaticResource WwbCardCaptionStyle}"
                    Text="{x:Bind SecondaryText, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{x:Bind IsSecondaryVisible, Mode=OneWay}" />
            </Grid>
        </DataTemplate>

        <DataTemplate
            x:Key="SystemMonitorCardTemplate"
            x:DataType="layout:CardSurfaceItem">
            <Border
                MinHeight="160"
                Style="{StaticResource WwbCardSurfaceStyle}"
                Padding="{StaticResource WwbCompactCardPadding}"
                RenderTransformOrigin="0.5,0.5"
                Tag="{x:Bind InstanceId}"
                PointerCaptureLost="DemoNotesCardSurface_PointerCaptureLost"
                PointerCanceled="DemoNotesCardSurface_PointerCanceled"
                PointerMoved="DemoNotesCardSurface_PointerMoved"
                PointerPressed="DemoNotesCardSurface_PointerPressed"
                PointerReleased="DemoNotesCardSurface_PointerReleased">
                <Border.RenderTransform>
                    <CompositeTransform />
                </Border.RenderTransform>
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Uid="SystemMonitorCardTitle"
                            Style="{StaticResource WwbCardTitleStyle}" />
                        <Button
                            x:Uid="SysMonSettingsButton"
                            Grid.Column="1"
                            Style="{StaticResource WwbCardIconButtonStyle}"
                            Click="SysMonSettingsButton_Click"
                            automation:AutomationProperties.AutomationId="SysMonSettingsButton">
                            <FontIcon FontSize="14" Glyph="&#xE713;" />
                        </Button>
                    </Grid>
                    <Grid Grid.Row="1">
                        <ContentControl
                            automation:AutomationProperties.Name="{x:Bind RuntimePresentation.AutomationSummary, Mode=OneWay}"
                            Content="{x:Bind RuntimePresentation, Mode=OneWay}"
                            ContentTemplate="{StaticResource CardRuntimeStatusTemplate}"
                            IsTabStop="False"
                            Visibility="{x:Bind RuntimePresentation.IsStateVisible, Mode=OneWay}" />
                        <ItemsControl
                            VerticalAlignment="Top"
                            ItemsSource="{x:Bind SystemMonitorMetrics}"
                            ItemTemplate="{StaticResource SystemMonitorMetricTemplate}"
                            IsTabStop="False"
                            automation:AutomationProperties.AutomationId="SystemMonitorMetricList"
                            Visibility="{x:Bind RuntimePresentation.IsContentVisible, Mode=OneWay}" />
                    </Grid>
                    <Border
                        Grid.Row="2"
                        HorizontalAlignment="Left"
                        Padding="{StaticResource WwbCompactToolbarPadding}"
                        Style="{StaticResource WwbEditToolbarSurfaceStyle}"
                        Visibility="{x:Bind IsEditing, Mode=OneWay}">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8">
                            <Border
                                Tag="{x:Bind InstanceId}"
                                Style="{StaticResource WwbDragHandleStyle}">
                                <TextBlock
                                    x:Name="SystemMonitorCardDragHandle"
                                    x:Uid="DragCardHandle"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <Button
                                x:Uid="DecreaseCardButton"
                                Style="{StaticResource WwbEditActionButtonStyle}"
                                Tag="{x:Bind InstanceId}"
                                Click="DecreaseCardSizeButton_Click" />
                            <Button
                                x:Uid="IncreaseCardButton"
                                Style="{StaticResource WwbEditActionButtonStyle}"
                                Tag="{x:Bind InstanceId}"
                                Click="IncreaseCardSizeButton_Click" />
                            <Button
                                x:Uid="RemoveCardButton"
                                automation:AutomationProperties.AutomationId="SystemMonitorCardRemoveButton"
                                Style="{StaticResource WwbDestructiveActionButtonStyle}"
                                Tag="{x:Bind InstanceId}"
                                Click="RemoveCardButton_Click" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <layout:CardSurfaceTemplateSelector
            x:Key="CardTemplateSelector"
            NotesTemplate="{StaticResource NotesCardTemplate}"
            WeatherTemplate="{StaticResource WeatherCardTemplate}"
            TimerTemplate="{StaticResource TimerCardTemplate}"
            TodoTemplate="{StaticResource TodoCardTemplate}"
            CalendarTemplate="{StaticResource CalendarCardTemplate}"
            SystemMonitorTemplate="{StaticResource SystemMonitorCardTemplate}"
            DefaultTemplate="{StaticResource UnknownCardTemplate}" />
        </Grid.Resources>
        <Border
            Background="{ThemeResource WwbPanelAccentWashBrush}"
            IsHitTestVisible="False" />
        <Grid
            x:Name="RootGrid"
            Style="{StaticResource WwbPanelRootStyle}"
            IsTabStop="True"
            KeyDown="RootGrid_KeyDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                x:Name="HeaderBar"
                Grid.Row="0"
                Style="{StaticResource WwbHeaderSurfaceStyle}">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid
                        x:Name="HeaderCommandBar"
                        Grid.Row="0"
                        ColumnSpacing="8">
                        <!--
                            Two columns now. The middle one existed only to hold the note
                            search box, which moved to the card that owns notes.
                        -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Grid.Column="0"
                            MaxWidth="220"
                            Spacing="0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8">
                                <TextBlock
                                    x:Name="GreetingText"
                                    x:Uid="GreetingText"
                                    Style="{StaticResource WwbPanelTitleStyle}"
                                    TextWrapping="NoWrap"
                                    automation:AutomationProperties.HeadingLevel="Level1" />
                                <TextBlock
                                    x:Name="DateText"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource WwbPanelMetaStyle}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock
                                x:Name="ContextText"
                                Style="{StaticResource WwbPanelContextStyle}"
                                Visibility="Collapsed" />
                            <Border
                                MaxWidth="220"
                                HorizontalAlignment="Left"
                                Style="{StaticResource WwbStatusSurfaceStyle}">
                                <TextBlock
                                    x:Name="StatusText"
                                    x:Uid="StatusText"
                                    MaxLines="1"
                                    Style="{StaticResource WwbPanelContextStyle}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </Border>
                        </StackPanel>

                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="2"
                            VerticalAlignment="Center">
                            <Button
                                x:Name="EditLayoutButton"
                                x:Uid="EditLayoutButton"
                                Style="{StaticResource WwbToolbarButtonStyle}"
                                Click="EditLayoutButton_Click" />
                            <Button
                                x:Name="AddCardButton"
                                x:Uid="AddCardButton"
                                Style="{StaticResource WwbToolbarButtonStyle}"
                                Visibility="Collapsed"
                                Click="AddCardButton_Click" />
                            <Button
                                x:Name="UndoLayoutButton"
                                x:Uid="UndoLayoutButton"
                                Style="{StaticResource WwbToolbarButtonStyle}"
                                Visibility="Collapsed"
                                Click="UndoLayoutButton_Click" />
                            <Button
                                x:Name="RedoLayoutButton"
                                x:Uid="RedoLayoutButton"
                                Style="{StaticResource WwbToolbarButtonStyle}"
                                Visibility="Collapsed"
                                Click="RedoLayoutButton_Click" />
                            <Button
                                x:Name="SettingsButton"
                                x:Uid="SettingsButton"
                                Style="{StaticResource WwbToolbarButtonStyle}"
                                Click="SettingsButton_Click" />
                            <Button
                                x:Name="ClosePanelButton"
                                x:Uid="ClosePanelButton"
                                Style="{StaticResource WwbToolbarButtonStyle}"
                                Click="ClosePanelButton_Click" />
                        </StackPanel>
                    </Grid>

                </Grid>
            </Border>

            <ScrollViewer
                x:Name="ContentScrollViewer"
                Grid.Row="1"
                Padding="{StaticResource WwbContentPadding}"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Top"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
                <Grid
                    x:Name="CardGridHost"
                    x:Uid="CardGridHost"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    SizeChanged="CardGridHost_SizeChanged">
                    <controls:ItemsRepeater
                        x:Name="CardItemsRepeater"
                        ElementPrepared="CardItemsRepeater_ElementPrepared"
                        ElementClearing="CardItemsRepeater_ElementClearing"
                        ItemTemplate="{StaticResource CardTemplateSelector}" />
                </Grid>
            </ScrollViewer>

        </Grid>
    </Grid>
</Window>
