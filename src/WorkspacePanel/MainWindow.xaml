        <!--
            One metric row. The meter is decoration over a number the row already states, so it
            carries no automation name of its own; the row's name has the name and the value.
            A metric with no ceiling - a network rate - shows no meter at all rather than a bar
            drawn against an invented maximum.
        -->
        <DataTemplate
            x:Key="SystemMonitorMetricTemplate"
            x:DataType="runtime:SystemMonitorMetricViewModel">
            <Grid
                Padding="0,3"
                RowSpacing="3"
                automation:AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Style="{StaticResource WwbCardCaptionStyle}"
                        Text="{x:Bind Name, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Grid.Column="1"
                        Style="{StaticResource WwbCardBodyStyle}"
                        Text="{x:Bind PrimaryText, Mode=OneWay}"
                        Visibility="{x:Bind HasReading, Mode=OneWay}" />
                    <TextBlock
                        Grid.Column="1"
                        Style="{StaticResource WwbCardCaptionStyle}"
                        Text="{x:Bind MetricStatusText, Mode=OneWay}"
                        Visibility="{x:Bind IsMetricStatusTextVisible, Mode=OneWay}" />
                </Grid>
                <ProgressBar
                    Grid.Row="1"
                    Height="4"
                    Minimum="0"
                    Maximum="100"
                    Value="{x:Bind MeterPercent, Mode=OneWay}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    IsTabStop="False"
                    automation:AutomationProperties.AccessibilityView="Raw"
                    Visibility="{x:Bind IsMeterVisible, Mode=OneWay}" />
                <TextBlock
                    Grid.Row="2"
                    Style="{StaticResource WwbCardCaptionStyle}"
                    Text="{x:Bind SecondaryText, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{x:Bind IsSecondaryVisible, Mode=OneWay}" />
            </Grid>
        </DataTemplate>

