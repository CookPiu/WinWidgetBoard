        <!--
            One metric row, with its own recent window drawn behind it.

            The curve replaces the meter rather than joining it: the curve's right edge is the
            same number the meter would show, and both at once states one reading twice. The
            meter is what a row falls back to before there is a window to plot - the first tick
            of a cold start, and the first after a wake - which is decided in the projection so
            the rule is testable without a WinUI host.

            Both are decoration over a number the row already states, so neither carries an
            automation name; the row's name has the name and the value. A metric with no
            ceiling - a network rate - still shows no meter, but it does get a curve: a rate
            has no full scale to draw a bar against, while a shape against the window's own
            peak is exactly what a rate can honestly be drawn as.
        -->
        <DataTemplate
            x:Key="SystemMonitorMetricTemplate"
            x:DataType="runtime:SystemMonitorMetricViewModel">
            <Grid
                Padding="0,3"
                Visibility="{x:Bind IsWithinCardLimit, Mode=OneWay}"
                automation:AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}">
                <layout:SystemMonitorCurve
                    Style="{StaticResource WwbSystemMonitorRowCurveStyle}"
                    Points="{x:Bind CurvePoints, Mode=OneWay}"
                    Visibility="{x:Bind IsCurveVisible, Mode=OneWay}" />
                <Grid RowSpacing="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Style="{StaticResource WwbCardCaptionStyle}"
                            Text="{x:Bind Name, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource WwbCardBodyStyle}"
                            Text="{x:Bind PrimaryText, Mode=OneWay}"
                            Visibility="{x:Bind HasReading, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource WwbCardCaptionStyle}"
                            Text="{x:Bind MetricStatusText, Mode=OneWay}"
                            Visibility="{x:Bind IsMetricStatusTextVisible, Mode=OneWay}" />
                    </Grid>
                    <ProgressBar
                        Grid.Row="1"
                        Style="{StaticResource WwbMetricMeterStyle}"
                        Minimum="0"
                        Maximum="100"
                        Value="{x:Bind MeterPercent, Mode=OneWay}"
                        IsTabStop="False"
                        automation:AutomationProperties.AccessibilityView="Raw"
                        Visibility="{x:Bind IsMeterVisible, Mode=OneWay}" />
                    <TextBlock
                        Grid.Row="2"
                        Style="{StaticResource WwbCardCaptionStyle}"
                        Text="{x:Bind SecondaryText, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind IsSecondaryVisible, Mode=OneWay}" />
                </Grid>
            </Grid>
        </DataTemplate>

