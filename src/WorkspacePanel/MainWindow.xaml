            x:Key="TokenUsageBreakdownTemplate"
            x:DataType="runtime:TokenUsageBreakdownViewModel">
            <Grid
                Padding="0,2"
                RowSpacing="2"
                automation:AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}">
