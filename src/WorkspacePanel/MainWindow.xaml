        -->
        <DataTemplate
            x:Key="TokenUsagePageTabTemplate"
            x:DataType="runtime:TokenUsagePageTabViewModel">
            <ToggleButton
                MinWidth="0"
                Padding="8,2"
                Content="{x:Bind Name, Mode=OneWay}"
                IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                Tag="{x:Bind PageId}"
                Click="TokenUsagePageTab_Click"
                automation:AutomationProperties.Name="{x:Bind Name, Mode=OneWay}" />
        </DataTemplate>

        <!--
            One quota window, as the vendor itself reported it. Only vendors that publish quota
            get this block, and only while the reading is still current - a window whose reset
            time has passed is dropped upstream rather than shown stale.
        -->
        <DataTemplate
            x:Key="TokenUsageQuotaTemplate"
            x:DataType="runtime:TokenUsageQuotaViewModel">
            <Grid
                Padding="0,2"
                RowSpacing="2"
                automation:AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
