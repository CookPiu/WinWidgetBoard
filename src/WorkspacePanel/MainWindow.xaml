                    automation:AutomationProperties.AccessibilityView="Raw"
                    Visibility="{x:Bind IsMeterVisible, Mode=OneWay}" />
            </Grid>
        </DataTemplate>

        <!--
            One hour of the day. The bar heights arrive already scaled against the window's own
            peak - the panel has no ceiling of its own to judge a token count against - and a
            bar never reaches zero height, so an hour with a little usage still reads
            differently from an hour with none.
        -->
        <DataTemplate
            x:Key="TokenUsageTrendBarTemplate"
            x:DataType="runtime:TokenUsageTrendBarViewModel">
            <Grid Height="32" Width="6" Margin="1,0">
                <Rectangle
                    VerticalAlignment="Bottom"
                    Height="{x:Bind BarHeight, Mode=OneWay}"
                    RadiusX="1"
                    RadiusY="1"
                    Fill="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </DataTemplate>

