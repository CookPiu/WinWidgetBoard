        x:Key="WwbWeatherDividerStyle"
        TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter
            Property="Background"
            Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
