    <Style
        x:Key="WwbSearchResultTitleStyle"
        TargetType="TextBlock"
        BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
