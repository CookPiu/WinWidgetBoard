    <Style
        x:Key="WwbToolbarButtonStyle"
        TargetType="Button"
        BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
        <Setter
            Property="CornerRadius"
            Value="{StaticResource WwbControlCornerRadius}" />
        <Setter Property="FontSize" Value="14" />
        <Setter
            Property="Background"
            Value="{ThemeResource SubtleFillColorTransparentBrush}" />
        <Setter
            Property="BorderThickness"
            Value="{ThemeResource WwbSurfaceBorderThickness}" />
    </Style>

    <!--
        The toolbar button as a mode switch. Same geometry and icon font as
        WwbToolbarButtonStyle, which cannot simply be reused: a Style is bound to one
        TargetType, and ToggleButton is not Button.
    -->
    <Style
        x:Key="WwbToolbarToggleButtonStyle"
        TargetType="ToggleButton"
        BasedOn="{StaticResource DefaultToggleButtonStyle}">
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
        <Setter
            Property="CornerRadius"
            Value="{StaticResource WwbControlCornerRadius}" />
        <Setter Property="FontSize" Value="14" />
        <Setter
            Property="Background"
            Value="{ThemeResource SubtleFillColorTransparentBrush}" />
        <Setter
            Property="BorderThickness"
            Value="{ThemeResource WwbSurfaceBorderThickness}" />
    </Style>

    <Style
        x:Key="WwbPrimaryToolbarButtonStyle"
        TargetType="Button"
        BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
        <Setter
            Property="CornerRadius"
            Value="{StaticResource WwbControlCornerRadius}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style
        x:Key="WwbCardIconButtonStyle"
        TargetType="Button"
        BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
        <Setter Property="FontSize" Value="13" />
        <Setter
            Property="BorderThickness"
            Value="{StaticResource WwbSurfaceBorderThickness}" />
        <Setter
            Property="CornerRadius"
            Value="{StaticResource WwbSmallCornerRadius}" />
        <Setter
            Property="Background"
            Value="{ThemeResource SubtleFillColorTransparentBrush}" />
    </Style>

    <Style
        x:Key="WwbCardActionButtonStyle"
        TargetType="Button"
        BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="8,4" />
        <Setter
            Property="CornerRadius"
            Value="{StaticResource WwbSmallCornerRadius}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style
        x:Key="WwbNoteUtilityButtonStyle"
        TargetType="Button"
        BasedOn="{StaticResource WwbCardActionButtonStyle}">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style
        x:Key="WwbEditActionButtonStyle"
        TargetType="Button"
        BasedOn="{StaticResource WwbCardActionButtonStyle}">
        <Setter Property="MinWidth" Value="32" />
    </Style>

    <Style
        x:Key="WwbDestructiveActionButtonStyle"
        TargetType="Button"
        BasedOn="{StaticResource WwbEditActionButtonStyle}">
        <Setter
            Property="Foreground"
            Value="{ThemeResource SystemFillColorCriticalBrush}" />
    </Style>

    <!--
        Text buttons for dialog surfaces. Kept separate from the toolbar pair on purpose: those
        set Segoe Fluent Icons and zero padding because their content is a single glyph, and a
        word rendered in an icon font comes out as tofu. A settings dialog commits with words.
    -->
    <Style
        x:Key="WwbDialogButtonStyle"
        TargetType="Button"
        BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="12,4" />
        <Setter
            Property="CornerRadius"
            Value="{StaticResource WwbControlCornerRadius}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style
        x:Key="WwbPrimaryDialogButtonStyle"
        TargetType="Button"
        BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="12,4" />
        <Setter
            Property="CornerRadius"
            Value="{StaticResource WwbControlCornerRadius}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style
        x:Key="WwbSearchResultButtonStyle"
        TargetType="Button"
        BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="10,6" />
        <Setter
            Property="CornerRadius"
            Value="{StaticResource WwbSmallCornerRadius}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <Style
        x:Key="WwbSearchBoxStyle"
        TargetType="TextBox"
        BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,4" />
        <Setter
            Property="CornerRadius"
            Value="{StaticResource WwbControlCornerRadius}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter
            Property="Background"
            Value="{ThemeResource ControlFillColorDefaultBrush}" />
        <Setter
            Property="BorderThickness"
            Value="{ThemeResource WwbSurfaceBorderThickness}" />
    </Style>

    <Style
        x:Key="WwbNoteTitleTextBoxStyle"
        TargetType="TextBox"
        BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="0,2" />
        <Setter
            Property="Background"
            Value="{ThemeResource SubtleFillColorTransparentBrush}" />
        <Setter
            Property="BorderThickness"
            Value="{StaticResource WwbSurfaceBorderThickness}" />
        <Setter
            Property="CornerRadius"
            Value="{StaticResource WwbSmallCornerRadius}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style
        x:Key="WwbNoteBodyTextBoxStyle"
        TargetType="TextBox"
        BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="Padding" Value="0,4" />
        <Setter
            Property="Background"
            Value="{ThemeResource SubtleFillColorTransparentBrush}" />
        <Setter
            Property="BorderThickness"
            Value="{StaticResource WwbSurfaceBorderThickness}" />
        <Setter
            Property="CornerRadius"
            Value="{StaticResource WwbSmallCornerRadius}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style
        x:Key="WwbModeCheckBoxStyle"
        TargetType="CheckBox"
        BasedOn="{StaticResource DefaultCheckBoxStyle}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
