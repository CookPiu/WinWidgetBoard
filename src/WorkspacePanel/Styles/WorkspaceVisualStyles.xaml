<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Spacing and shape tokens follow the approved four-pixel rhythm. -->
    <x:Double x:Key="WwbSpace1">4</x:Double>
    <x:Double x:Key="WwbSpace2">8</x:Double>
    <x:Double x:Key="WwbSpace3">12</x:Double>
    <x:Double x:Key="WwbSpace4">16</x:Double>
    <x:Double x:Key="WwbSpace5">20</x:Double>
    <x:Double x:Key="WwbSpace6">24</x:Double>
    <x:Double x:Key="WwbSpace8">32</x:Double>

    <Thickness x:Key="WwbHeaderPadding">24,20,24,16</Thickness>
    <Thickness x:Key="WwbContentPadding">24,12,24,28</Thickness>
    <Thickness x:Key="WwbCardPadding">20</Thickness>
    <Thickness x:Key="WwbCompactCardPadding">16</Thickness>
    <Thickness x:Key="WwbSurfacePadding">12</Thickness>
    <Thickness x:Key="WwbToolbarPadding">8</Thickness>
    <Thickness x:Key="WwbCompactToolbarPadding">4</Thickness>

    <CornerRadius x:Key="WwbCardCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="WwbControlCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="WwbSmallCornerRadius">8</CornerRadius>

    <!-- System theme resources keep light, dark and high-contrast behavior native. -->
    <Style
        x:Key="WwbPanelRootStyle"
        TargetType="Grid">
        <Setter
            Property="Background"
            Value="{ThemeResource ApplicationPageBackgroundThemeBrush}" />
    </Style>

    <Style
        x:Key="WwbHeaderSurfaceStyle"
        TargetType="Border">
        <Setter
            Property="Padding"
            Value="{StaticResource WwbHeaderPadding}" />
        <Setter
            Property="Background"
            Value="{ThemeResource LayerFillColorDefaultBrush}" />
        <Setter
            Property="BorderBrush"
            Value="{ThemeResource SurfaceStrokeColorDefaultBrush}" />
        <Setter
            Property="BorderThickness"
            Value="0,0,0,1" />
    </Style>

    <Style
        x:Key="WwbCardSurfaceStyle"
        TargetType="Border">
        <Setter
            Property="Padding"
            Value="{StaticResource WwbCardPadding}" />
        <Setter
            Property="CornerRadius"
            Value="{StaticResource WwbCardCornerRadius}" />
        <Setter
            Property="Background"
            Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter
            Property="BorderBrush"
            Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter
            Property="BorderThickness"
            Value="1" />
    </Style>

    <Style
        x:Key="WwbSecondarySurfaceStyle"
        TargetType="Border">
        <Setter
            Property="Padding"
            Value="{StaticResource WwbSurfacePadding}" />
        <Setter
            Property="CornerRadius"
            Value="{StaticResource WwbControlCornerRadius}" />
        <Setter
            Property="Background"
            Value="{ThemeResource LayerFillColorAltBrush}" />
        <Setter
            Property="BorderBrush"
            Value="{ThemeResource SurfaceStrokeColorDefaultBrush}" />
        <Setter
            Property="BorderThickness"
            Value="1" />
    </Style>

    <Style
        x:Key="WwbStatusSurfaceStyle"
        TargetType="Border"
        BasedOn="{StaticResource WwbSecondarySurfaceStyle}">
        <Setter
            Property="Background"
            Value="{ThemeResource SystemFillColorNeutralBackgroundBrush}" />
    </Style>

    <Style
        x:Key="WwbCardRuntimeStatusSurfaceStyle"
        TargetType="Border"
        BasedOn="{StaticResource WwbSecondarySurfaceStyle}">
        <Setter Property="Padding" Value="12" />
        <Setter
            Property="Background"
            Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
    </Style>

    <Style
        x:Key="WwbCardRuntimeStatusTitleStyle"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter
            Property="Foreground"
            Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style
        x:Key="WwbCardRuntimeStatusSummaryStyle"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="18" />
        <Setter
            Property="Foreground"
            Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style
        x:Key="WwbCardRuntimeStatusFreshnessStyle"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="18" />
        <Setter
            Property="Foreground"
            Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style
        x:Key="WwbCardRuntimeStatusCriticalIconStyle"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="MinWidth" Value="20" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter
            Property="Foreground"
            Value="{ThemeResource SystemFillColorCriticalBrush}" />
    </Style>

    <Style
        x:Key="WwbCardRuntimeStatusSkeletonBlockStyle"
        TargetType="Border">
        <Setter Property="Height" Value="12" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter
            Property="Background"
            Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
    </Style>

    <Style
        x:Key="WwbEditToolbarSurfaceStyle"
        TargetType="Border">
        <Setter
            Property="Padding"
            Value="{StaticResource WwbToolbarPadding}" />
        <Setter
            Property="CornerRadius"
            Value="{StaticResource WwbControlCornerRadius}" />
        <Setter
            Property="Background"
            Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
    </Style>

    <Style
        x:Key="WwbDragHandleStyle"
        TargetType="Border">
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="4" />
        <Setter
            Property="CornerRadius"
            Value="{StaticResource WwbSmallCornerRadius}" />
        <Setter
            Property="Background"
            Value="{ThemeResource SubtleFillColorTransparentBrush}" />
    </Style>

    <Style
        x:Key="WwbPanelTitleStyle"
        TargetType="TextBlock"
        BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="36" />
        <Setter
            Property="Foreground"
            Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style
        x:Key="WwbPanelMetaStyle"
        TargetType="TextBlock"
        BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="20" />
        <Setter
            Property="Foreground"
            Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style
        x:Key="WwbPanelContextStyle"
        TargetType="TextBlock"
        BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="18" />
        <Setter
            Property="Foreground"
            Value="{ThemeResource TextFillColorTertiaryBrush}" />
    </Style>

    <Style
        x:Key="WwbCardTitleStyle"
        TargetType="TextBlock"
        BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="24" />
        <Setter
            Property="Foreground"
            Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style
        x:Key="WwbCardBodyStyle"
        TargetType="TextBlock"
        BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="20" />
        <Setter
            Property="Foreground"
            Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style
        x:Key="WwbCardCaptionStyle"
        TargetType="TextBlock"
        BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="18" />
        <Setter
            Property="Foreground"
            Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style
        x:Key="WwbSearchResultTitleStyle"
        TargetType="TextBlock"
        BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="20" />
        <Setter
            Property="Foreground"
            Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style
        x:Key="WwbSearchResultPreviewStyle"
        TargetType="TextBlock"
        BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="18" />
        <Setter
            Property="Foreground"
            Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style
        x:Key="WwbToolbarButtonStyle"
        TargetType="Button"
        BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="14,8" />
        <Setter
            Property="CornerRadius"
            Value="{StaticResource WwbControlCornerRadius}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style
        x:Key="WwbPrimaryToolbarButtonStyle"
        TargetType="Button"
        BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="14,8" />
        <Setter
            Property="CornerRadius"
            Value="{StaticResource WwbControlCornerRadius}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style
        x:Key="WwbCardActionButtonStyle"
        TargetType="Button"
        BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="14,6" />
        <Setter
            Property="CornerRadius"
            Value="{StaticResource WwbSmallCornerRadius}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style
        x:Key="WwbNoteActionButtonStyle"
        TargetType="Button"
        BasedOn="{StaticResource WwbCardActionButtonStyle}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style
        x:Key="WwbEditActionButtonStyle"
        TargetType="Button"
        BasedOn="{StaticResource WwbCardActionButtonStyle}">
        <Setter Property="MinWidth" Value="40" />
    </Style>

    <Style
        x:Key="WwbDestructiveActionButtonStyle"
        TargetType="Button"
        BasedOn="{StaticResource WwbEditActionButtonStyle}">
        <Setter
            Property="Foreground"
            Value="{ThemeResource SystemFillColorCriticalBrush}" />
    </Style>

    <Style
        x:Key="WwbSearchResultButtonStyle"
        TargetType="Button"
        BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="12,8" />
        <Setter
            Property="CornerRadius"
            Value="{StaticResource WwbSmallCornerRadius}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <Style
        x:Key="WwbSearchBoxStyle"
        TargetType="TextBox"
        BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="12,8" />
        <Setter
            Property="CornerRadius"
            Value="{StaticResource WwbControlCornerRadius}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style
        x:Key="WwbNoteTitleTextBoxStyle"
        TargetType="TextBox"
        BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="12,8" />
        <Setter
            Property="CornerRadius"
            Value="{StaticResource WwbControlCornerRadius}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style
        x:Key="WwbNoteBodyTextBoxStyle"
        TargetType="TextBox"
        BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="Padding" Value="12,10" />
        <Setter
            Property="CornerRadius"
            Value="{StaticResource WwbControlCornerRadius}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style
        x:Key="WwbModeCheckBoxStyle"
        TargetType="CheckBox"
        BasedOn="{StaticResource DefaultCheckBoxStyle}">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
