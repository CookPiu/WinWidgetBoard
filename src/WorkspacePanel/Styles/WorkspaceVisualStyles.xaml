<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <Thickness x:Key="WwbSurfaceBorderThickness">0</Thickness>
            <Thickness x:Key="WwbFlyoutBorderThickness">1</Thickness>
            <!--
                The weather illustration is the one place in the panel that needs literal
                colour: no Windows semantic brush means "overcast sky". The whole palette is
                defined here and nowhere else, so a page never states a colour of its own,
                and high contrast drops all of it below.
            -->
            <SolidColorBrush x:Key="WwbWeatherSkyClearBrush" Color="#4AA3E8" Opacity="0.22" />
            <SolidColorBrush x:Key="WwbWeatherSkyNightBrush" Color="#4C5DA8" Opacity="0.24" />
            <SolidColorBrush x:Key="WwbWeatherSkyCloudyBrush" Color="#8996A6" Opacity="0.20" />
            <SolidColorBrush x:Key="WwbWeatherSkyWetBrush" Color="#5480A8" Opacity="0.22" />
            <SolidColorBrush x:Key="WwbWeatherSkySnowBrush" Color="#9CC4E4" Opacity="0.20" />
            <SolidColorBrush x:Key="WwbWeatherSkyStormBrush" Color="#5B5488" Opacity="0.26" />
            <!--
                The motif brushes are opaque on purpose. Every illustration draws its shapes
                inside one group that carries WwbWeatherMotifOpacity, so a cloud in front of
                the sun hides it instead of adding a second layer of alpha to it; the wash is
                then the same strength wherever two shapes met, which is what stopped the
                backdrop from showing bright seams along every overlap.
            -->
            <SolidColorBrush x:Key="WwbWeatherMotifBrush" Color="#93A9BE" />
            <SolidColorBrush x:Key="WwbWeatherMotifStrongBrush" Color="#FFFFFF" />
            <Color x:Key="WwbWeatherMotifStrongColor">#FFFFFF</Color>
            <x:Double x:Key="WwbWeatherMotifOpacity">0.18</x:Double>
            <!--
                The fill under a curve, shared by the weather trend and the token spend curve
                so the two cannot drift apart. It is a ramp rather than a flat wash: filled at
                one opacity the area ends in a hard horizontal edge along the card and reads as
                a panel pasted behind the figures instead of as shading under a line.

                Three stops, not two. Running straight to transparent grades the area by its
                position in the path's bounding box, so wherever the curve sits low the fill
                under it disappears - the weather trend lost its whole right half that way. The
                middle stop makes the falloff steep just under the line and then nearly flat,
                which keeps the low stretches present at a weight that still reads as shading.

                The alpha lives in these colours rather than in an Opacity on the Path: two
                places to change one strength is one place too many. How much of the fill shows
                at all depends on the curve's own shape, which is the data's business - a spend
                curve that sits on its baseline all morning has no area there to shade.
            -->
            <Color x:Key="WwbWeatherCurveAreaTopColor">#2EFFFFFF</Color>
            <Color x:Key="WwbWeatherCurveAreaMidColor">#1CFFFFFF</Color>
            <Color x:Key="WwbWeatherCurveAreaBaseColor">#0EFFFFFF</Color>
            <LinearGradientBrush
                x:Key="WwbWeatherCurveAreaBrush"
                StartPoint="0,0"
                EndPoint="0,1">
                <GradientStop
                    Offset="0"
                    Color="{ThemeResource WwbWeatherCurveAreaTopColor}" />
                <GradientStop
                    Offset="0.4"
                    Color="{ThemeResource WwbWeatherCurveAreaMidColor}" />
                <GradientStop
                    Offset="1"
                    Color="{ThemeResource WwbWeatherCurveAreaBaseColor}" />
            </LinearGradientBrush>
            <LinearGradientBrush
                x:Key="WwbPanelAccentWashBrush"
                StartPoint="0,0"
                EndPoint="0,1"
                Opacity="0.06">
                <GradientStop
                    Color="{ThemeResource SystemAccentColor}"
                    Offset="0" />
                <GradientStop
                    Color="Transparent"
                    Offset="0.38" />
            </LinearGradientBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <Thickness x:Key="WwbSurfaceBorderThickness">0</Thickness>
            <Thickness x:Key="WwbFlyoutBorderThickness">1</Thickness>
            <LinearGradientBrush
                x:Key="WwbPanelAccentWashBrush"
                StartPoint="0,0"
                EndPoint="0,1"
                Opacity="0.06">
                <GradientStop
                    Color="{ThemeResource SystemAccentColor}"
                    Offset="0" />
                <GradientStop
                    Color="Transparent"
                    Offset="0.38" />
            </LinearGradientBrush>
            <!--
                A light card needs a stronger wash to read at all, and the motif has to be a
                darker tone rather than white, which would vanish into the surface.
            -->
            <SolidColorBrush x:Key="WwbWeatherSkyClearBrush" Color="#2E8BD8" Opacity="0.20" />
            <SolidColorBrush x:Key="WwbWeatherSkyNightBrush" Color="#3B4C96" Opacity="0.20" />
            <SolidColorBrush x:Key="WwbWeatherSkyCloudyBrush" Color="#6E7C8C" Opacity="0.18" />
            <SolidColorBrush x:Key="WwbWeatherSkyWetBrush" Color="#3E6E96" Opacity="0.20" />
            <SolidColorBrush x:Key="WwbWeatherSkySnowBrush" Color="#7FAED4" Opacity="0.20" />
            <SolidColorBrush x:Key="WwbWeatherSkyStormBrush" Color="#4A4276" Opacity="0.22" />
            <SolidColorBrush x:Key="WwbWeatherMotifBrush" Color="#5A7B9C" />
            <SolidColorBrush x:Key="WwbWeatherMotifStrongBrush" Color="#10304E" />
            <Color x:Key="WwbWeatherMotifStrongColor">#10304E</Color>
            <x:Double x:Key="WwbWeatherMotifOpacity">0.16</x:Double>
            <Color x:Key="WwbWeatherCurveAreaTopColor">#2910304E</Color>
            <Color x:Key="WwbWeatherCurveAreaMidColor">#1A10304E</Color>
            <Color x:Key="WwbWeatherCurveAreaBaseColor">#0D10304E</Color>
            <LinearGradientBrush
                x:Key="WwbWeatherCurveAreaBrush"
                StartPoint="0,0"
                EndPoint="0,1">
                <GradientStop
                    Offset="0"
                    Color="{ThemeResource WwbWeatherCurveAreaTopColor}" />
                <GradientStop
                    Offset="0.4"
                    Color="{ThemeResource WwbWeatherCurveAreaMidColor}" />
                <GradientStop
                    Offset="1"
                    Color="{ThemeResource WwbWeatherCurveAreaBaseColor}" />
            </LinearGradientBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <Thickness x:Key="WwbSurfaceBorderThickness">1</Thickness>
            <Thickness x:Key="WwbFlyoutBorderThickness">1</Thickness>
            <SolidColorBrush
                x:Key="WwbPanelAccentWashBrush"
                Color="Transparent" />
            <!-- High contrast conveys state with text and shape only; no illustration. -->
            <SolidColorBrush x:Key="WwbWeatherSkyClearBrush" Color="Transparent" />
            <SolidColorBrush x:Key="WwbWeatherSkyNightBrush" Color="Transparent" />
            <SolidColorBrush x:Key="WwbWeatherSkyCloudyBrush" Color="Transparent" />
            <SolidColorBrush x:Key="WwbWeatherSkyWetBrush" Color="Transparent" />
            <SolidColorBrush x:Key="WwbWeatherSkySnowBrush" Color="Transparent" />
            <SolidColorBrush x:Key="WwbWeatherSkyStormBrush" Color="Transparent" />
            <SolidColorBrush x:Key="WwbWeatherMotifBrush" Color="Transparent" />
            <SolidColorBrush x:Key="WwbWeatherMotifStrongBrush" Color="Transparent" />
            <Color x:Key="WwbWeatherMotifStrongColor">Transparent</Color>
            <x:Double x:Key="WwbWeatherMotifOpacity">0</x:Double>
            <Color x:Key="WwbWeatherCurveAreaTopColor">Transparent</Color>
            <Color x:Key="WwbWeatherCurveAreaMidColor">Transparent</Color>
            <Color x:Key="WwbWeatherCurveAreaBaseColor">Transparent</Color>
            <LinearGradientBrush
                x:Key="WwbWeatherCurveAreaBrush"
                StartPoint="0,0"
                EndPoint="0,1">
                <GradientStop
                    Offset="0"
                    Color="{ThemeResource WwbWeatherCurveAreaTopColor}" />
                <GradientStop
                    Offset="0.4"
                    Color="{ThemeResource WwbWeatherCurveAreaMidColor}" />
                <GradientStop
                    Offset="1"
                    Color="{ThemeResource WwbWeatherCurveAreaBaseColor}" />
            </LinearGradientBrush>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Spacing and shape tokens follow the approved four-pixel rhythm. -->
    <x:Double x:Key="WwbSpace1">4</x:Double>
    <x:Double x:Key="WwbSpace2">8</x:Double>
    <x:Double x:Key="WwbSpace3">12</x:Double>
    <x:Double x:Key="WwbSpace4">16</x:Double>
    <x:Double x:Key="WwbSpace5">20</x:Double>
    <x:Double x:Key="WwbSpace6">24</x:Double>
    <x:Double x:Key="WwbSpace8">32</x:Double>

    <Thickness x:Key="WwbHeaderPadding">12,8</Thickness>
    <Thickness x:Key="WwbContentPadding">12,6,12,12</Thickness>
    <Thickness x:Key="WwbCompactCardPadding">12</Thickness>
    <Thickness x:Key="WwbSurfacePadding">8</Thickness>
    <Thickness x:Key="WwbToolbarPadding">4</Thickness>
    <Thickness x:Key="WwbCompactToolbarPadding">4</Thickness>

    <CornerRadius x:Key="WwbPanelCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="WwbCardCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="WwbControlCornerRadius">7</CornerRadius>
    <CornerRadius x:Key="WwbSmallCornerRadius">6</CornerRadius>

    <!--
        The top-level Desktop Acrylic carries ambient color. Cards remain more
        solid so translucent layers do not stack and reduce legibility.
    -->
    <Style
        x:Key="WwbPanelRootStyle"
        TargetType="Grid">
        <Setter
            Property="Background"
            Value="Transparent" />
        <Setter
            Property="BorderBrush"
            Value="{ThemeResource SurfaceStrokeColorDefaultBrush}" />
        <Setter
            Property="BorderThickness"
            Value="{ThemeResource WwbSurfaceBorderThickness}" />
        <Setter
            Property="CornerRadius"
            Value="{StaticResource WwbPanelCornerRadius}" />
    </Style>

    <Style
        x:Key="WwbHeaderSurfaceStyle"
        TargetType="Border">
        <Setter
            Property="Padding"
            Value="{StaticResource WwbHeaderPadding}" />
        <Setter
            Property="Background"
            Value="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" />
        <Setter
            Property="BorderBrush"
            Value="{ThemeResource SurfaceStrokeColorDefaultBrush}" />
        <Setter
            Property="BorderThickness"
            Value="{ThemeResource WwbSurfaceBorderThickness}" />
    </Style>

    <Style
        x:Key="WwbCardSurfaceStyle"
        TargetType="Border">
        <Setter
            Property="Padding"
            Value="{StaticResource WwbCompactCardPadding}" />
        <Setter
            Property="CornerRadius"
            Value="{StaticResource WwbCardCornerRadius}" />
        <Setter
            Property="Background"
            Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter
            Property="BorderBrush"
            Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter
            Property="BorderThickness"
            Value="{ThemeResource WwbSurfaceBorderThickness}" />
    </Style>

    <Style
        x:Key="WwbSecondarySurfaceStyle"
        TargetType="Border">
        <Setter
            Property="Padding"
            Value="{StaticResource WwbSurfacePadding}" />
        <Setter
            Property="CornerRadius"
            Value="{StaticResource WwbControlCornerRadius}" />
        <Setter
            Property="Background"
            Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
        <Setter
            Property="BorderBrush"
            Value="{ThemeResource SurfaceStrokeColorDefaultBrush}" />
        <Setter
            Property="BorderThickness"
            Value="{ThemeResource WwbSurfaceBorderThickness}" />
    </Style>

    <Style
        x:Key="WwbStatusSurfaceStyle"
        TargetType="Border"
        BasedOn="{StaticResource WwbSecondarySurfaceStyle}">
        <Setter Property="Padding" Value="0" />
        <Setter
            Property="Background"
            Value="{ThemeResource SubtleFillColorTransparentBrush}" />
    </Style>

    <Style
        x:Key="WwbNoteOverflowSurfaceStyle"
        TargetType="Border"
        BasedOn="{StaticResource WwbSecondarySurfaceStyle}">
        <Setter Property="Padding" Value="6" />
        <Setter
            Property="Background"
            Value="{ThemeResource AcrylicInAppFillColorDefaultBrush}" />
        <Setter
            Property="BorderBrush"
            Value="{ThemeResource SurfaceStrokeColorFlyoutBrush}" />
        <Setter
            Property="BorderThickness"
            Value="{ThemeResource WwbFlyoutBorderThickness}" />
    </Style>

    <Style
        x:Key="WwbCardRuntimeStatusSurfaceStyle"
        TargetType="Border"
        BasedOn="{StaticResource WwbSecondarySurfaceStyle}">
        <Setter Property="Padding" Value="0" />
        <Setter
            Property="Background"
            Value="{ThemeResource SubtleFillColorTransparentBrush}" />
    </Style>

    <Style
        x:Key="WwbCardRuntimeStatusTitleStyle"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter
            Property="Foreground"
            Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style
        x:Key="WwbCardRuntimeStatusSummaryStyle"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="17" />
        <Setter
            Property="Foreground"
            Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style
        x:Key="WwbCardRuntimeStatusFreshnessStyle"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="LineHeight" Value="16" />
        <Setter
            Property="Foreground"
            Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style
        x:Key="WwbCardRuntimeStatusCriticalIconStyle"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="MinWidth" Value="20" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter
            Property="Foreground"
            Value="{ThemeResource SystemFillColorCriticalBrush}" />
    </Style>

    <Style
        x:Key="WwbCardRuntimeStatusSkeletonBlockStyle"
        TargetType="Border">
        <Setter Property="Height" Value="12" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter
            Property="Background"
            Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
    </Style>

    <Style
        x:Key="WwbEditToolbarSurfaceStyle"
        TargetType="Border">
        <Setter
            Property="Padding"
            Value="{StaticResource WwbToolbarPadding}" />
        <Setter
            Property="CornerRadius"
            Value="{StaticResource WwbControlCornerRadius}" />
        <Setter
            Property="Background"
            Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
    </Style>

    <!--
        The edit-mode resize frame. It replaces the bar that used to sit along the bottom of
        every card in edit mode: a bar states what can be done in words and costs a row of the
        card to do it, while a frame states it in the shape of the thing being edited, which is
        how every other resizable object on a desktop behaves.

        The frame's own root has NO background, so only the three drawn handles take pointer
        input. That is what keeps the card's middle behaving exactly as before - pressing it
        still starts a move, and an interactive control inside the card still wins over the
        drag - instead of the frame swallowing the whole card the moment edit mode turns on.

        Only east, south and south-east exist. A card's origin comes from first-fit packing, so
        a west or north handle would be asking the packer to honour a position it is free to
        re-pack; every handle here changes the span and leaves the origin alone.
    -->
    <x:Double x:Key="WwbCardResizeHandleSize">20</x:Double>
    <CornerRadius x:Key="WwbCardResizeHandleRadius">10</CornerRadius>

    <Style
        x:Key="WwbCardResizeFrameStyle"
        TargetType="ContentControl">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border
                            BorderThickness="1"
                            BorderBrush="{ThemeResource AccentFillColorSecondaryBrush}"
                            CornerRadius="{StaticResource WwbCardCornerRadius}"
                            IsHitTestVisible="False" />
                        <!--
                            One handle, on the corner. Separate edge handles were two ways of
                            reaching the same five sizes: the grid has three column steps and
                            two row steps, so almost every size change is a change of both, and
                            an edge handle could only ever get halfway there. One corner also
                            leaves the card's edges alone, which is what keeps the rest of the
                            frame quiet enough to sit on eight cards at once.

                            The painted square is 12 DIP; the transparent area around it is 28,
                            because a handle that has to be hit exactly is a handle the user
                            gives up on. It is the only part of the frame that takes pointer
                            input - the middle stays transparent to it, so pressing the card
                            still starts a move.
                        -->
                        <!--
                            The grab area sits just inside the corner, not centred on it. The
                            card clips its own contents at the padding edge, so a handle
                            centred on the corner loses three quarters of itself to the clip
                            and what reaches the screen is a wedge - which is exactly how it
                            looked before this margin was pulled back in.
                        -->
                        <Border
                            Width="36"
                            Height="36"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,-6,-6"
                            Background="Transparent">
                            <!--
                                A ring, not a flat chip. The grabber has to read as something
                                that sits on top of the card and can be picked up, and the
                                thing that says so is the base-coloured ring around it: it
                                separates the mark from whatever the card is showing behind it,
                                on any card and in either theme.
                            -->
                            <Border
                                Width="{StaticResource WwbCardResizeHandleSize}"
                                Height="{StaticResource WwbCardResizeHandleSize}"
                                CornerRadius="{StaticResource WwbCardResizeHandleRadius}"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                BorderThickness="3"
                                BorderBrush="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The card's own close affordance, on the frame's top-right corner the way a selected
        object carries one. It stays a real button rather than another hit-tested region of the
        frame: removing a card is the one destructive action here, and it needs a name, a
        tooltip and an automation id of its own.
    -->
    <Style
        x:Key="WwbCardRemoveBadgeStyle"
        TargetType="Button"
        BasedOn="{StaticResource WwbEditActionButtonStyle}">
        <Setter Property="MinWidth" Value="26" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="0,-9,-9,0" />
        <Setter Property="CornerRadius" Value="13" />
        <Setter Property="FontSize" Value="12" />
        <!--
            Neutral, not critical. A red cross on every card is the loudest thing on a board
            in edit mode, and it is loud about the one action the user is least likely to
            want; the colour belongs to the moment the pointer is actually on it, which the
            button's own hover state already supplies.
        -->
        <Setter
            Property="Foreground"
            Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter
            Property="Background"
            Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
        <Setter
            Property="BorderBrush"
            Value="{ThemeResource ControlStrokeColorSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style
        x:Key="WwbDragHandleStyle"
        TargetType="Border">
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="4" />
        <Setter
            Property="CornerRadius"
            Value="{StaticResource WwbSmallCornerRadius}" />
        <Setter
            Property="Background"
            Value="{ThemeResource SubtleFillColorTransparentBrush}" />
    </Style>

    <Style
        x:Key="WwbPanelTitleStyle"
        TargetType="TextBlock"
        BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="22" />
        <Setter
            Property="Foreground"
            Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style
        x:Key="WwbPanelMetaStyle"
        TargetType="TextBlock"
        BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="LineHeight" Value="16" />
        <Setter
            Property="Foreground"
            Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style
        x:Key="WwbPanelContextStyle"
        TargetType="TextBlock"
        BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="LineHeight" Value="14" />
        <Setter
            Property="Foreground"
            Value="{ThemeResource TextFillColorTertiaryBrush}" />
    </Style>

    <Style
        x:Key="WwbCardTitleStyle"
        TargetType="TextBlock"
        BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="18" />
        <Setter
            Property="Foreground"
            Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style
        x:Key="WwbCardBodyStyle"
        TargetType="TextBlock"
        BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="17" />
        <Setter
            Property="Foreground"
            Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <!--
        A segmented selector for a card's page tabs.

        The default ToggleButton is wrong here for two reasons the visual spec names directly:
        it outlines every state, and it fills the checked state with solid accent. Section 6.3
        forbids outlining containers for their own sake, and 6.2 reserves accent for focus,
        selection emphasis and primary actions - a row of tabs on a card is none of those at
        full strength. Selection is carried by a subtle fill and a weight change instead, which
        also keeps the strip readable when several tabs sit side by side.

        Focus is the one thing that does keep the system's own visual: the focus rect is drawn
        by the template's FocusVisual, unmodified.
    -->
    <Style x:Key="WwbPageTabToggleStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter
            Property="Foreground"
            Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid
                        x:Name="Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames
                                            Storyboard.TargetName="Root"
                                            Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame
                                                KeyTime="0"
                                                Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames
                                            Storyboard.TargetName="Root"
                                            Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame
                                                KeyTime="0"
                                                Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames
                                            Storyboard.TargetName="Label"
                                            Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame
                                                KeyTime="0"
                                                Value="{ThemeResource TextFillColorDisabledBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <!--
                                    The selected tab reads by fill and weight, not by colour
                                    alone - state must never be carried by colour on its own.
                                -->
                                <VisualState x:Name="Checked">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames
                                            Storyboard.TargetName="Root"
                                            Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame
                                                KeyTime="0"
                                                Value="{ThemeResource ControlFillColorDefaultBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames
                                            Storyboard.TargetName="Label"
                                            Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame
                                                KeyTime="0"
                                                Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames
                                            Storyboard.TargetName="Label"
                                            Storyboard.TargetProperty="FontWeight">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="SemiBold" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames
                                            Storyboard.TargetName="Root"
                                            Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame
                                                KeyTime="0"
                                                Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames
                                            Storyboard.TargetName="Label"
                                            Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame
                                                KeyTime="0"
                                                Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames
                                            Storyboard.TargetName="Label"
                                            Storyboard.TargetProperty="FontWeight">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="SemiBold" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames
                                            Storyboard.TargetName="Root"
                                            Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame
                                                KeyTime="0"
                                                Value="{ThemeResource ControlFillColorTertiaryBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames
                                            Storyboard.TargetName="Label"
                                            Storyboard.TargetProperty="FontWeight">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="SemiBold" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="CheckedDisabled" />
                                <VisualState x:Name="Indeterminate" />
                                <VisualState x:Name="IndeterminatePointerOver" />
                                <VisualState x:Name="IndeterminatePressed" />
                                <VisualState x:Name="IndeterminateDisabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            x:Name="Label"
                            Padding="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            FontSize="{TemplateBinding FontSize}"
                            Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="WwbWeatherTemperatureStyle"
        TargetType="TextBlock"
        BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="32" />
        <Setter
            Property="Foreground"
            Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <!--
        A hairline between the hourly trend and the days below it. Drawn from the system
        divider brush, so high contrast substitutes its own boundary instead of a literal
        colour that would vanish or shout.
    -->
    <Style
        x:Key="WwbWeatherDividerStyle"
        TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter
            Property="Background"
            Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
    </Style>

    <!--
        The inline meter under a metric row. The track is barely-there on purpose: a
        full-width track at the default weight reads as a rule between rows, and a card of
        seven metered rows turned into a lined table. The fill stays the secondary text
        colour, so the meter reads as part of the number it decorates rather than as chrome.
    -->
    <Style
        x:Key="WwbMetricMeterStyle"
        TargetType="ProgressBar">
        <Setter Property="Height" Value="3" />
        <Setter Property="MinHeight" Value="3" />
        <Setter
            Property="Foreground"
            Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter
            Property="Background"
            Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
    </Style>

    <Style
        x:Key="WwbCardCaptionStyle"
        TargetType="TextBlock"
        BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="LineHeight" Value="16" />
        <Setter
            Property="Foreground"
            Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <!--
        A figure that outranks a reading but not the headline: the token card's two tiles.
        One step below the 28 DIP headline and two above body, so the three sizes read as
        three levels rather than as a headline with two footnotes.
    -->
    <Style
        x:Key="WwbCardFigureStyle"
        TargetType="TextBlock"
        BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="22" />
        <Setter
            Property="Foreground"
            Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <!--
        The token card's spend curve. The area takes the weather motif brush at the motif
        opacity, so it is the same kind of backdrop the weather card paints and vanishes with
        it under high contrast; the line and the crosshair take text colours, because they
        state a value and have to survive there. The tip sits on the card surface colour so it
        reads over the curve. Geometry and positions come from the control; nothing here moves
        on its own.

        Everything drawn sits in a Canvas, and that is load-bearing: a Canvas reports no
        desired size of its own, so the paths cannot feed back into layout. Hosted directly
        in the Grid, the stroked path's bounds grew the control by half a pixel on every
        SizeChanged, which rebuilt the geometry, which grew the bounds - a layout cycle that
        killed the panel the moment real data arrived.
    -->
    <Style
        x:Key="WwbTokenUsageSpendCurveStyle"
        TargetType="Control">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Grid Background="Transparent">
                        <Canvas IsHitTestVisible="False">
                            <Path
                                x:Name="PART_Area"
                                Fill="{ThemeResource WwbWeatherCurveAreaBrush}" />
                            <Path
                                x:Name="PART_Line"
                                Stroke="{ThemeResource TextFillColorTertiaryBrush}"
                                StrokeThickness="1" />
                            <Rectangle
                                x:Name="PART_Crosshair"
                                Width="1"
                                Fill="{ThemeResource TextFillColorSecondaryBrush}"
                                Visibility="Collapsed" />
                            <Ellipse
                                x:Name="PART_Pip"
                                Width="7"
                                Height="7"
                                Fill="{ThemeResource TextFillColorPrimaryBrush}"
                                Stroke="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                StrokeThickness="1.5"
                                Visibility="Collapsed" />
                            <Border
                                x:Name="PART_Tip"
                                Padding="6,1"
                                CornerRadius="{StaticResource WwbControlCornerRadius}"
                                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                BorderThickness="{ThemeResource WwbFlyoutBorderThickness}"
                                BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                                Visibility="Collapsed">
                                <TextBlock
                                    x:Name="PART_TipText"
                                    Style="{StaticResource WwbCardCaptionStyle}"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </Border>
                        </Canvas>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The hardware card's headline curve: the last two minutes of the reading the card leads
        with, and the crosshair that reads a point off it.

        Same Canvas rule as the spend curve above, and for the same reason - the geometry is
        rebuilt on SizeChanged and must not be something the parent measures. The area uses
        WwbWeatherCurveAreaBrush, which is the one ramp every curve in this panel shares; a
        second one here would be a second answer to the same question.
    -->
    <Style
        x:Key="WwbSystemMonitorHeadlineCurveStyle"
        TargetType="Control">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Grid Background="Transparent">
                        <Canvas IsHitTestVisible="False">
                            <Path
                                x:Name="PART_Area"
                                Fill="{ThemeResource WwbWeatherCurveAreaBrush}" />
                            <Path
                                x:Name="PART_Line"
                                Stroke="{ThemeResource TextFillColorTertiaryBrush}"
                                StrokeThickness="1" />
                            <Rectangle
                                x:Name="PART_Crosshair"
                                Width="1"
                                Fill="{ThemeResource TextFillColorSecondaryBrush}"
                                Visibility="Collapsed" />
                            <Ellipse
                                x:Name="PART_Pip"
                                Width="7"
                                Height="7"
                                Fill="{ThemeResource TextFillColorPrimaryBrush}"
                                Stroke="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                StrokeThickness="1.5"
                                Visibility="Collapsed" />
                            <Border
                                x:Name="PART_Tip"
                                Padding="6,1"
                                CornerRadius="{StaticResource WwbControlCornerRadius}"
                                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                BorderThickness="{ThemeResource WwbFlyoutBorderThickness}"
                                BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                                Visibility="Collapsed">
                                <TextBlock
                                    x:Name="PART_TipText"
                                    Style="{StaticResource WwbCardCaptionStyle}"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </Border>
                        </Canvas>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The same curve as a band under one reading. No crosshair parts, which is what makes it
        a sparkline: with nothing to track the control ignores the pointer entirely, and a band
        22 DIP tall has no room for a bubble anyway.

        No area either. The fill belongs to a curve with height to grade it across; in 22 DIP
        it arrives as a solid grey shape, and two readings side by side then differ by whether
        their line happens to run high - which reads as one cell having a background and the
        other not. A line alone says the same thing and stays quiet next to the value above it.
    -->
    <Style
        x:Key="WwbSystemMonitorRowCurveStyle"
        TargetType="Control">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Canvas IsHitTestVisible="False">
                        <Path
                            x:Name="PART_Line"
                            Stroke="{ThemeResource TextFillColorTertiaryBrush}"
                            StrokeThickness="1" />
                    </Canvas>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        One forecast day's span on the scale the whole forecast shares. The track is the
        card's own hairline so an empty stretch reads as "not this day" rather than as a
        second reading; the fill is the secondary text colour, because a span is a fact about
        temperature and not a state.
    -->
    <Style
        x:Key="WwbWeatherRangeBarStyle"
        TargetType="Control">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Height" Value="4" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Grid>
                        <Rectangle
                            RadiusX="2"
                            RadiusY="2"
                            Fill="{ThemeResource ControlStrongStrokeColorDisabledBrush}" />
                        <Canvas>
                            <Rectangle
                                x:Name="PART_Fill"
                                RadiusX="2"
                                RadiusY="2"
                                Opacity="0.55"
                                Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Canvas>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The hourly trend. Every shape sits in a Canvas: the control rebuilds this geometry on
        SizeChanged, and a stroked Path the parent measures grows the card half a pixel a pass
        until it fails as a layout cycle.

        The area is painted with WwbWeatherCurveAreaBrush, the ramp the token card's spend curve
        also uses, so the two cannot drift apart. It is built from the weather illustration's
        own colour rather than a literal one, so the curve is the same material as the backdrop
        behind it and high contrast clears both together.
    -->
    <Style
        x:Key="WwbWeatherHourlyCurveStyle"
        TargetType="Control">
        <Setter Property="IsTabStop" Value="False" />
        <!-- The precipitation bars are painted from this; Canvas has no Foreground. -->
        <Setter
            Property="Foreground"
            Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Grid Background="Transparent">
                        <Canvas IsHitTestVisible="False">
                            <Path
                                x:Name="PART_Area"
                                Fill="{ThemeResource WwbWeatherCurveAreaBrush}" />
                            <Path
                                x:Name="PART_Line"
                                Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                                StrokeThickness="1.5"
                                StrokeLineJoin="Round"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round"
                                Opacity="0.75" />
                            <Canvas
                                x:Name="PART_Band"
                                Opacity="0.45" />
                            <!--
                                One element carries the whole readout, so the fade is a single
                                compositor opacity rather than four that can drift apart.

                                At rest it is transparent, not collapsed. Measuring a collapsed
                                element yields a desired size of zero, and the tip's width is
                                what decides which side of the crosshair it goes on - measured
                                as zero, it never flips and runs off the right edge.
                            -->
                            <Canvas
                                x:Name="PART_Readout"
                                Opacity="0">
                                <Rectangle
                                    x:Name="PART_Crosshair"
                                    Width="1"
                                    Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Ellipse
                                    x:Name="PART_Pip"
                                    Width="7"
                                    Height="7"
                                    Fill="{ThemeResource TextFillColorPrimaryBrush}"
                                    Stroke="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    StrokeThickness="1.5" />
                                <Border
                                    x:Name="PART_Tip"
                                    Padding="8,5"
                                    CornerRadius="{StaticResource WwbControlCornerRadius}"
                                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                    BorderThickness="{ThemeResource WwbFlyoutBorderThickness}"
                                    BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}">
                                    <StackPanel Spacing="2">
                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="6">
                                            <ContentControl
                                                x:Name="PART_TipGlyph"
                                                Width="14"
                                                Height="14"
                                                VerticalAlignment="Center"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch"
                                                IsTabStop="False" />
                                            <TextBlock
                                                x:Name="PART_TipTime"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource WwbCardCaptionStyle}" />
                                            <TextBlock
                                                x:Name="PART_TipTemperature"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource WwbCardBodyStyle}"
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                        <TextBlock
                                            x:Name="PART_TipCondition"
                                            Style="{StaticResource WwbCardCaptionStyle}" />
                                        <StackPanel
                                            x:Name="PART_TipPrecipitationRow"
                                            Orientation="Horizontal"
                                            Spacing="4"
                                            Visibility="Collapsed">
                                            <TextBlock
                                                x:Uid="WeatherCurveTipPrecipitationLabel"
                                                Style="{StaticResource WwbCardCaptionStyle}" />
                                            <TextBlock
                                                x:Name="PART_TipPrecipitation"
                                                Style="{StaticResource WwbCardCaptionStyle}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Canvas>
                        </Canvas>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="WwbSearchResultTitleStyle"
