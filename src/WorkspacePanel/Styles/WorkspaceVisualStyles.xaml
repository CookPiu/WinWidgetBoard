<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <Thickness x:Key="WwbSurfaceBorderThickness">0</Thickness>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <Thickness x:Key="WwbSurfaceBorderThickness">1</Thickness>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Spacing and shape tokens follow the approved four-pixel rhythm. -->
    <x:Double x:Key="WwbSpace1">4</x:Double>
    <x:Double x:Key="WwbSpace2">8</x:Double>
    <x:Double x:Key="WwbSpace3">12</x:Double>
    <x:Double x:Key="WwbSpace4">16</x:Double>
    <x:Double x:Key="WwbSpace5">20</x:Double>
    <x:Double x:Key="WwbSpace6">24</x:Double>
    <x:Double x:Key="WwbSpace8">32</x:Double>

    <Thickness x:Key="WwbHeaderPadding">12,8</Thickness>
    <Thickness x:Key="WwbContentPadding">12,6,12,12</Thickness>
    <Thickness x:Key="WwbCardPadding">14</Thickness>
    <Thickness x:Key="WwbCompactCardPadding">12</Thickness>
    <Thickness x:Key="WwbSurfacePadding">8</Thickness>
    <Thickness x:Key="WwbToolbarPadding">4</Thickness>
    <Thickness x:Key="WwbCompactToolbarPadding">4</Thickness>

    <CornerRadius x:Key="WwbCardCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="WwbControlCornerRadius">7</CornerRadius>
    <CornerRadius x:Key="WwbSmallCornerRadius">6</CornerRadius>

    <!-- System theme resources keep light, dark and high-contrast behavior native. -->
    <Style
        x:Key="WwbPanelRootStyle"
        TargetType="Grid">
        <Setter
            Property="Background"
            Value="{ThemeResource ApplicationPageBackgroundThemeBrush}" />
    </Style>

    <Style
        x:Key="WwbHeaderSurfaceStyle"
        TargetType="Border">
        <Setter
            Property="Padding"
            Value="{StaticResource WwbHeaderPadding}" />
        <Setter
            Property="Background"
            Value="{ThemeResource ApplicationPageBackgroundThemeBrush}" />
        <Setter
            Property="BorderBrush"
            Value="{ThemeResource SurfaceStrokeColorDefaultBrush}" />
        <Setter
            Property="BorderThickness"
            Value="{ThemeResource WwbSurfaceBorderThickness}" />
    </Style>

    <Style
        x:Key="WwbCardSurfaceStyle"
        TargetType="Border">
        <Setter
            Property="Padding"
            Value="{StaticResource WwbCardPadding}" />
        <Setter
            Property="CornerRadius"
            Value="{StaticResource WwbCardCornerRadius}" />
        <Setter
            Property="Background"
            Value="{ThemeResource LayerFillColorDefaultBrush}" />
        <Setter
            Property="BorderBrush"
            Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter
            Property="BorderThickness"
            Value="{ThemeResource WwbSurfaceBorderThickness}" />
    </Style>

    <Style
        x:Key="WwbSecondarySurfaceStyle"
        TargetType="Border">
        <Setter
            Property="Padding"
            Value="{StaticResource WwbSurfacePadding}" />
        <Setter
            Property="CornerRadius"
            Value="{StaticResource WwbControlCornerRadius}" />
        <Setter
            Property="Background"
            Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        <Setter
            Property="BorderBrush"
            Value="{ThemeResource SurfaceStrokeColorDefaultBrush}" />
        <Setter
            Property="BorderThickness"
            Value="{ThemeResource WwbSurfaceBorderThickness}" />
    </Style>

    <Style
        x:Key="WwbStatusSurfaceStyle"
        TargetType="Border"
        BasedOn="{StaticResource WwbSecondarySurfaceStyle}">
        <Setter Property="Padding" Value="0" />
        <Setter
            Property="Background"
            Value="{ThemeResource SubtleFillColorTransparentBrush}" />
    </Style>

    <Style
        x:Key="WwbNoteOverflowSurfaceStyle"
        TargetType="Border"
        BasedOn="{StaticResource WwbSecondarySurfaceStyle}">
        <Setter Property="Padding" Value="6" />
        <Setter
            Property="Background"
            Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
    </Style>

    <Style
        x:Key="WwbCardRuntimeStatusSurfaceStyle"
        TargetType="Border"
        BasedOn="{StaticResource WwbSecondarySurfaceStyle}">
        <Setter Property="Padding" Value="6" />
        <Setter
            Property="Background"
            Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
    </Style>

    <Style
        x:Key="WwbCardRuntimeStatusTitleStyle"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter
            Property="Foreground"
            Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style
        x:Key="WwbCardRuntimeStatusSummaryStyle"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="17" />
        <Setter
            Property="Foreground"
            Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style
        x:Key="WwbCardRuntimeStatusFreshnessStyle"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="LineHeight" Value="16" />
        <Setter
            Property="Foreground"
            Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style
        x:Key="WwbCardRuntimeStatusCriticalIconStyle"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="MinWidth" Value="20" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter
            Property="Foreground"
            Value="{ThemeResource SystemFillColorCriticalBrush}" />
    </Style>

    <Style
        x:Key="WwbCardRuntimeStatusSkeletonBlockStyle"
        TargetType="Border">
        <Setter Property="Height" Value="12" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter
            Property="Background"
            Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
    </Style>

    <Style
        x:Key="WwbEditToolbarSurfaceStyle"
        TargetType="Border">
        <Setter
            Property="Padding"
            Value="{StaticResource WwbToolbarPadding}" />
        <Setter
            Property="CornerRadius"
            Value="{StaticResource WwbControlCornerRadius}" />
        <Setter
            Property="Background"
            Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
    </Style>

    <Style
        x:Key="WwbDragHandleStyle"
        TargetType="Border">
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="4" />
        <Setter
            Property="CornerRadius"
            Value="{StaticResource WwbSmallCornerRadius}" />
        <Setter
            Property="Background"
            Value="{ThemeResource SubtleFillColorTransparentBrush}" />
    </Style>

    <Style
        x:Key="WwbPanelTitleStyle"
        TargetType="TextBlock"
        BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="22" />
        <Setter
            Property="Foreground"
            Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style
        x:Key="WwbPanelMetaStyle"
        TargetType="TextBlock"
        BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="LineHeight" Value="16" />
        <Setter
            Property="Foreground"
            Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style
        x:Key="WwbPanelContextStyle"
        TargetType="TextBlock"
        BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="LineHeight" Value="14" />
        <Setter
            Property="Foreground"
            Value="{ThemeResource TextFillColorTertiaryBrush}" />
    </Style>

    <Style
        x:Key="WwbCardTitleStyle"
        TargetType="TextBlock"
        BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="18" />
        <Setter
            Property="Foreground"
            Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style
        x:Key="WwbCardBodyStyle"
        TargetType="TextBlock"
        BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="17" />
        <Setter
            Property="Foreground"
            Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style
        x:Key="WwbWeatherTemperatureStyle"
        TargetType="TextBlock"
        BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="32" />
        <Setter
            Property="Foreground"
            Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style
        x:Key="WwbCardCaptionStyle"
        TargetType="TextBlock"
        BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="LineHeight" Value="16" />
        <Setter
            Property="Foreground"
            Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style
        x:Key="WwbSearchResultTitleStyle"
        TargetType="TextBlock"
        BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="18" />
        <Setter
            Property="Foreground"
            Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style
        x:Key="WwbSearchResultPreviewStyle"
        TargetType="TextBlock"
        BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="LineHeight" Value="16" />
        <Setter
            Property="Foreground"
            Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style
        x:Key="WwbToolbarButtonStyle"
        TargetType="Button"
        BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
        <Setter
            Property="CornerRadius"
            Value="{StaticResource WwbControlCornerRadius}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style
        x:Key="WwbPrimaryToolbarButtonStyle"
        TargetType="Button"
        BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
        <Setter
            Property="CornerRadius"
            Value="{StaticResource WwbControlCornerRadius}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style
        x:Key="WwbCardIconButtonStyle"
        TargetType="Button"
        BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
        <Setter Property="FontSize" Value="13" />
        <Setter
            Property="BorderThickness"
            Value="{StaticResource WwbSurfaceBorderThickness}" />
        <Setter
            Property="CornerRadius"
            Value="{StaticResource WwbSmallCornerRadius}" />
        <Setter
            Property="Background"
            Value="{ThemeResource SubtleFillColorTransparentBrush}" />
    </Style>

    <Style
        x:Key="WwbCardActionButtonStyle"
        TargetType="Button"
        BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="8,4" />
        <Setter
            Property="CornerRadius"
            Value="{StaticResource WwbSmallCornerRadius}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style
        x:Key="WwbNoteUtilityButtonStyle"
        TargetType="Button"
        BasedOn="{StaticResource WwbCardActionButtonStyle}">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style
        x:Key="WwbEditActionButtonStyle"
        TargetType="Button"
        BasedOn="{StaticResource WwbCardActionButtonStyle}">
        <Setter Property="MinWidth" Value="32" />
    </Style>

    <Style
        x:Key="WwbDestructiveActionButtonStyle"
        TargetType="Button"
        BasedOn="{StaticResource WwbEditActionButtonStyle}">
        <Setter
            Property="Foreground"
            Value="{ThemeResource SystemFillColorCriticalBrush}" />
    </Style>

    <Style
        x:Key="WwbSearchResultButtonStyle"
        TargetType="Button"
        BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="10,6" />
        <Setter
            Property="CornerRadius"
            Value="{StaticResource WwbSmallCornerRadius}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <Style
        x:Key="WwbSearchBoxStyle"
        TargetType="TextBox"
        BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,4" />
        <Setter
            Property="CornerRadius"
            Value="{StaticResource WwbControlCornerRadius}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style
        x:Key="WwbNoteTitleTextBoxStyle"
        TargetType="TextBox"
        BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="0,2" />
        <Setter
            Property="Background"
            Value="{ThemeResource SubtleFillColorTransparentBrush}" />
        <Setter
            Property="BorderThickness"
            Value="{StaticResource WwbSurfaceBorderThickness}" />
        <Setter
            Property="CornerRadius"
            Value="{StaticResource WwbSmallCornerRadius}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style
        x:Key="WwbNoteBodyTextBoxStyle"
        TargetType="TextBox"
        BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="Padding" Value="0,4" />
        <Setter
            Property="Background"
            Value="{ThemeResource SubtleFillColorTransparentBrush}" />
        <Setter
            Property="BorderThickness"
            Value="{StaticResource WwbSurfaceBorderThickness}" />
        <Setter
            Property="CornerRadius"
            Value="{StaticResource WwbSmallCornerRadius}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style
        x:Key="WwbModeCheckBoxStyle"
        TargetType="CheckBox"
        BasedOn="{StaticResource DefaultCheckBoxStyle}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
