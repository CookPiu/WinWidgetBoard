    <!--
        Text buttons for dialog surfaces. Kept separate from the toolbar pair on purpose: those
        set Segoe Fluent Icons and zero padding because their content is a single glyph, and a
        word rendered in an icon font comes out as tofu. A settings dialog commits with words.
    -->
    <Style
        x:Key="WwbDialogButtonStyle"
        TargetType="Button"
        BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="12,4" />
        <Setter
            Property="CornerRadius"
            Value="{StaticResource WwbControlCornerRadius}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!--
        The dialog's close button. ContentDialog gives its single command the whole command
        bar, and a full-width "Close" is the heaviest thing on a sheet whose job is to get
        out of the way. The template sets HorizontalAlignment locally, so a style cannot
        realign the button - but MaxWidth is unset there, and capping it leaves a normal-width
        button centred in the bar.
    -->
    <Style
        x:Key="WwbDialogCloseButtonStyle"
        TargetType="Button"
        BasedOn="{StaticResource WwbDialogButtonStyle}">
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="MaxWidth" Value="160" />
    </Style>

    <Style
        x:Key="WwbPrimaryDialogButtonStyle"
        TargetType="Button"
        BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="12,4" />
        <Setter
            Property="CornerRadius"
