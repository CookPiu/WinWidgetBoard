<controls:ContentDialog
    x:Class="WinWidgetBoard.WorkspacePanel.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    xmlns:settings="using:WinWidgetBoard.WorkspacePanel.Settings"
    x:Uid="SettingsDialog"
    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
    BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
    BorderThickness="{ThemeResource WwbFlyoutBorderThickness}"
    CornerRadius="{StaticResource WwbPanelCornerRadius}"
    CloseButtonStyle="{StaticResource WwbDialogCloseButtonStyle}"
    DefaultButton="None">
    <controls:ContentDialog.TitleTemplate>
        <DataTemplate>
            <TextBlock
                Style="{StaticResource WwbPanelTitleStyle}"
                Text="{Binding}"
                TextWrapping="NoWrap" />
        </DataTemplate>
    </controls:ContentDialog.TitleTemplate>

    <controls:ContentDialog.Resources>
        <!--
            The dialog's outer radius is drawn by its own template from OverlayCornerRadius,
            not from the CornerRadius set on the control, so the sheet kept the system's
            8-DIP corner while every surface inside it used the panel's 16.
        -->
        <CornerRadius x:Key="OverlayCornerRadius">16</CornerRadius>
        <!--
            The dialog's width is clamped by this template resource, NOT by MaxWidth on the
            control - the default is 548, and everything wider was silently clipped at the
            card's rounded edge. That clip is what ate the trailing buttons: 132 rail + 16
            gap + 440 scroll lane + card padding + dialog padding needs the full 672.
        -->
        <x:Double x:Key="ContentDialogMaxWidth">672</x:Double>
        <!--
            One row template serves both metric lists. Every automation ID carries the surface
            it belongs to, because the same twelve metrics appear twice and a script has to be
            able to say which copy it means.
        -->
        <DataTemplate
            x:Key="SysMonMetricOptionTemplate"
            x:DataType="settings:SystemMonitorMetricOption">
            <Grid
                ColumnSpacing="{StaticResource WwbSpace1}"
                Padding="0,2">
                <!--
                    Every column is stated. A star column here measures against infinity and
                    arranges trailing content past the list's right edge, which is the same
                    clip that once hid the weather search button.

                    Order is changed by dragging the row - the list reorders its own source -
                    so the gripper is an affordance, not a control: it says "this row moves"
                    without costing a pair of buttons per row.
                -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="144" />
                    <ColumnDefinition Width="168" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    FontSize="10"
                    Glyph="&#xE76F;"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    automation:AutomationProperties.AccessibilityView="Raw" />
                <CheckBox
                    Grid.Column="1"
                    Content="{x:Bind DisplayName}"
                    IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                    MinWidth="0"
                    automation:AutomationProperties.Name="{x:Bind DisplayName}"
                    automation:AutomationProperties.AutomationId="{x:Bind IncludeAutomationId}" />
                <ComboBox
                    Grid.Column="2"
                    MinWidth="0"
                    FontSize="12"
                    ItemsSource="{x:Bind DetailOptions}"
                    DisplayMemberPath="DisplayName"
                    SelectedIndex="{x:Bind DetailIndex, Mode=TwoWay}"
                    automation:AutomationProperties.Name="{x:Bind DisplayName}"
                    automation:AutomationProperties.AutomationId="{x:Bind DetailAutomationId}" />
            </Grid>
        </DataTemplate>
        <!-- One row shape for both place lists: a preset and a search hit are the same
             thing to everything downstream, so they must not look like two kinds of item. -->
        <DataTemplate
            x:Key="WeatherLocationOptionTemplate"
            x:DataType="settings:WeatherLocationOption">
            <StackPanel Padding="0,4">
                <TextBlock
                    Style="{StaticResource WwbCardBodyStyle}"
                    Text="{x:Bind Label}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Style="{StaticResource WwbCardCaptionStyle}"
                    Text="{x:Bind Description}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{x:Bind HasDescription}" />
            </StackPanel>
        </DataTemplate>
    </controls:ContentDialog.Resources>

    <!--
        One settings surface for every card. The categories are a rail rather than a stack of
        expanders: each card's settings are a page's worth of controls, and stacking them all
        would put the hardware metric lists a scroll away from their own heading.
    -->
    <Grid ColumnSpacing="{StaticResource WwbSpace4}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--
            The rail sits on the same layered surface a card does, so the sheet reads as
            part of the board rather than as a system dialog that happens to be in front
            of it.
        -->
        <Border
            VerticalAlignment="Top"
            Style="{StaticResource WwbSecondarySurfaceStyle}">
            <ListView
                x:Name="SettingsCategoryList"
                Width="132"
                Padding="0"
                Background="Transparent"
                SelectionMode="Single"
                SelectionChanged="SettingsCategoryList_SelectionChanged"
                automation:AutomationProperties.AutomationId="SettingsCategoryList">
                <ListViewItem
                    x:Uid="SettingsCategoryGeneral"
                    automation:AutomationProperties.AutomationId="SettingsCategoryGeneral" />
                <ListViewItem
                    x:Uid="SettingsCategoryTaskbarEntry"
                    automation:AutomationProperties.AutomationId="SettingsCategoryTaskbarEntry" />
                <ListViewItem
                    x:Uid="SettingsCategoryWeather"
                    automation:AutomationProperties.AutomationId="SettingsCategoryWeather" />
                <ListViewItem
                    x:Uid="SettingsCategorySystemMonitor"
                    automation:AutomationProperties.AutomationId="SettingsCategorySystemMonitor" />
                <ListViewItem
                    x:Uid="SettingsCategoryTokenUsage"
                    automation:AutomationProperties.AutomationId="SettingsCategoryTokenUsage" />
            </ListView>
        </Border>

        <!--
            One card per view: the scrollable body and the pinned commit row live on the SAME
            surface. They used to be two stacked cards, which produced two defects at once -
            the body card rendered as a stray empty bar for any section that (wrongly) lived
            in the footer card, and the commit controls read as a separate, unrelated card.
        -->
        <!--
            The body is the ONLY scroll region. A save button that scrolls out of reach is
            the same defect as one that is clipped, so the commit row is pinned below the
            ScrollViewer rather than placed last inside it.
        -->
        <Border
            Grid.Column="1"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Style="{StaticResource WwbCardSurfaceStyle}">
        <Grid RowSpacing="{StaticResource WwbSpace3}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!--
                    The commit row reserves its height even for a category that has none, so
                    switching to General does not pull the sheet's bottom edge up by a button.
                -->
                <RowDefinition Height="Auto" MinHeight="32" />
            </Grid.RowDefinitions>
            <!--
                Height, not MaxHeight. With a maximum, every category sized the sheet to its
                own content: picking General after Hardware collapsed the dialog by most of
                its height, and the rail the pointer was aiming at moved out from under it.
                A settings sheet is a fixed frame with changing content, so the frame is
                stated once here and the content scrolls inside it. This is also what makes
                the section transition legible - nothing can be crossfading and resizing at
                the same time.
            -->
            <ScrollViewer
                Width="440"
                HorizontalAlignment="Left"
                Height="400"
                HorizontalScrollMode="Disabled"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <!--
                    Width, not MaxWidth, and stated here rather than on each section. Inside a
                    ContentDialog the content is measured unbounded; MaxWidth only clamps the
                    result, so a star column still measures its first child against infinity
                    and arranges the Auto column past the clip. One bounded container makes
                    every grid below it resolve correctly - which is also what lets the rows
                    below use star columns safely. The 24 DIP between this width and the
                    grid's is the scrollbar's lane: the overlay bar must never sit on top of
                    a trailing button again. Both widths fit inside ContentDialogMaxWidth
                    above - grow them only together with it.
                -->
                <Grid Width="416" HorizontalAlignment="Left">
                <!--
                    The application's own settings, not a card's. This section has no commit
                    row: the switch asks the shell to add or remove a shortcut, which either
                    happened or did not, and the line under it says which.
                -->
                <StackPanel
                    x:Name="GeneralSection"
                    Spacing="{StaticResource WwbSpace3}"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Uid="GeneralSettingsDescription"
                        Style="{StaticResource WwbCardCaptionStyle}"
                        TextWrapping="Wrap" />
                    <ToggleSwitch
                        x:Name="GeneralAutostartToggle"
                        x:Uid="GeneralAutostartToggle"
                        IsEnabled="{x:Bind GeneralViewModel.IsAutostartAvailable}"
                        IsOn="{x:Bind GeneralViewModel.IsAutostartEnabled, Mode=TwoWay}"
                        automation:AutomationProperties.AutomationId="GeneralAutostartToggle" />
                    <TextBlock
                        x:Name="GeneralSettingsStatusText"
                        Style="{StaticResource WwbCardCaptionStyle}"
                        Text="{x:Bind GeneralViewModel.StatusText, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind GeneralViewModel.HasStatusText, Mode=OneWay}"
                        automation:AutomationProperties.AutomationId="GeneralSettingsStatusText" />
                    <!--
                        The panel shortcut is registered by the taskbar entry, which owns both
                        the chord and the window it opens; this line only tells the reader
                        where the switch for it is, rather than mirroring a setting that lives
                        in another process.
                    -->
                    <TextBlock
                        x:Uid="GeneralHotkeyHint"
                        Style="{StaticResource WwbCardCaptionStyle}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Style="{StaticResource WwbCardCaptionStyle}"
                        Text="{x:Bind GeneralViewModel.VersionText}"
                        automation:AutomationProperties.AutomationId="GeneralVersionText" />
                </StackPanel>

                <!--
                    The taskbar entry's settings, moved here from the entry's own context
                    menu so the product is configured in one place. Everything applies
                    immediately - the launcher watches the same HKCU key these write - so,
                    like General, this section has no commit row.
                -->
                <StackPanel
                    x:Name="TaskbarEntrySection"
                    Spacing="{StaticResource WwbSpace3}"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Uid="EntrySettingsDescription"
                        Style="{StaticResource WwbCardCaptionStyle}"
                        TextWrapping="Wrap" />
                    <ComboBox
                        x:Name="EntryContentModeBox"
                        x:Uid="EntryContentModeBox"
                        Width="292"
                        HorizontalAlignment="Left"
                        FontSize="12"
                        SelectedIndex="{x:Bind EntryViewModel.ContentModeIndex, Mode=TwoWay}"
                        automation:AutomationProperties.AutomationId="EntryContentModeBox">
                        <ComboBoxItem x:Uid="EntryContentDateTimeItem" />
                        <ComboBoxItem x:Uid="EntryContentWeatherItem" />
                    </ComboBox>
                    <ToggleSwitch
                        x:Uid="EntryShowMonitorToggle"
                        IsOn="{x:Bind EntryViewModel.ShowSystemMonitor, Mode=TwoWay}"
                        automation:AutomationProperties.AutomationId="EntryShowMonitorToggle" />
                    <ComboBox
                        x:Name="EntryPlacementBox"
                        x:Uid="EntryPlacementBox"
                        Width="292"
                        HorizontalAlignment="Left"
                        FontSize="12"
                        SelectedIndex="{x:Bind EntryViewModel.PlacementIndex, Mode=TwoWay}"
                        automation:AutomationProperties.AutomationId="EntryPlacementBox">
                        <ComboBoxItem x:Uid="EntryPlacementLeftItem" />
                        <ComboBoxItem x:Uid="EntryPlacementCenterItem" />
                        <ComboBoxItem x:Uid="EntryPlacementRightItem" />
                        <ComboBoxItem x:Uid="EntryPlacementFloatingItem" />
                    </ComboBox>
                    <ComboBox
                        x:Name="EntryFallbackBox"
                        x:Uid="EntryFallbackBox"
                        Width="292"
                        HorizontalAlignment="Left"
                        FontSize="12"
                        SelectedIndex="{x:Bind EntryViewModel.LeftAlignFallbackIndex, Mode=TwoWay}"
                        automation:AutomationProperties.AutomationId="EntryFallbackBox">
                        <ComboBoxItem x:Uid="EntryFallbackFloatingItem" />
                        <ComboBoxItem x:Uid="EntryFallbackCenterItem" />
                        <ComboBoxItem x:Uid="EntryFallbackRightItem" />
                    </ComboBox>
                    <ComboBox
                        x:Name="EntryHotkeyModeBox"
                        x:Uid="EntryHotkeyModeBox"
                        Width="292"
                        HorizontalAlignment="Left"
                        FontSize="12"
                        SelectedIndex="{x:Bind EntryViewModel.HotkeyModeIndex, Mode=TwoWay}"
                        SelectionChanged="EntryHotkeyModeBox_SelectionChanged"
                        automation:AutomationProperties.AutomationId="EntryHotkeyModeBox">
                        <ComboBoxItem x:Uid="EntryHotkeyDisabledItem" />
                        <ComboBoxItem Content="Ctrl + Alt + B" />
                        <ComboBoxItem Content="Ctrl + Alt + D" />
                        <ComboBoxItem Content="Ctrl + Alt + Q" />
                        <ComboBoxItem x:Uid="EntryHotkeyCustomItem" />
                    </ComboBox>
                    <!--
                        The recorder. A read-only box that turns the next key press - with
                        whatever Ctrl/Alt/Shift are held - into the chord; the launcher is
                        the process that registers it, and its write-back is what reports a
                        chord another program already owns.
                    -->
                    <TextBox
                        x:Name="EntryHotkeyCaptureBox"
                        x:Uid="EntryHotkeyCaptureBox"
                        Width="292"
                        HorizontalAlignment="Left"
                        IsReadOnly="True"
                        Text="{x:Bind EntryViewModel.CustomHotkeyText, Mode=OneWay}"
                        KeyDown="EntryHotkeyCaptureBox_KeyDown"
                        Visibility="{x:Bind EntryViewModel.IsCustomHotkey, Mode=OneWay}"
                        automation:AutomationProperties.AutomationId="EntryHotkeyCaptureBox" />
                    <TextBlock
                        Style="{StaticResource WwbCardCaptionStyle}"
                        Text="{x:Bind EntryViewModel.StatusText, Mode=OneWay}"
                        TextWrapping="Wrap"
                        automation:AutomationProperties.AutomationId="EntrySettingsStatusText" />
                </StackPanel>

                <StackPanel
                    x:Name="WeatherSection"
                    Spacing="{StaticResource WwbSpace3}">
                    <TextBlock
                        x:Uid="WeatherSettingsDescription"
                        Style="{StaticResource WwbCardCaptionStyle}"
                        TextWrapping="Wrap" />

                    <!--
                        Star plus Auto, not stated widths: the bounded 416 grid above makes
                        this measure finite, so the button can never be arranged past the
                        clip the way the fixed 220+116 pair was.
                    -->
                    <Grid ColumnSpacing="{StaticResource WwbSpace2}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ToggleSwitch
                            x:Name="WeatherSettingsUseDeviceLocationToggle"
                            x:Uid="WeatherSettingsUseDeviceLocationToggle"
                            IsOn="{x:Bind WeatherViewModel.UseDeviceLocation, Mode=TwoWay}"
                            automation:AutomationProperties.AutomationId="WeatherSettingsUseDeviceLocationToggle" />
                        <Button
                            x:Name="WeatherSettingsDeviceLocationButton"
                            x:Uid="WeatherSettingsDeviceLocationButton"
                            Grid.Column="1"
                            MinWidth="96"
                            VerticalAlignment="Bottom"
                            Style="{StaticResource WwbDialogButtonStyle}"
                            IsEnabled="{x:Bind WeatherViewModel.CanRefreshDeviceLocation, Mode=OneWay}"
                            Click="WeatherSettingsDeviceLocationButton_Click"
                            automation:AutomationProperties.AutomationId="WeatherSettingsDeviceLocationButton" />
                    </Grid>

                    <ProgressBar
                        x:Name="WeatherSettingsDeviceLocationProgress"
                        IsIndeterminate="True"
                        Visibility="{x:Bind WeatherViewModel.IsLocating, Mode=OneWay}" />

                    <HyperlinkButton
                        x:Name="WeatherSettingsLocationPrivacyLink"
                        x:Uid="WeatherSettingsLocationPrivacyLink"
                        Padding="0"
                        HorizontalAlignment="Left"
                        NavigateUri="ms-settings:privacy-location"
                        automation:AutomationProperties.AutomationId="WeatherSettingsLocationPrivacyLink" />

                    <!--
                        A binary display choice, so a toggle rather than a two-item list. The
                        unit glyphs (°C, km/h, °F, mph) are language-independent and live in
                        the localized header/on/off strings.
                    -->
                    <ToggleSwitch
                        x:Name="WeatherSettingsImperialUnitsToggle"
                        x:Uid="WeatherSettingsImperialUnitsToggle"
                        IsOn="{x:Bind WeatherViewModel.UseImperialUnits, Mode=TwoWay}"
                        automation:AutomationProperties.AutomationId="WeatherSettingsImperialUnitsToggle" />

                    <!--
                        Search replaces hand-typed coordinates. The user names a place; the
                        coordinates come back from the search and are shown read-only below,
                        so what will be saved is visible without being editable.
                    -->
                    <Grid ColumnSpacing="{StaticResource WwbSpace2}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="WeatherSettingsSearchBox"
                            x:Uid="WeatherSettingsSearchBox"
                            Style="{StaticResource WwbSearchBoxStyle}"
                            Text="{x:Bind WeatherViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            KeyDown="WeatherSettingsSearchBox_KeyDown"
                            automation:AutomationProperties.AutomationId="WeatherSettingsSearchBox" />
                        <Button
                            x:Name="WeatherSettingsSearchButton"
                            x:Uid="WeatherSettingsSearchButton"
                            Grid.Column="1"
                            MinWidth="72"
                            VerticalAlignment="Bottom"
                            Style="{StaticResource WwbDialogButtonStyle}"
                            IsEnabled="{x:Bind WeatherViewModel.CanSearch, Mode=OneWay}"
                            Click="WeatherSettingsSearchButton_Click"
                            automation:AutomationProperties.AutomationId="WeatherSettingsSearchButton" />
                    </Grid>

                    <ProgressBar
                        x:Name="WeatherSettingsSearchProgress"
                        IsIndeterminate="True"
                        Visibility="{x:Bind WeatherViewModel.IsSearching, Mode=OneWay}" />

                    <!--
                        The two lists never show at once. Results answer a question the user
                        just asked; leaving the common places under them would put a second,
                        unrelated set of cities one scroll below the answer.
                    -->
                    <TextBlock
                        x:Uid="WeatherSettingsCommonHeader"
                        Style="{StaticResource WwbCardTitleStyle}"
                        Visibility="{x:Bind WeatherViewModel.ShowCommonLocations, Mode=OneWay}" />
                    <ListView
                        x:Name="WeatherSettingsCommonList"
                        Padding="0"
                        Background="Transparent"
                        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource WwbControlCornerRadius}"
                        x:Uid="WeatherSettingsCommonList"
                        MaxHeight="212"
                        SelectionMode="Single"
                        ItemsSource="{x:Bind WeatherViewModel.CommonLocations}"
                        ItemTemplate="{StaticResource WeatherLocationOptionTemplate}"
                        SelectionChanged="WeatherSettingsResultsList_SelectionChanged"
                        Visibility="{x:Bind WeatherViewModel.ShowCommonLocations, Mode=OneWay}"
                        automation:AutomationProperties.AutomationId="WeatherSettingsCommonList" />

                    <TextBlock
                        x:Uid="WeatherSettingsResultsHeader"
                        Style="{StaticResource WwbCardTitleStyle}"
                        Visibility="{x:Bind WeatherViewModel.ShowSearchResults, Mode=OneWay}" />
                    <ListView
                        x:Name="WeatherSettingsResultsList"
                        Padding="0"
                        Background="Transparent"
                        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource WwbControlCornerRadius}"
                        x:Uid="WeatherSettingsResultsList"
                        MaxHeight="212"
                        SelectionMode="Single"
                        ItemsSource="{x:Bind WeatherViewModel.SearchResults, Mode=OneWay}"
                        ItemTemplate="{StaticResource WeatherLocationOptionTemplate}"
                        SelectionChanged="WeatherSettingsResultsList_SelectionChanged"
                        Visibility="{x:Bind WeatherViewModel.ShowSearchResults, Mode=OneWay}"
                        automation:AutomationProperties.AutomationId="WeatherSettingsResultsList" />

                    <!--
                        What will be saved, shown as content rather than pinned: only the
                        commit action itself needs to stay reachable without scrolling. The
                        coordinates stay visible but read-only - they are what actually gets
                        stored and sent to the weather provider, and hiding them would make
                        that invisible.
                    -->
                    <TextBox
                        x:Name="WeatherSettingsLabelBox"
                        x:Uid="WeatherSettingsLabelBox"
                        Text="{x:Bind WeatherViewModel.LocationLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        automation:AutomationProperties.AutomationId="WeatherSettingsLabelBox" />
                    <TextBox
                        x:Name="WeatherSettingsCoordinatesBox"
                        x:Uid="WeatherSettingsCoordinatesBox"
                        IsReadOnly="True"
                        Text="{x:Bind WeatherViewModel.CoordinatesText, Mode=OneWay}"
                        automation:AutomationProperties.AutomationId="WeatherSettingsCoordinatesBox" />
                </StackPanel>

                <StackPanel
                    x:Name="SystemMonitorSection"
                    Spacing="{StaticResource WwbSpace3}"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Uid="SysMonSettingsDescription"
                        Style="{StaticResource WwbCardCaptionStyle}"
                        TextWrapping="Wrap" />
                    <!--
                        Temperature and fan readings come from an optional sensor source; the
                        card silently omits those rows when no source is running, so the one
                        place that explains the requirement is here, next to the lists that
                        let the user enable them.
                    -->
                    <TextBlock
                        x:Uid="SysMonSensorSourceHint"
                        Style="{StaticResource WwbCardCaptionStyle}"
                        TextWrapping="Wrap" />

                    <!--
                        Collapsed by default: each list is eight rows, and two of them open
                        put the network source and the save state two screens down. Rows are
                        reordered by dragging - the ListView reorders the same observable
                        collection the save reads - so the lists carry no per-row buttons.

                        The lists do not scroll themselves: the section's ScrollViewer is the
                        one scroll region. A nested MaxHeight used to cut a row in half and
                        stack a second scrollbar inside the first.
                    -->
                    <Expander
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        automation:AutomationProperties.AutomationId="SysMonCardExpander">
                        <Expander.Header>
                            <TextBlock
                                x:Uid="SysMonCardSectionHeader"
                                Style="{StaticResource WwbCardTitleStyle}" />
                        </Expander.Header>
                        <ListView
                            x:Name="SysMonCardList"
                            Padding="4,2"
                            Background="Transparent"
                            AllowDrop="True"
                            CanDragItems="True"
                            CanReorderItems="True"
                            ScrollViewer.HorizontalScrollMode="Disabled"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollMode="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Hidden"
                            SelectionMode="None"
                            ItemsSource="{x:Bind SystemMonitorViewModel.CardOptions, Mode=OneWay}"
                            ItemTemplate="{StaticResource SysMonMetricOptionTemplate}"
                            automation:AutomationProperties.AutomationId="SysMonCardList" />
                    </Expander>

                    <!--
                        The network source sits with the metric lists rather than in its own
                        section: it changes what the up and down rows mean, and a reading and
                        the thing it is measured from should not be a category apart.
                    -->
                    <TextBlock
                        x:Uid="SysMonNetworkSectionHeader"
                        Style="{StaticResource WwbCardTitleStyle}" />
                    <ComboBox
                        x:Name="SysMonNetworkInterfaceBox"
                        x:Uid="SysMonNetworkInterfaceBox"
                        Width="292"
                        HorizontalAlignment="Left"
                        FontSize="12"
                        ItemsSource="{x:Bind SystemMonitorViewModel.NetworkOptions, Mode=OneWay}"
                        DisplayMemberPath="DisplayName"
                        SelectedIndex="{x:Bind SystemMonitorViewModel.SelectedNetworkIndex, Mode=TwoWay}"
                        automation:AutomationProperties.AutomationId="SysMonNetworkInterfaceBox" />

                    <Expander
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        automation:AutomationProperties.AutomationId="SysMonEntryExpander">
                        <Expander.Header>
                            <TextBlock
                                x:Uid="SysMonEntrySectionHeader"
                                Style="{StaticResource WwbCardTitleStyle}" />
                        </Expander.Header>
                        <ListView
                            x:Name="SysMonEntryList"
                            Padding="4,2"
                            Background="Transparent"
                            AllowDrop="True"
                            CanDragItems="True"
                            CanReorderItems="True"
                            ScrollViewer.HorizontalScrollMode="Disabled"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollMode="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Hidden"
                            SelectionMode="None"
                            ItemsSource="{x:Bind SystemMonitorViewModel.EntryOptions, Mode=OneWay}"
                            ItemTemplate="{StaticResource SysMonMetricOptionTemplate}"
                            automation:AutomationProperties.AutomationId="SysMonEntryList" />
                    </Expander>

                    <TextBlock
                        x:Name="SysMonSettingsValidationText"
                        Style="{StaticResource WwbCardCaptionStyle}"
                        Text="{x:Bind SystemMonitorViewModel.ValidationText, Mode=OneWay}"
                        TextWrapping="Wrap"
                        automation:AutomationProperties.AutomationId="SysMonSettingsValidationText" />

                </StackPanel>

                <StackPanel
                    x:Name="TokenUsageSection"
                    Spacing="{StaticResource WwbSpace3}"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Uid="TokenUsageSettingsDescription"
                        Style="{StaticResource WwbCardCaptionStyle}"
                        TextWrapping="Wrap" />
                    <ItemsControl
                        ItemsSource="{x:Bind TokenUsageViewModel.Vendors}"
                        automation:AutomationProperties.AutomationId="TokenUsageVendorList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="settings:TokenUsageVendorOption">
                                <Grid Padding="0,4" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox
                                        Content="{x:Bind DisplayName}"
                                        IsChecked="{x:Bind IsEnabled, Mode=TwoWay}"
                                        automation:AutomationProperties.Name="{x:Bind DisplayName}" />
                                    <!--
                                        A vendor with nothing on this machine stays switchable:
                                        installing it later should just start counting. The row
                                        says so rather than looking like a silent failure.
                                    -->
                                    <TextBlock
                                        x:Uid="TokenUsageVendorUnavailable"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource WwbCardCaptionStyle}"
                                        Visibility="{x:Bind IsUnavailableVisible, Mode=OneWay}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                </Grid>
            </ScrollViewer>

            <!--
                One commit row per view, pinned under the scroll region on the same card.
                The button does not own the row: the status and validation lines sit beside
                it, so a save's outcome appears where the eye already is.
            -->
            <Grid
                x:Name="WeatherFooter"
                Grid.Row="1"
                Width="440"
                HorizontalAlignment="Left"
                ColumnSpacing="{StaticResource WwbSpace3}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="WeatherSettingsSaveButton"
                    x:Uid="WeatherSettingsSaveButton"
                    VerticalAlignment="Top"
                    Style="{StaticResource WwbPrimaryDialogButtonStyle}"
                    IsEnabled="{x:Bind WeatherViewModel.CanSave, Mode=OneWay}"
                    Click="WeatherSettingsSaveButton_Click" />
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="{StaticResource WwbSpace1}">
                    <TextBlock
                        x:Name="WeatherSettingsValidationText"
                        Style="{StaticResource WwbCardCaptionStyle}"
                        Text="{x:Bind WeatherViewModel.ValidationText, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind WeatherViewModel.HasValidationText, Mode=OneWay}"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    <TextBlock
                        x:Name="WeatherSettingsStatusText"
                        Style="{StaticResource WwbCardCaptionStyle}"
                        Text="{x:Bind WeatherViewModel.StatusText, Mode=OneWay}"
                        TextWrapping="Wrap"
                        automation:AutomationProperties.AutomationId="WeatherSettingsStatusText" />
                </StackPanel>
            </Grid>

            <Grid
                x:Name="SystemMonitorFooter"
                Grid.Row="1"
                Width="440"
                HorizontalAlignment="Left"
                ColumnSpacing="{StaticResource WwbSpace3}"
                Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="SysMonSettingsSaveButton"
                    x:Uid="SysMonSettingsSaveButton"
                    VerticalAlignment="Top"
                    Style="{StaticResource WwbPrimaryDialogButtonStyle}"
                    IsEnabled="{x:Bind SystemMonitorViewModel.CanSave, Mode=OneWay}"
                    Click="SysMonSettingsSaveButton_Click"
                    automation:AutomationProperties.AutomationId="SysMonSettingsSaveButton" />
                <TextBlock
                    x:Name="SysMonSettingsStatusText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource WwbCardCaptionStyle}"
                    Text="{x:Bind SystemMonitorViewModel.StatusText, Mode=OneWay}"
                    TextWrapping="Wrap"
                    automation:AutomationProperties.AutomationId="SysMonSettingsStatusText" />
            </Grid>

            <Grid
                x:Name="TokenUsageFooter"
                Grid.Row="1"
                Width="440"
                HorizontalAlignment="Left"
                ColumnSpacing="{StaticResource WwbSpace3}"
                Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="TokenUsageSettingsSaveButton"
                    x:Uid="TokenUsageSettingsSaveButton"
                    VerticalAlignment="Top"
                    Style="{StaticResource WwbPrimaryDialogButtonStyle}"
                    IsEnabled="{x:Bind TokenUsageViewModel.CanSave, Mode=OneWay}"
                    Click="TokenUsageSettingsSaveButton_Click"
                    automation:AutomationProperties.AutomationId="TokenUsageSettingsSaveButton" />
                <TextBlock
                    x:Name="TokenUsageSettingsStatusText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource WwbCardCaptionStyle}"
                    Text="{x:Bind TokenUsageViewModel.StatusText, Mode=OneWay}"
                    TextWrapping="Wrap"
                    automation:AutomationProperties.AutomationId="TokenUsageSettingsStatusText" />
            </Grid>
        </Grid>
        </Border>
    </Grid>
</controls:ContentDialog>
