<controls:ContentDialog
    x:Class="WinWidgetBoard.WorkspacePanel.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    xmlns:settings="using:WinWidgetBoard.WorkspacePanel.Settings"
    x:Uid="SettingsDialog"
    DefaultButton="Close"
    MaxWidth="760">
    <controls:ContentDialog.Resources>
        <!--
            One row template serves both metric lists. Every automation ID carries the surface
            it belongs to, because the same twelve metrics appear twice and a script has to be
            able to say which copy it means.
        -->
        <DataTemplate
            x:Key="SysMonMetricOptionTemplate"
            x:DataType="settings:SystemMonitorMetricOption">
            <Grid
                ColumnSpacing="8"
                Padding="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox
                    Content="{x:Bind DisplayName}"
                    IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                    MinWidth="0"
                    automation:AutomationProperties.Name="{x:Bind DisplayName}"
                    automation:AutomationProperties.AutomationId="{x:Bind IncludeAutomationId}" />
                <ComboBox
                    Grid.Column="1"
                    MinWidth="132"
                    ItemsSource="{x:Bind DetailOptions}"
                    DisplayMemberPath="DisplayName"
                    SelectedIndex="{x:Bind DetailIndex, Mode=TwoWay}"
                    automation:AutomationProperties.Name="{x:Bind DisplayName}"
                    automation:AutomationProperties.AutomationId="{x:Bind DetailAutomationId}" />
                <Button
                    x:Uid="SysMonMoveUpButton"
                    Grid.Column="2"
                    Style="{StaticResource WwbCardIconButtonStyle}"
                    Tag="{x:Bind MetricId}"
                    Click="MoveUpButton_Click"
                    automation:AutomationProperties.AutomationId="{x:Bind MoveUpAutomationId}">
                    <FontIcon FontSize="12" Glyph="&#xE74A;" />
                </Button>
                <Button
                    x:Uid="SysMonMoveDownButton"
                    Grid.Column="3"
                    Style="{StaticResource WwbCardIconButtonStyle}"
                    Tag="{x:Bind MetricId}"
                    Click="MoveDownButton_Click"
                    automation:AutomationProperties.AutomationId="{x:Bind MoveDownAutomationId}">
                    <FontIcon FontSize="12" Glyph="&#xE74B;" />
                </Button>
            </Grid>
        </DataTemplate>
    </controls:ContentDialog.Resources>

    <!--
        One settings surface for every card. The categories are a rail rather than a stack of
        expanders: each card's settings are a page's worth of controls, and stacking them all
        would put the hardware metric lists a scroll away from their own heading.
    -->
    <Grid ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ListView
            x:Name="SettingsCategoryList"
            Width="148"
            SelectionMode="Single"
            SelectionChanged="SettingsCategoryList_SelectionChanged"
            automation:AutomationProperties.AutomationId="SettingsCategoryList">
            <ListViewItem
                x:Uid="SettingsCategoryWeather"
                automation:AutomationProperties.AutomationId="SettingsCategoryWeather" />
            <ListViewItem
                x:Uid="SettingsCategorySystemMonitor"
                automation:AutomationProperties.AutomationId="SettingsCategorySystemMonitor" />
        </ListView>

        <!--
            The section width is stated, not inherited from a star column. Inside a
            ContentDialog the section is measured unbounded, so a star column hands the first
            child whatever it asks for and the rest of the row is arranged past the clip - the
            weather search button ended up outside the dialog and reported itself offscreen to
            automation while still being in the tree. An explicit width makes the measure
            finite, which is what lets the inner grids resolve their own columns.
        -->
        <ScrollViewer
            Grid.Column="1"
            Width="392"
            MaxHeight="460"
            HorizontalScrollMode="Disabled"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid>
                <!--
                    MaxWidth, not a star column, is what bounds a section. Inside a
                    ContentDialog the content is measured unbounded, so a Grid's star column
                    hands its first child everything it asks for and arranges the Auto column
                    past the clip - which is how the weather search button ended up zero-sized
                    and invisible to automation while still being in the tree. MaxWidth applies
                    during measure, so the inner grids resolve against a real number.
                -->
                <StackPanel
                    x:Name="WeatherSection"
                    MaxWidth="368"
                    HorizontalAlignment="Left"
                    Spacing="12">
                    <TextBlock
                        x:Uid="WeatherSettingsDescription"
                        TextWrapping="Wrap" />

                    <!--
                        Search replaces hand-typed coordinates. The user names a place; the
                        coordinates come back from the search and are shown read-only below,
                        so what will be saved is visible without being editable.
                    -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="WeatherSettingsSearchBox"
                            x:Uid="WeatherSettingsSearchBox"
                            Text="{x:Bind WeatherViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            KeyDown="WeatherSettingsSearchBox_KeyDown"
                            automation:AutomationProperties.AutomationId="WeatherSettingsSearchBox" />
                        <Button
                            x:Name="WeatherSettingsSearchButton"
                            x:Uid="WeatherSettingsSearchButton"
                            Grid.Column="1"
                            VerticalAlignment="Bottom"
                            IsEnabled="{x:Bind WeatherViewModel.CanSearch, Mode=OneWay}"
                            Click="WeatherSettingsSearchButton_Click"
                            automation:AutomationProperties.AutomationId="WeatherSettingsSearchButton" />
                    </Grid>

                    <ProgressBar
                        x:Name="WeatherSettingsSearchProgress"
                        IsIndeterminate="True"
                        Visibility="{x:Bind WeatherViewModel.IsSearching, Mode=OneWay}" />

                    <ListView
                        x:Name="WeatherSettingsResultsList"
                        x:Uid="WeatherSettingsResultsList"
                        MaxHeight="196"
                        SelectionMode="Single"
                        ItemsSource="{x:Bind WeatherViewModel.SearchResults, Mode=OneWay}"
                        SelectionChanged="WeatherSettingsResultsList_SelectionChanged"
                        automation:AutomationProperties.AutomationId="WeatherSettingsResultsList">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="settings:WeatherLocationOption">
                                <StackPanel Padding="0,4">
                                    <TextBlock
                                        Style="{StaticResource WwbCardBodyStyle}"
                                        Text="{x:Bind Label}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Style="{StaticResource WwbCardCaptionStyle}"
                                        Text="{x:Bind Description}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBox
                        x:Name="WeatherSettingsLabelBox"
                        x:Uid="WeatherSettingsLabelBox"
                        Text="{x:Bind WeatherViewModel.LocationLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        automation:AutomationProperties.AutomationId="WeatherSettingsLabelBox" />

                    <!--
                        Kept visible but read-only: the coordinates are what actually gets
                        stored and sent to the weather provider, and hiding them would make
                        that invisible.
                    -->
                    <TextBox
                        x:Name="WeatherSettingsCoordinatesBox"
                        x:Uid="WeatherSettingsCoordinatesBox"
                        IsReadOnly="True"
                        Text="{x:Bind WeatherViewModel.CoordinatesText, Mode=OneWay}"
                        automation:AutomationProperties.AutomationId="WeatherSettingsCoordinatesBox" />

                    <Button
                        x:Name="WeatherSettingsSaveButton"
                        x:Uid="WeatherSettingsSaveButton"
                        HorizontalAlignment="Left"
                        IsEnabled="{x:Bind WeatherViewModel.CanSave, Mode=OneWay}"
                        Click="WeatherSettingsSaveButton_Click" />
                    <TextBlock
                        x:Name="WeatherSettingsValidationText"
                        Text="{x:Bind WeatherViewModel.ValidationText, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    <TextBlock
                        x:Name="WeatherSettingsStatusText"
                        Text="{x:Bind WeatherViewModel.StatusText, Mode=OneWay}"
                        TextWrapping="Wrap"
                        automation:AutomationProperties.AutomationId="WeatherSettingsStatusText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel
                    x:Name="SystemMonitorSection"
                    MaxWidth="368"
                    HorizontalAlignment="Left"
                    Spacing="12"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Uid="SysMonSettingsDescription"
                        TextWrapping="Wrap" />

                    <TextBlock
                        x:Uid="SysMonCardSectionHeader"
                        Style="{StaticResource WwbCardTitleStyle}" />
                    <ListView
                        x:Name="SysMonCardList"
                        MaxHeight="228"
                        SelectionMode="None"
                        ItemsSource="{x:Bind SystemMonitorViewModel.CardOptions, Mode=OneWay}"
                        ItemTemplate="{StaticResource SysMonMetricOptionTemplate}"
                        automation:AutomationProperties.AutomationId="SysMonCardList" />

                    <TextBlock
                        x:Uid="SysMonEntrySectionHeader"
                        Style="{StaticResource WwbCardTitleStyle}" />
                    <ListView
                        x:Name="SysMonEntryList"
                        MaxHeight="228"
                        SelectionMode="None"
                        ItemsSource="{x:Bind SystemMonitorViewModel.EntryOptions, Mode=OneWay}"
                        ItemTemplate="{StaticResource SysMonMetricOptionTemplate}"
                        automation:AutomationProperties.AutomationId="SysMonEntryList" />

                    <TextBlock
                        x:Name="SysMonSettingsValidationText"
                        Style="{StaticResource WwbCardCaptionStyle}"
                        Text="{x:Bind SystemMonitorViewModel.ValidationText, Mode=OneWay}"
                        TextWrapping="Wrap"
                        automation:AutomationProperties.AutomationId="SysMonSettingsValidationText" />

                    <Button
                        x:Name="SysMonSettingsSaveButton"
                        x:Uid="SysMonSettingsSaveButton"
                        HorizontalAlignment="Right"
                        Style="{StaticResource WwbPrimaryToolbarButtonStyle}"
                        IsEnabled="{x:Bind SystemMonitorViewModel.CanSave, Mode=OneWay}"
                        Click="SysMonSettingsSaveButton_Click"
                        automation:AutomationProperties.AutomationId="SysMonSettingsSaveButton" />

                    <TextBlock
                        x:Name="SysMonSettingsStatusText"
                        Style="{StaticResource WwbCardCaptionStyle}"
                        Text="{x:Bind SystemMonitorViewModel.StatusText, Mode=OneWay}"
                        TextWrapping="Wrap"
                        automation:AutomationProperties.AutomationId="SysMonSettingsStatusText" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</controls:ContentDialog>
