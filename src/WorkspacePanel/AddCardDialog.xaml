<controls:ContentDialog
    x:Class="WinWidgetBoard.WorkspacePanel.AddCardDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    xmlns:settings="using:WinWidgetBoard.WorkspacePanel.Settings"
    x:Uid="AddCardDialog"
    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
    BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
    BorderThickness="{ThemeResource WwbFlyoutBorderThickness}"
    CornerRadius="{StaticResource WwbPanelCornerRadius}"
    CloseButtonStyle="{StaticResource WwbDialogCloseButtonStyle}"
    DefaultButton="None">
    <!--
        Same sheet as the settings dialog: the panel's material, corner and title scale. Two
        overlays in one panel must not read as two different products.
    -->
    <controls:ContentDialog.TitleTemplate>
        <DataTemplate>
            <TextBlock
                Style="{StaticResource WwbPanelTitleStyle}"
                Text="{Binding}"
                TextWrapping="NoWrap" />
        </DataTemplate>
    </controls:ContentDialog.TitleTemplate>
    <controls:ContentDialog.Resources>
        <!--
            The outer radius is drawn by the dialog's template from OverlayCornerRadius, not
            from the CornerRadius property - without this the sheet keeps the system's corner
            while the surfaces inside it follow the panel's. Both come from WwbPanelCornerRadius.
        -->
        <StaticResource x:Key="OverlayCornerRadius" ResourceKey="WwbPanelCornerRadius" />
        <DataTemplate
            x:Key="AddCardOptionTemplate"
            x:DataType="settings:AddCardOption">
            <CheckBox
                Content="{x:Bind DisplayName}"
                IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                MinWidth="0"
                Padding="0,2"
                automation:AutomationProperties.Name="{x:Bind DisplayName}"
                automation:AutomationProperties.AutomationId="{x:Bind IncludeAutomationId}" />
        </DataTemplate>
    </controls:ContentDialog.Resources>

    <StackPanel Spacing="12">
        <TextBlock
            x:Uid="AddCardDescription"
            TextWrapping="Wrap" />

        <ListView
            x:Name="AddCardList"
            MaxHeight="240"
            SelectionMode="None"
            ItemsSource="{x:Bind ViewModel.Options, Mode=OneWay}"
            ItemTemplate="{StaticResource AddCardOptionTemplate}"
            automation:AutomationProperties.AutomationId="AddCardList" />

        <!--
            A dialog button, not a toolbar button: the toolbar styles set the icon font and
            zero padding for single-glyph content, and this button commits with a word.
        -->
        <Button
            x:Name="AddCardConfirmButton"
            x:Uid="AddCardConfirmButton"
            HorizontalAlignment="Right"
            Style="{StaticResource WwbPrimaryDialogButtonStyle}"
            IsEnabled="{x:Bind ViewModel.CanAdd, Mode=OneWay}"
            Click="ConfirmButton_Click"
            automation:AutomationProperties.AutomationId="AddCardConfirmButton" />

        <TextBlock
            x:Name="AddCardStatusText"
            Style="{StaticResource WwbCardCaptionStyle}"
            Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
            TextWrapping="Wrap"
            automation:AutomationProperties.AutomationId="AddCardStatusText" />
    </StackPanel>
</controls:ContentDialog>
